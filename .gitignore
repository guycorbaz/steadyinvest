# ── Rust / Cargo ──────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed (this is an application → reproducible builds)

# ── Journal databases & SQLite sidecars (never commit user data) ─
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Secrets / local config (keys live in the OS keychain, never here) ─
.env
.env.*
!.env.example
*.key
*.pem
secrets/
config.local.*

# ── App-local config / backups / exports (runtime, not source) ───
/backups/
/exports/

# ── OS / editor noise ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ── Build / report output ────────────────────────────────────────
/dist/
*.log

