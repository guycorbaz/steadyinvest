// Réglages — three plain panels, no wizard, nothing blocking (FR63): theme, method-vocabulary
// label set, locale number format. Provider/key, currency and threshold panels are later
// stories (3.2, 4.x). The sample amounts (constants formatted in Rust) prove the live locale
// swap and render in the numeric font, digits stacked to show tabular figures.

import { Tokens } from "../tokens.slint";
import { Fx, Holdings, Labels, Prefs, Verify, RecentJournalRow } from "../state.slint";
import { ChoiceChip } from "../components/choice_chip.slint";
import { ActionButton } from "../components/action_button.slint";
import { TextField } from "../components/text_field.slint";

// One legend row (Story 2.13, FR57): the REAL marker beside its neutral meaning, so the legend can
// never drift from what the cells actually show. The marker is ink only (its own token colour).
component LegendRow inherits HorizontalLayout {
    in property <string> marker;
    in property <color> marker-color: Tokens.text-high;
    in property <string> meaning;
    spacing: Tokens.space-12;
    Text {
        text: root.marker;
        color: root.marker-color;
        font-size: Tokens.font-body;
        width: Tokens.space-48;
        horizontal-alignment: center;
    }
    Text {
        text: root.meaning;
        color: Tokens.text-mid;
        font-size: Tokens.font-caption;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// One glossary entry (Story 2.13, FR62): a term + its neutral definition.
component GlossaryRow inherits VerticalLayout {
    in property <string> term;
    in property <string> definition;
    spacing: 2px;
    Text {
        text: root.term;
        color: Tokens.text-high;
        font-size: Tokens.font-caption;
        font-weight: Tokens.weight-medium;
    }
    Text {
        text: root.definition;
        color: Tokens.text-low;
        font-size: Tokens.font-caption;
        wrap: word-wrap;
    }
}

component SettingsPanel inherits Rectangle {
    in property <string> title;

    background: Tokens.surface;
    border-width: Tokens.border;
    border-color: Tokens.separator;
    border-radius: Tokens.radius;

    VerticalLayout {
        padding: Tokens.space-16;
        spacing: Tokens.space-12;

        Text {
            text: root.title;
            color: Tokens.text-high;
            font-size: Tokens.font-h3;
            font-weight: Tokens.weight-semibold;
        }

        @children
    }
}

export component SettingsScreen inherits Rectangle {
    Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Tokens.space-24;
            spacing: Tokens.space-16;

            Text {
                text: @tr("Réglages");
                color: Tokens.text-high;
                font-size: Tokens.font-h2;
                font-weight: Tokens.weight-semibold;
            }

            // ── Story 5.5 (FR66) — journal location, recent journals, single-instance lock &
            // sync-safety. Native dialogs pick the file/dir; switching is never journal-less. ──
            SettingsPanel {
                title: @tr("Emplacement du journal");

                Text {
                    text: @tr("Journal actuel :") + " " + Prefs.journal-current-path;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ActionButton {
                        label: @tr("Ouvrir un journal…");
                        clicked => { Prefs.pick-and-open-journal(); }
                    }
                    ActionButton {
                        label: @tr("Créer un journal…");
                        clicked => { Prefs.pick-and-create-journal(); }
                    }
                }

                // Recent journals — most-recent-first; the current one is marked and not re-openable.
                if Prefs.recent-journals.length > 0: Text {
                    text: @tr("Journaux récents");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                }
                for row in Prefs.recent-journals: HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    Text {
                        text: row.name + (row.current ? " " + @tr("(actuel)") : "");
                        color: row.current ? Tokens.text-high : Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        vertical-alignment: center;
                    }
                    if !row.current: ActionButton {
                        label: @tr("Ouvrir");
                        clicked => { Prefs.open-recent(row.path); }
                    }
                }

                // A stale lock blocked an open → offer to reclaim it.
                if Prefs.journal-reclaim-path != "": HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ActionButton {
                        label: @tr("Lever le verrou et ouvrir");
                        clicked => { Prefs.reclaim-and-open(Prefs.journal-reclaim-path); }
                    }
                }

                if Prefs.journal-location-status != "": Text {
                    text: Prefs.journal-location-status;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
            }

            // ── Story 3.2 — Fournisseur de données & clé API (FR25/FR63). No wizard: configured
            // as-needed here. The key VALUE never appears on screen — only a "configured" status —
            // and travels one-way into Rust via `key-saved` (NFR-S1). ──
            SettingsPanel {
                title: @tr("Fournisseur de données");

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ChoiceChip {
                        label: @tr("EODHD");
                        selected: Prefs.provider == "eodhd";
                        activated => { Prefs.provider-selected("eodhd"); }
                    }
                    ChoiceChip {
                        label: @tr("Twelve Data");
                        selected: Prefs.provider == "twelvedata";
                        activated => { Prefs.provider-selected("twelvedata"); }
                    }
                    ChoiceChip {
                        label: @tr("Aucun (sans clé)");
                        selected: Prefs.provider == "none";
                        activated => { Prefs.provider-selected("none"); }
                    }
                }

                // Key status + entry + actions only matter for a key-requiring provider (EODHD or
                // Twelve Data) — a keyless "none" provider shows no key status at all (F13).
                if Prefs.provider != "none": VerticalLayout {
                    spacing: Tokens.space-8;

                    Text {
                        text: Prefs.key-configured ? @tr("Clé configurée") : @tr("Aucune clé configurée");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                    }

                    keyfield := TextField {
                        placeholder: @tr("Clé API du fournisseur");
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;

                        ActionButton {
                            label: @tr("Enregistrer");
                            clicked => {
                                Prefs.key-saved(keyfield.text);
                                keyfield.text = "";
                            }
                        }
                        ActionButton {
                            label: @tr("Supprimer");
                            clicked => { Prefs.key-deleted(); }
                        }
                        ActionButton {
                            label: @tr("Tester");
                            clicked => { Prefs.key-tested(); }
                        }
                    }
                }

                // ── Story 6.9 (FR26) — the per-field-type fallback provider: the chain a
                // price / fundamentals / FX fetch fails over to when the primary above errors.
                // The fundamentals row offers no Twelve Data (declared capability: its
                // fundamentals are empty by design). Facts and thresholds — never advice. ──
                if Prefs.provider != "none": VerticalLayout {
                    spacing: Tokens.space-8;

                    Text {
                        text: @tr("Fournisseur de repli (en cas d'échec du fournisseur principal) :");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;
                        Text {
                            text: @tr("Prix");
                            color: Tokens.text-mid;
                            font-size: Tokens.font-caption;
                            vertical-alignment: center;
                            width: 160px;
                        }
                        ChoiceChip {
                            label: @tr("Aucun repli");
                            selected: Prefs.price-fallback == "";
                            activated => { Prefs.fallback-provider-selected("price", ""); }
                        }
                        ChoiceChip {
                            label: @tr("EODHD");
                            selected: Prefs.price-fallback == "eodhd";
                            activated => { Prefs.fallback-provider-selected("price", "eodhd"); }
                        }
                        ChoiceChip {
                            label: @tr("Twelve Data");
                            selected: Prefs.price-fallback == "twelvedata";
                            activated => { Prefs.fallback-provider-selected("price", "twelvedata"); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;
                        Text {
                            text: @tr("Fondamentaux");
                            color: Tokens.text-mid;
                            font-size: Tokens.font-caption;
                            vertical-alignment: center;
                            width: 160px;
                        }
                        ChoiceChip {
                            label: @tr("Aucun repli");
                            selected: Prefs.fundamentals-fallback == "";
                            activated => { Prefs.fallback-provider-selected("fundamentals", ""); }
                        }
                        ChoiceChip {
                            label: @tr("EODHD");
                            selected: Prefs.fundamentals-fallback == "eodhd";
                            activated => { Prefs.fallback-provider-selected("fundamentals", "eodhd"); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;
                        Text {
                            text: @tr("Taux de change");
                            color: Tokens.text-mid;
                            font-size: Tokens.font-caption;
                            vertical-alignment: center;
                            width: 160px;
                        }
                        ChoiceChip {
                            label: @tr("Aucun repli");
                            selected: Prefs.fx-fallback == "";
                            activated => { Prefs.fallback-provider-selected("fx", ""); }
                        }
                        ChoiceChip {
                            label: @tr("EODHD");
                            selected: Prefs.fx-fallback == "eodhd";
                            activated => { Prefs.fallback-provider-selected("fx", "eodhd"); }
                        }
                        ChoiceChip {
                            label: @tr("Twelve Data");
                            selected: Prefs.fx-fallback == "twelvedata";
                            activated => { Prefs.fallback-provider-selected("fx", "twelvedata"); }
                        }
                    }
                }

                if Prefs.provider-status != "": Text {
                    text: Prefs.provider-status;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
            }

            // ── Story 5.3 (FR60) — export / import the WHOLE journal as a portable, versioned,
            // integrity-checked file. Path-based for now (the native picker is Story 5.5). Export
            // writes to the OS data dir's exports/ folder; import verifies + applies atomically. ──
            SettingsPanel {
                title: @tr("Journal complet");

                Text {
                    text: @tr("Exporter ou importer l'ensemble du journal (études, valeurs suivies, portefeuille) dans un fichier portable et vérifié.");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ActionButton {
                        label: @tr("Exporter le journal");
                        clicked => { Prefs.export-journal(); }
                    }
                }

                journalpath := TextField {
                    placeholder: @tr("Chemin du fichier à importer");
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ActionButton {
                        label: @tr("Importer un journal");
                        clicked => { Prefs.import-journal(journalpath.text); }
                    }
                }

                if Prefs.journal-status != "": Text {
                    text: Prefs.journal-status;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
            }

            // ── Story 5.4 (FR61) — backup / restore the raw .db. Validation runs BEFORE any overwrite
            // and a stale/foreign restore is gated behind the confirm banel — never applied silently. ──
            SettingsPanel {
                title: @tr("Sauvegarde & restauration");

                Text {
                    text: @tr("Créer une copie de sauvegarde du journal, ou restaurer le journal depuis une sauvegarde (le fichier est vérifié avant tout remplacement).");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ActionButton {
                        label: @tr("Créer une sauvegarde");
                        clicked => { Prefs.create-backup(); }
                    }
                }

                restorepath := TextField {
                    placeholder: @tr("Chemin de la sauvegarde à restaurer");
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ActionButton {
                        label: @tr("Restaurer");
                        clicked => { Prefs.request-restore(restorepath.text); }
                    }
                }

                // Confirm banner — revealed only while a restore is parked (the backup's identity +
                // version + stale/foreign warning). Confirm replaces the live journal; cancel discards.
                if Prefs.restore-confirm != "": VerticalLayout {
                    spacing: Tokens.space-8;

                    Text {
                        text: Prefs.restore-confirm;
                        color: Tokens.text-high;
                        font-size: Tokens.font-caption;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;

                        ActionButton {
                            label: @tr("Confirmer la restauration");
                            clicked => { Prefs.confirm-restore(); }
                        }
                        ActionButton {
                            label: @tr("Annuler");
                            clicked => { Prefs.cancel-restore(); }
                        }
                    }
                }

                if Prefs.restore-status != "": Text {
                    text: Prefs.restore-status;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
            }

            SettingsPanel {
                title: @tr("Thème");

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ChoiceChip {
                        label: @tr("Sombre");
                        selected: Prefs.dark-theme;
                        activated => { Prefs.theme-selected("dark"); }
                    }
                    ChoiceChip {
                        label: @tr("Clair");
                        selected: !Prefs.dark-theme;
                        activated => { Prefs.theme-selected("light"); }
                    }
                }
            }

            SettingsPanel {
                title: @tr("Vocabulaire de la méthode");

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ChoiceChip {
                        label: @tr("NAIC");
                        selected: Prefs.label-set == "naic";
                        activated => { Prefs.label-set-selected("naic"); }
                    }
                    ChoiceChip {
                        label: @tr("Neutre");
                        selected: Prefs.label-set == "neutral";
                        activated => { Prefs.label-set-selected("neutral"); }
                    }
                }

                Text {
                    text: Labels.study-method + " · " + Labels.zone-buy + " · "
                        + Labels.zone-hold + " · " + Labels.zone-sell;
                    color: Tokens.text-low;
                    font-size: Tokens.font-caption;
                }
            }

            // Story 4.3 (FR63) — the single global reference currency the portfolio is read in. A
            // label only (no FX conversion in Epic 4); the open set is covered by quick picks.
            SettingsPanel {
                title: @tr("Devise de référence");

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    // One source of truth (Story 6.2): the same allow-list the holding-currency
                    // picker renders (pushed from Rust's config::SUPPORTED_CURRENCIES), so the
                    // reference picker can never offer a code a holding could not carry.
                    for c in Holdings.supported-currencies: ChoiceChip {
                        label: c;
                        selected: Prefs.reference-currency == c;
                        activated => { Prefs.reference-currency-selected(c); }
                    }
                }
            }

            // Story 4.5 (FR42/FR63) — the default trailing-stop percentage the per-holding set-stop
            // control pre-fills. A threshold, not advice; empty = no default.
            stop-panel := SettingsPanel {
                title: @tr("Seuil suiveur par défaut");
                property <string> draft: Prefs.default-trailing-stop-pct;

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    TextField {
                        placeholder: @tr("Pourcentage (0–100)");
                        text <=> stop-panel.draft;
                        width: 200px;
                    }
                    ActionButton {
                        label: @tr("Enregistrer");
                        enabled: true;
                        // Issue #88: after the handler runs, re-sync the field to the effective value —
                        // the two-way `text <=> draft` severed the declarative binding, so a normalized
                        // save (or a refused invalid entry) would otherwise never refresh the field.
                        clicked => {
                            Prefs.default-trailing-stop-pct-changed(stop-panel.draft);
                            stop-panel.draft = Prefs.default-trailing-stop-pct;
                        }
                    }
                    ActionButton {
                        label: @tr("Effacer");
                        enabled: Prefs.default-trailing-stop-pct != "";
                        clicked => {
                            stop-panel.draft = "";
                            Prefs.default-trailing-stop-pct-changed("");
                        }
                    }
                }
            }

            // Story 6.4 (FR41) — the default dividend withholding rate the « Retenue » field
            // auto-computes with (Appendix A; CH impôt anticipé = 35). A fact, not advice.
            withholding-panel := SettingsPanel {
                title: @tr("Retenue à la source par défaut (dividendes)");
                property <string> draft: Prefs.withholding-rate-pct;

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    TextField {
                        placeholder: @tr("Pourcentage (0–100, vide = 35)");
                        text <=> withholding-panel.draft;
                        width: 200px;
                    }
                    ActionButton {
                        label: @tr("Enregistrer");
                        enabled: true;
                        // Issue #88: re-sync the field to the effective value after the handler (see the
                        // trailing-stop panel — the two-way binding severs the declarative refresh).
                        clicked => {
                            Prefs.withholding-rate-pct-changed(withholding-panel.draft);
                            withholding-panel.draft = Prefs.withholding-rate-pct;
                        }
                    }
                }
            }

            // Story 6.7 (FR45) — the concentration threshold + the configurable diversify-by-size
            // table (change-request): boundaries are compared against study sales CONVERTED to
            // the reference currency, in the same unit as entered in studies; targets are the
            // user's anchors (they need not sum to 100). Facts and thresholds — never advice.
            size-panel := SettingsPanel {
                title: @tr("Concentration et diversification par taille");
                property <string> draft-threshold: Prefs.concentration-threshold-pct;
                property <string> draft-small-max: Prefs.size-small-max;
                property <string> draft-medium-max: Prefs.size-medium-max;
                property <string> draft-target-small: Prefs.size-target-small-pct;
                property <string> draft-target-medium: Prefs.size-target-medium-pct;
                property <string> draft-target-large: Prefs.size-target-large-pct;

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    TextField {
                        placeholder: @tr("Seuil de concentration % (vide = 50)");
                        text <=> size-panel.draft-threshold;
                        width: 260px;
                    }
                    ActionButton {
                        label: @tr("Enregistrer");
                        enabled: true;
                        // Issue #93: re-sync the field to the effective value after the handler — the
                        // two-way `text <=> draft` severs the declarative binding, so a normalized save
                        // (or a refused invalid entry) would otherwise leave stale text on screen (the
                        // same fix the trailing-stop / withholding panels got in #88).
                        clicked => {
                            Prefs.concentration-threshold-pct-changed(size-panel.draft-threshold);
                            size-panel.draft-threshold = Prefs.concentration-threshold-pct;
                        }
                    }
                }

                Text {
                    text: @tr("Bornes de chiffre d'affaires (converties en {}, même unité que les études) et cibles :", Prefs.reference-currency);
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;
                    Text {
                        text: @tr("Petite — croissance anticipée > 12 %");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        vertical-alignment: center;
                    }
                    TextField {
                        placeholder: @tr("Borne petite/moyenne (vide = 1000000000)");
                        text <=> size-panel.draft-small-max;
                        width: 280px;
                    }
                    TextField {
                        placeholder: @tr("Cible % (vide = 25)");
                        text <=> size-panel.draft-target-small;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;
                    Text {
                        text: @tr("Moyenne — croissance anticipée 7 – 12 %");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        vertical-alignment: center;
                    }
                    TextField {
                        placeholder: @tr("Borne moyenne/grande (vide = 10000000000)");
                        text <=> size-panel.draft-medium-max;
                        width: 280px;
                    }
                    TextField {
                        placeholder: @tr("Cible % (vide = 50)");
                        text <=> size-panel.draft-target-medium;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;
                    Text {
                        text: @tr("Grande — croissance anticipée 5 – 7 %");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        vertical-alignment: center;
                    }
                    TextField {
                        placeholder: @tr("Cible % (vide = 25)");
                        text <=> size-panel.draft-target-large;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: @tr("Enregistrer la table");
                        enabled: true;
                        clicked => {
                            Prefs.size-table-changed(
                                size-panel.draft-small-max,
                                size-panel.draft-medium-max,
                                size-panel.draft-target-small,
                                size-panel.draft-target-medium,
                                size-panel.draft-target-large);
                            // Issue #93: re-sync every field to its effective value after the handler
                            // (normalized save OR refused entry) — the two-way bindings would otherwise
                            // leave stale text (the #88 fix, extended to the whole size table).
                            size-panel.draft-small-max = Prefs.size-small-max;
                            size-panel.draft-medium-max = Prefs.size-medium-max;
                            size-panel.draft-target-small = Prefs.size-target-small-pct;
                            size-panel.draft-target-medium = Prefs.size-target-medium-pct;
                            size-panel.draft-target-large = Prefs.size-target-large-pct;
                        }
                    }
                }
                if Prefs.risk-settings-status != "": Text {
                    text: Prefs.risk-settings-status;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
            }

            // Story 6.5 (FR28) — dated, source-aware exchange rates: the stored list, the
            // user-initiated provider refresh (FR65), and manual entry (source « manuel »).
            // NO conversion happens here — consolidation is Story 6.6.
            fx-panel := SettingsPanel {
                title: @tr("Taux de change");
                property <string> draft-base;
                property <string> draft-rate;
                property <string> draft-date;

                VerticalLayout {
                    spacing: Tokens.space-8;

                    if Fx.notice != "": Text {
                        text: Fx.notice;
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                    }
                    if Fx.rates.length == 0: Text {
                        text: @tr("Aucun taux enregistré pour le moment.");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                    }
                    for r in Fx.rates: HorizontalLayout {
                        spacing: Tokens.space-8;
                        Text {
                            text: r.pair;
                            color: Tokens.text-high;
                            font-size: Tokens.font-caption;
                        }
                        Text {
                            text: r.rate;
                            color: Tokens.text-high;
                            font-family: Tokens.font-numeric;
                            font-size: Tokens.font-caption;
                        }
                        Text {
                            text: @tr("le {} ({})", r.date, r.source);
                            color: Tokens.text-mid;
                            font-size: Tokens.font-caption;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;
                        ActionButton {
                            label: Fx.refreshing
                                ? @tr("Actualisation…") : @tr("Actualiser les taux");
                            enabled: !Fx.refreshing;
                            clicked => { Fx.refresh-rates(); }
                        }
                        // Issue #100: the paced batch counts up (n/t) and can be cancelled.
                        if Fx.refreshing: Text {
                            text: Fx.refresh-progress;
                            color: Tokens.text-mid;
                            font-family: Tokens.font-numeric;
                            font-size: Tokens.font-caption;
                            vertical-alignment: center;
                        }
                        if Fx.refreshing: ActionButton {
                            label: @tr("Annuler");
                            enabled: true;
                            clicked => { Fx.cancel-refresh(); }
                        }
                    }
                    // Manual entry: base → the reference currency, at a dated rate.
                    HorizontalLayout {
                        spacing: Tokens.space-8;
                        TextField {
                            placeholder: @tr("Devise (ex. EUR)");
                            text <=> fx-panel.draft-base;
                            width: 140px;
                        }
                        TextField {
                            placeholder: @tr("Taux vers {}", Prefs.reference-currency);
                            text <=> fx-panel.draft-rate;
                            width: 180px;
                        }
                        TextField {
                            placeholder: @tr("Date (AAAA-MM-JJ, vide = aujourd'hui)");
                            text <=> fx-panel.draft-date;
                            width: 260px;
                        }
                        ActionButton {
                            label: @tr("Enregistrer le taux");
                            enabled: fx-panel.draft-base != "" && fx-panel.draft-rate != "";
                            clicked => {
                                if (Fx.add-rate(fx-panel.draft-base, fx-panel.draft-rate,
                                        fx-panel.draft-date)) {
                                    fx-panel.draft-base = "";
                                    fx-panel.draft-rate = "";
                                    fx-panel.draft-date = "";
                                }
                            }
                        }
                    }
                }
            }

            SettingsPanel {
                title: @tr("Format des nombres");

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;

                    ChoiceChip {
                        label: @tr("Virgule — 1 234,56");
                        selected: Prefs.number-format == "comma";
                        activated => { Prefs.number-format-selected("comma"); }
                    }
                    ChoiceChip {
                        label: @tr("Point — 1,234.56");
                        selected: Prefs.number-format == "point";
                        activated => { Prefs.number-format-selected("point"); }
                    }
                }

                VerticalLayout {
                    spacing: Tokens.space-4;

                    Text {
                        text: @tr("Exemples :");
                        color: Tokens.text-low;
                        font-size: Tokens.font-caption;
                    }
                    Text {
                        text: Prefs.sample-amount;
                        color: Tokens.text-mid;
                        font-family: Tokens.font-numeric;
                        font-size: Tokens.font-body;
                        horizontal-alignment: right;
                        width: 50%;
                    }
                    Text {
                        text: Prefs.sample-amount-alt;
                        color: Tokens.text-mid;
                        font-family: Tokens.font-numeric;
                        font-size: Tokens.font-body;
                        horizontal-alignment: right;
                        width: 50%;
                    }
                }
            }

            // ── Story 2.13 — Légende des marqueurs (FR57): the same markers the cells/verdict show. ──
            SettingsPanel {
                title: @tr("Légende des marqueurs");

                LegendRow {
                    marker: "·";
                    marker-color: Tokens.text-low;
                    meaning: @tr("Sans marqueur — valeur présente et à jour.");
                }
                LegendRow {
                    marker: Tokens.gap-glyph;
                    marker-color: Tokens.gap-ink;
                    meaning: @tr("À remplir — donnée manquante dans une grille régulière.");
                }
                LegendRow {
                    marker: @tr("n/a");
                    marker-color: Tokens.text-low;
                    meaning: @tr("Non disponible — absence acceptée, distincte d'un oubli.");
                }
                LegendRow {
                    marker: Tokens.stale-dot;
                    marker-color: Tokens.text-low;
                    meaning: @tr("Périmée — valeur ancienne, à rafraîchir.");
                }
                LegendRow {
                    marker: "?";
                    meaning: @tr("À revoir — non encore vérifiée par vous.");
                }
                LegendRow {
                    marker: "✓";
                    meaning: @tr("Validée — vous avez vérifié cette valeur.");
                }
                LegendRow {
                    marker: Tokens.warn-glyph;
                    meaning: @tr("Point d'attention — une cohérence à examiner.");
                }
                Text {
                    text: @tr("Provenance : manuel · fournisseur · calculé. Verdict : pleine · provisoire (hachurée) · suspendu.");
                    color: Tokens.text-low;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
            }

            // ── Story 2.13 — Glossaire (FR62): neutral definitions of the key SSG terms. ──
            SettingsPanel {
                title: @tr("Glossaire");

                GlossaryRow {
                    term: @tr("Zone d'achat");
                    definition: @tr("Le tiers bas de la fourchette de prix projetée.");
                }
                GlossaryRow {
                    term: @tr("Ratio hausse / baisse");
                    definition: @tr("Le potentiel de hausse rapporté au risque de baisse.");
                }
                GlossaryRow {
                    term: @tr("BPA");
                    definition: @tr("Bénéfice par action.");
                }
                GlossaryRow {
                    term: @tr("Marge de sécurité");
                    definition: @tr("L'écart entre le prix actuel et la valeur projetée basse.");
                }
                GlossaryRow {
                    term: @tr("Historique suffisant");
                    definition: @tr("Au moins cinq années exploitables ; en deçà, la confiance est réduite.");
                }
                GlossaryRow {
                    term: @tr("P/E jugé");
                    definition: @tr("Le multiple cours / bénéfice retenu pour la projection.");
                }
                GlossaryRow {
                    term: @tr("Provenance");
                    definition: @tr("L'origine d'une donnée : manuelle, fournisseur ou calculée.");
                }
                GlossaryRow {
                    term: @tr("Fraîcheur");
                    definition: @tr("Indique si une donnée est récente ou périmée.");
                }
            }

            // ── Story 2.13 — Vérifier le moteur (FR9): replay the bundled golden studies on demand. ──
            SettingsPanel {
                title: @tr("Vérifier le moteur");

                Text {
                    text: @tr("Rejoue les études de référence intégrées à travers le moteur et signale tout écart.");
                    color: Tokens.text-low;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: @tr("Vérifier le moteur");
                        clicked => { Verify.run(); }
                    }
                }
                if Verify.ran: VerticalLayout {
                    spacing: Tokens.space-4;

                    Text {
                        text: @tr("Méthode : {} · Empreinte : {}", Verify.method-version, Verify.method-fingerprint);
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        font-family: Tokens.font-numeric;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Verify.summary;
                        color: Tokens.text-high;
                        font-size: Tokens.font-body;
                        font-weight: Tokens.weight-medium;
                    }
                    for line in Verify.results: HorizontalLayout {
                        spacing: Tokens.space-8;
                        Text {
                            text: line.passed ? "✓" : "△";
                            color: line.passed ? Tokens.text-mid : Tokens.gap-ink;
                            font-size: Tokens.font-caption;
                            width: Tokens.space-16;
                        }
                        Text {
                            text: line.passed ? line.id : (line.id + " — " + line.detail);
                            color: line.passed ? Tokens.text-low : Tokens.text-high;
                            font-size: Tokens.font-caption;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
