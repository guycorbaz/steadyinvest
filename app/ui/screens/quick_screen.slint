// Examen rapide (Story 7.3): the beginner's check list — two six-year ladders, the five-year
// price / P/E record, the reader's own fields, four conclusions worded as facts against the
// reader's objective. It states, never recommends (FR13): no colour, no « acceptable ».

import { Tokens } from "../tokens.slint";
import { QuickScreen, QuickPriceRow, Studies } from "../state.slint";
import { ActionButton } from "../components/action_button.slint";
import { ChoiceChip } from "../components/choice_chip.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBand } from "../components/status_band.slint";
import { TextField } from "../components/text_field.slint";

component Fact inherits Text {
    color: Tokens.text-high;
    font-family: Tokens.font-numeric;
    font-size: Tokens.font-caption;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component Label inherits Text {
    color: Tokens.text-mid;
    font-size: Tokens.font-caption;
    vertical-alignment: center;
    wrap: word-wrap;
}

// One ladder line: the numbered label (with its year when it has one) and the figure.
component LadderLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> year;
    in property <string> value;
    spacing: Tokens.space-8;
    min-height: Tokens.row-height * 0.7;
    Label {
        text: root.year != "" ? @tr("{} ({})", root.label, root.year) : root.label;
        horizontal-stretch: 1;
    }
    Fact {
        text: root.value != "" ? root.value : "—";
        width: 180px;
    }
}

component Ladder inherits VerticalLayout {
    in property <[string]> lines;
    in property <[string]> years;
    in property <string> rate;
    in property <string> span;
    in property <bool> nonpositive-base;  // line (10) absent: the old average is ≤ 0
    in property <bool> unavailable;
    in property <string> rate-label;
    in property <string> recent-label;
    in property <string> recent-prior-label;
    in property <string> old-label;      // « … il y a {} ans » with the span
    in property <string> old-prior-label;
    spacing: Tokens.space-4;
    pure function at(i: int) -> string { return i < root.lines.length ? root.lines[i] : ""; }
    pure function year-at(i: int) -> string { return i < root.years.length ? root.years[i] : ""; }
    pure function span-plus-one() -> string {
        if (root.span == "5") { return "6"; }
        if (root.span == "4") { return "5"; }
        if (root.span == "3") { return "4"; }
        if (root.span == "2") { return "3"; }
        if (root.span == "1") { return "2"; }
        return "";
    }
    if root.unavailable: StatusBand {
        icon: "◦";
        text: @tr("indisponible : les années exploitables ne forment pas deux paires consécutives");
    }
    if !root.unavailable: VerticalLayout {
        spacing: Tokens.space-4;
        LadderLine { label: root.recent-label; year: root.year-at(0); value: root.at(0); }
        LadderLine { label: root.recent-prior-label; year: root.year-at(1); value: root.at(1); }
        LadderLine { label: @tr("(3) Total de (1) + (2)"); value: root.at(2); }
        LadderLine { label: @tr("(4) (3) divisé par 2"); value: root.at(3); }
        LadderLine { label: @tr("{} {} ans", root.old-label, root.span); year: root.year-at(2); value: root.at(4); }
        LadderLine { label: @tr("{} {} ans", root.old-prior-label, root.span-plus-one()); year: root.year-at(3); value: root.at(5); }
        LadderLine { label: @tr("(7) Total de (5) + (6)"); value: root.at(6); }
        LadderLine { label: @tr("(8) (7) divisé par 2"); value: root.at(7); }
        LadderLine { label: @tr("(9) Hausse sur la période, (4) − (8)"); value: root.at(8); }
        LadderLine {
            label: root.nonpositive-base ? @tr("(10) Hausse en pour cent, (9) ÷ (8) : base non positive") : @tr("(10) Hausse en pour cent, (9) ÷ (8)");
            value: root.at(9);
        }
        HorizontalLayout {
            spacing: Tokens.space-8;
            min-height: Tokens.row-height * 0.8;
            Text {
                text: root.rate-label;
                color: Tokens.text-high;
                font-size: Tokens.font-body;
                font-weight: Tokens.weight-semibold;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Text {
                text: root.rate != "" ? root.rate : "—";
                color: Tokens.text-high;
                font-family: Tokens.font-numeric;
                font-size: Tokens.font-body;
                font-weight: Tokens.weight-semibold;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 180px;
            }
        }
        Label { text: @tr("Base : deux moyennes de deux ans, à {} ans d'écart (formulaire : 5).", root.span); }
    }
}

component PriceCell inherits Fact {
    horizontal-stretch: 1;
}

export component QuickScreenScreen inherits Rectangle {
    pure function meets-words(key: string) -> string {
        if (key == "yes") { return @tr("atteint"); }
        if (key == "no") { return @tr("n'atteint pas"); }
        return "";
    }
    pure function or-dash(s: string) -> string { return s != "" ? s : "—"; }
    // « plus haut / plus bas / au même niveau » from the Rust key (decided on the displayed
    // percentage) and the percentage — the PDF's words (G1 D review: screen / PDF parity).
    pure function vs-high() -> string {
        if (QuickScreen.price-vs-high-pct == "") { return "—"; }
        if (QuickScreen.price-vs-high == "higher") { return @tr("{} ({})", @tr("plus haut"), QuickScreen.price-vs-high-pct); }
        if (QuickScreen.price-vs-high == "lower") { return @tr("{} ({})", @tr("plus bas"), QuickScreen.price-vs-high-pct); }
        if (QuickScreen.price-vs-high == "same") { return @tr("{} ({})", @tr("au même niveau"), QuickScreen.price-vs-high-pct); }
        return "—";
    }
    pure function pe-words() -> string {
        if (QuickScreen.pe-position == "higher") { return @tr("au-dessus"); }
        if (QuickScreen.pe-position == "similar") { return @tr("voisin"); }
        if (QuickScreen.pe-position == "lower") { return @tr("au-dessous"); }
        return "";
    }

    Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Tokens.space-24;
            spacing: Tokens.space-16;

            HorizontalLayout {
                spacing: Tokens.space-8;
                alignment: start;
                ActionButton {
                    label: QuickScreen.from-watchlist ? @tr("‹ Retour à la liste de suivi")
                        : QuickScreen.from-study ? @tr("‹ Retour à l'étude") : @tr("‹ Retour aux études");
                    enabled: true;
                    clicked => { QuickScreen.close(); }
                }
                ActionButton {
                    label: @tr("Exporter PDF");
                    enabled: true;
                    clicked => { QuickScreen.export-pdf(); }
                }
                if !QuickScreen.from-study && !QuickScreen.from-watchlist: ActionButton {
                    label: @tr("Créer l'étude");
                    enabled: true;
                    clicked => { QuickScreen.create-study(); }
                }
            }
            Text {
                // A criblage row without a study has no currency (the watchlist carries none).
                text: QuickScreen.currency == "" ? @tr("Examen rapide — {}", QuickScreen.ticker)
                    : QuickScreen.name != ""
                    ? @tr("Examen rapide — {} · {} ({})", QuickScreen.ticker, QuickScreen.name, QuickScreen.currency)
                    : @tr("Examen rapide — {} ({})", QuickScreen.ticker, QuickScreen.currency);
                color: Tokens.text-high;
                font-size: Tokens.font-h2;
                font-weight: Tokens.weight-semibold;
            }
            Label { text: @tr("Liste de contrôle pour débutant, un regard avant l'étude complète · au {} · {}", QuickScreen.date, QuickScreen.source); }
            if QuickScreen.notice != "": Label { text: QuickScreen.notice; }

            PanelCard {
                title: @tr("1 · Ventes passées");
                Ladder {
                    lines: QuickScreen.sales-lines;
                    years: QuickScreen.sales-years;
                    rate: QuickScreen.sales-rate;
                    span: QuickScreen.sales-span;
                    nonpositive-base: QuickScreen.sales-nonpositive-base;
                    unavailable: QuickScreen.sales-unavailable;
                    rate-label: @tr("Taux annuel composé de croissance des ventes");
                    recent-label: @tr("(1) Ventes de l'année la plus récente");
                    recent-prior-label: @tr("(2) Ventes de l'année précédente");
                    old-label: @tr("(5) Ventes il y a");
                    old-prior-label: @tr("(6) Ventes il y a");
                }
            }
            PanelCard {
                title: @tr("2 · Bénéfice par action passé");
                Ladder {
                    lines: QuickScreen.eps-lines;
                    years: QuickScreen.eps-years;
                    rate: QuickScreen.eps-rate;
                    span: QuickScreen.eps-span;
                    nonpositive-base: QuickScreen.eps-nonpositive-base;
                    unavailable: QuickScreen.eps-unavailable;
                    rate-label: @tr("Taux annuel composé de croissance du BPA");
                    recent-label: @tr("(1) BPA de l'année la plus récente");
                    recent-prior-label: @tr("(2) BPA de l'année précédente");
                    old-label: @tr("(5) BPA il y a");
                    old-prior-label: @tr("(6) BPA il y a");
                }
                if QuickScreen.eps-vs-sales == "eps": StatusBand { icon: "◦"; text: @tr("Le BPA a augmenté plus vite que les ventes sur la période."); }
                if QuickScreen.eps-vs-sales == "sales": StatusBand { icon: "◦"; text: @tr("Le BPA a augmenté moins vite que les ventes sur la période."); }
                if QuickScreen.eps-vs-sales == "same": StatusBand { icon: "◦"; text: @tr("Le BPA et les ventes ont augmenté au même rythme sur la période."); }
                Label { text: @tr("Raisons apparentes de l'écart et de la croissance passée (votre note, non enregistrée) :"); }
                TextField {
                    placeholder: @tr("p. ex. un nouveau produit, une reprise cyclique, une acquisition…");
                    text <=> QuickScreen.reasons;
                }
                Label { text: @tr("Les facteurs de la croissance passée resteront-ils effectifs cinq ans ?"); }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    ChoiceChip { label: @tr("oui"); selected: QuickScreen.factors-continue == "yes"; activated => { QuickScreen.factors-continue = "yes"; } }
                    ChoiceChip { label: @tr("oui, mais moins"); selected: QuickScreen.factors-continue == "less"; activated => { QuickScreen.factors-continue = "less"; } }
                    ChoiceChip { label: @tr("non"); selected: QuickScreen.factors-continue == "no"; activated => { QuickScreen.factors-continue = "no"; } }
                }
            }
            PanelCard {
                title: @tr("3 · Cours de l'action");
                HorizontalLayout {
                    spacing: Tokens.space-24;
                    alignment: start;
                    Label { text: @tr("Cours actuel : {}", QuickScreen.present-price != "" ? QuickScreen.present-price : "—"); }
                    Label { text: @tr("BPA actuel : {}", QuickScreen.present-eps != "" ? QuickScreen.present-eps : "—"); }
                    Label { text: @tr("PER actuel : {}", QuickScreen.present-pe != "" ? QuickScreen.present-pe : "—"); }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    Label { text: @tr("Année"); width: 110px; }
                    PriceCell { text: @tr("Cours haut (A)"); color: Tokens.text-mid; }
                    PriceCell { text: @tr("Cours bas (B)"); color: Tokens.text-mid; }
                    PriceCell { text: @tr("BPA (C)"); color: Tokens.text-mid; }
                    PriceCell { text: @tr("PER au haut (A ÷ C)"); color: Tokens.text-mid; }
                    PriceCell { text: @tr("PER au bas (B ÷ C)"); color: Tokens.text-mid; }
                }
                for r in QuickScreen.price-rows: HorizontalLayout {
                    spacing: Tokens.space-8;
                    min-height: Tokens.row-height * 0.7;
                    Label { text: r.year; width: 110px; }
                    PriceCell { text: r.high != "" ? r.high : "—"; }
                    PriceCell { text: r.low != "" ? r.low : "—"; }
                    PriceCell { text: r.eps != "" ? r.eps : "—"; }
                    PriceCell { text: r.pe-high != "" ? r.pe-high : "—"; }
                    PriceCell { text: r.pe-low != "" ? r.pe-low : "—"; }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    min-height: Tokens.row-height * 0.7;
                    Label { text: @tr("Totaux"); width: 110px; }
                    PriceCell { text: ""; }
                    PriceCell { text: ""; }
                    PriceCell { text: ""; }
                    PriceCell { text: QuickScreen.pe-high-total != "" ? QuickScreen.pe-high-total : "—"; }
                    PriceCell { text: QuickScreen.pe-low-total != "" ? QuickScreen.pe-low-total : "—"; }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    min-height: Tokens.row-height * 0.7;
                    Label { text: @tr("Moyennes"); width: 110px; }
                    PriceCell { text: ""; }
                    PriceCell { text: ""; }
                    PriceCell { text: ""; }
                    PriceCell { text: QuickScreen.pe-high-avg != "" ? QuickScreen.pe-high-avg : "—"; }
                    PriceCell { text: QuickScreen.pe-low-avg != "" ? QuickScreen.pe-low-avg : "—"; }
                }
                // Absence honesty (G1 review): « cinq ans » only over the form's full five-year record
                // (the bases come from Rust); a shorter or partial record states its count; the three
                // facts always show, « — » where a figure is absent (spec §6) — never vanish.
                if QuickScreen.pe-basis == "partial": Label {
                    text: @tr("Totaux et moyennes des PER sur {} des {} années du relevé ; un cours ou un BPA absent ou non positif ne donne pas de PER.", QuickScreen.pe-years, QuickScreen.record-years);
                }
                Label {
                    text: QuickScreen.pe-basis == "five"
                        ? @tr("Moyenne des PER moyens haut et bas sur cinq ans : {}", root.or-dash(QuickScreen.pe-avg-of-avgs))
                        : QuickScreen.pe-basis != "" && QuickScreen.pe-years == "1"
                        ? @tr("Moyenne des PER moyens haut et bas sur la seule année du relevé : {}", root.or-dash(QuickScreen.pe-avg-of-avgs))
                        : QuickScreen.pe-basis != ""
                        ? @tr("Moyenne des PER moyens haut et bas sur {} années du relevé : {}", QuickScreen.pe-years, root.or-dash(QuickScreen.pe-avg-of-avgs))
                        : @tr("Moyenne des PER moyens haut et bas : {}", "—");
                }
                StatusBand {
                    icon: "◦";
                    text: QuickScreen.high-basis == "five"
                        ? @tr("Cours actuel par rapport au cours haut d'il y a cinq ans ({}) : {}", root.or-dash(QuickScreen.high-five-years-ago), root.vs-high())
                        : QuickScreen.high-basis == "year"
                        ? @tr("Cours actuel par rapport au cours haut de {} ({}) : {}", QuickScreen.high-year, root.or-dash(QuickScreen.high-five-years-ago), root.vs-high())
                        : @tr("Cours actuel par rapport au cours haut du début du relevé : {}", "—");
                }
                StatusBand {
                    icon: "◦";
                    text: QuickScreen.sold-basis == "five"
                        ? @tr("L'action s'est vendue aussi haut que le cours actuel au cours de {} des cinq dernières années.", QuickScreen.years-sold-as-high)
                        : QuickScreen.sold-basis == "count" && QuickScreen.sold-of == "1" && QuickScreen.years-sold-as-high == "1"
                        ? @tr("L'action s'est vendue aussi haut que le cours actuel lors de la seule année dont le cours haut est connu.")
                        : QuickScreen.sold-basis == "count" && QuickScreen.sold-of == "1"
                        ? @tr("L'action ne s'est pas vendue aussi haut que le cours actuel lors de la seule année dont le cours haut est connu.")
                        : QuickScreen.sold-basis == "count"
                        ? @tr("L'action s'est vendue aussi haut que le cours actuel au cours de {} des {} années dont le cours haut est connu.", QuickScreen.years-sold-as-high, QuickScreen.sold-of)
                        : @tr("Années où l'action s'est vendue aussi haut que le cours actuel : {}", "—");
                }
                StatusBand {
                    icon: "◦";
                    text: root.pe-words() == ""
                        ? @tr("Le PER actuel ({}) par rapport à la moyenne des PER du relevé ({}) : {}", root.or-dash(QuickScreen.present-pe), root.or-dash(QuickScreen.pe-avg-of-avgs), "—")
                        : QuickScreen.pe-basis == "five"
                        ? @tr("Le PER actuel ({}) est {} de la moyenne des cinq ans ({}).", QuickScreen.present-pe, root.pe-words(), QuickScreen.pe-avg-of-avgs)
                        : QuickScreen.pe-years == "1"
                        ? @tr("Le PER actuel ({}) est {} du PER moyen de la seule année du relevé ({}).", QuickScreen.present-pe, root.pe-words(), QuickScreen.pe-avg-of-avgs)
                        : @tr("Le PER actuel ({}) est {} de la moyenne des {} années du relevé ({}).", QuickScreen.present-pe, root.pe-words(), QuickScreen.pe-years, QuickScreen.pe-avg-of-avgs);
                }
                Label { text: @tr("PER inhabituels, moyenne à ajuster (votre note, non enregistrée) :"); }
                TextField {
                    placeholder: @tr("p. ex. le haut de 2021 tient à un exercice exceptionnel…");
                    text <=> QuickScreen.pe-notes;
                }
            }
            PanelCard {
                title: @tr("4 · Conclusion");
                subtitle: @tr("Contre votre objectif ; le formulaire pose les questions, vous y répondez.");
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    Label { text: @tr("Objectif de croissance annuelle (%)"); }
                    TextField {
                        placeholder: @tr("p. ex. 7");
                        text <=> QuickScreen.objective;
                        width: 160px;
                        edited => { QuickScreen.objective-edited(QuickScreen.objective); }
                    }
                }
                // Keys from Rust (G1 review): « objectif non renseigné » only for a blank objective; an
                // absent rate and an unreadable objective each say so. The PDF words the same keys.
                Label {
                    text: QuickScreen.sales-meets == "yes" || QuickScreen.sales-meets == "no"
                        ? @tr("1. Le taux de croissance passé des ventes ({}) {} l'objectif.", QuickScreen.sales-rate, root.meets-words(QuickScreen.sales-meets))
                        : QuickScreen.sales-meets == "no-rate"
                        ? @tr("1. Le taux de croissance passé des ventes est indisponible : pas de comparaison à l'objectif.")
                        : QuickScreen.sales-meets == "unread"
                        ? @tr("1. Le taux de croissance passé des ventes ({}) : objectif non reconnu comme un pourcentage.", root.or-dash(QuickScreen.sales-rate))
                        : @tr("1. Le taux de croissance passé des ventes ({}) : objectif non renseigné.", root.or-dash(QuickScreen.sales-rate));
                }
                Label {
                    text: QuickScreen.eps-meets == "yes" || QuickScreen.eps-meets == "no"
                        ? @tr("2. Le taux de croissance passé du BPA ({}) {} l'objectif.", QuickScreen.eps-rate, root.meets-words(QuickScreen.eps-meets))
                        : QuickScreen.eps-meets == "no-rate"
                        ? @tr("2. Le taux de croissance passé du BPA est indisponible : pas de comparaison à l'objectif.")
                        : QuickScreen.eps-meets == "unread"
                        ? @tr("2. Le taux de croissance passé du BPA ({}) : objectif non reconnu comme un pourcentage.", root.or-dash(QuickScreen.eps-rate))
                        : @tr("2. Le taux de croissance passé du BPA ({}) : objectif non renseigné.", root.or-dash(QuickScreen.eps-rate));
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    Label { text: @tr("3. Croissance possible du BPA sur cinq ans, votre avis :"); }
                    ChoiceChip { label: @tr("oui"); selected: QuickScreen.eps-will-meet == "yes"; activated => { QuickScreen.eps-will-meet = "yes"; } }
                    ChoiceChip { label: @tr("non"); selected: QuickScreen.eps-will-meet == "no"; activated => { QuickScreen.eps-will-meet = "no"; } }
                }
                // Conclusion 4 names the missing figure (the present P/E, the record's average, or
                // both) — the PDF prints the same line from the same keys.
                Label {
                    text: root.pe-words() != "" && QuickScreen.pe-basis == "five"
                        ? @tr("4. Le cours : PER actuel {} de la norme des cinq ans.", root.pe-words())
                        : root.pe-words() != "" && QuickScreen.pe-years == "1"
                        ? @tr("4. Le cours : PER actuel {} de la norme de la seule année du relevé.", root.pe-words())
                        : root.pe-words() != ""
                        ? @tr("4. Le cours : PER actuel {} de la norme des {} années du relevé.", root.pe-words(), QuickScreen.pe-years)
                        : QuickScreen.pe-absent == "average"
                        ? @tr("4. Le cours : moyenne des PER du relevé indisponible.")
                        : QuickScreen.pe-absent == "both"
                        ? @tr("4. Le cours : PER actuel et moyenne des PER du relevé indisponibles.")
                        : @tr("4. Le cours : PER actuel indisponible.");
                }
                Label { text: @tr("Ce formulaire n'est pas une analyse suffisante ; il aide à poser les questions avant une étude complète."); }
            }
        }
    }
}
