// Portefeuille — the holdings register (Story 4.3, FR36) and its risk overlay (Epics 4 + 6), laid
// out by the UX pass (2026-09-23) in titled cards: Portefeuilles · Candidats · Capital à risque ·
// Dividendes nets · Consolidation · Concentration et taille · Positions · Positions vendues.
// Every data ENTRY (position, buy, sell, dividend, stop, portfolio) opens a `Dialog` form; every
// destructive gesture a `Dialog` confirm; every persistent STATE (missing rate, unclassified, no
// linked study, a threshold murmur) is a `StatusBand`; a written OUTCOME stays the inline notice.
// Neutral, no advice, no zone hues (Story 4.2 rule). Intents → Rust (validate + persist + re-render).

import { Tokens } from "../tokens.slint";
import { Dialog, Holdings, HoldingRow, PortfolioRow, CapitalAtRiskRow, Labels, Prefs } from "../state.slint";
import { ActionButton } from "../components/action_button.slint";
import { ChoiceChip } from "../components/choice_chip.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBand } from "../components/status_band.slint";

// A neutral fact line in the numeric face (the cards' body lines).
component FactLine inherits Text {
    color: Tokens.text-high;
    font-family: Tokens.font-numeric;
    font-size: Tokens.font-caption;
    wrap: word-wrap;
}

// A caption line (a header inside a card, or a footnote).
component CaptionLine inherits Text {
    color: Tokens.text-mid;
    font-size: Tokens.font-caption;
    wrap: word-wrap;
}

export component PortfolioScreen inherits Rectangle {
    // Issue #84: the « Positions vendues » section is collapsed by default (pure-Slint toggle).
    property <bool> sold-open: false;

    // ── The dialog openers (the @tr titles/sentences live HERE, posture-gated like every string). ──
    function open-add-holding() {
        Dialog.form("holding-add", @tr("Ajouter une position"),
            @tr("La position est rattachée à l'étude du même symbole et de la même devise ; c'est elle qui donne la zone et le prix actuel."),
            "", "");
        Dialog.draft-currency = Holdings.reference-currency;
    }
    function open-edit-holding(row: HoldingRow) {
        Dialog.form("holding-edit", @tr("Modifier la position {}", row.ticker),
            @tr("Une position adossée à un registre de transactions garde sa quantité, son prix et sa devise ; seuls le symbole et le secteur sont modifiables ici."),
            row.id, "");
        Dialog.draft-ticker = row.ticker;
        Dialog.draft-quantity = row.quantity;
        Dialog.draft-price = row.purchase-price;
        Dialog.draft-currency = row.currency;
        Dialog.draft-sector = row.sector;
    }
    function open-buy(id: string, ticker: string, currency: string) {
        Dialog.form("buy", @tr("Achat de {}", ticker),
            @tr("Un achat augmente la position et recalcule son prix moyen d'achat."),
            id, @tr("Montants en {}", currency));
    }
    function open-rebuy(id: string, ticker: string, currency: string) {
        Dialog.form("buy", @tr("Rachat de {}", ticker),
            @tr("Un achat rouvre la position, qui revient au registre avec tout son historique."),
            id, @tr("Montants en {}", currency));
    }
    function open-sell(id: string, ticker: string, currency: string) {
        Dialog.form("sell", @tr("Vente de {}", ticker),
            @tr("Une vente partielle garde la position ; une vente totale la retire du registre, où elle reste consultable sous « Positions vendues »."),
            id, @tr("Montants en {}", currency));
    }
    function open-dividend(id: string, ticker: string, currency: string) {
        Dialog.form("dividend", @tr("Dividende de {}", ticker),
            @tr("Le brut par action est multiplié par les actions concernées ; la retenue à la source en est déduite pour donner le net réinvestissable."),
            id, @tr("Montants en {}", currency));
    }
    function open-stop(row: HoldingRow) {
        Dialog.form("stop", @tr("Seuil suiveur de {}", row.ticker),
            @tr("Le seuil se calcule depuis le plus haut atteint par le cours ; quand le cours passe dessous, la position le signale — elle n'est jamais vendue d'elle-même."),
            row.id, row.has-stop ? @tr("Seuil actuel : {} % ({} {})", row.stop-pct, row.stop-level, row.currency) : "");
        Dialog.draft-price = row.has-stop ? row.stop-pct : Prefs.default-trailing-stop-pct;
        Dialog.flag = row.has-stop;
    }
    function open-sell-trigger(row: HoldingRow) {
        Dialog.form("sell-trigger", @tr("Vente de {}", row.ticker),
            @tr("La vente est enregistrée au prix actuel de l'étude liée ; une quantité vide vend toute la position."),
            row.id, row.current-price != "" ? @tr("Prix actuel : {} {}", row.current-price, row.currency) : "");
    }

    Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Tokens.space-24;
            spacing: Tokens.space-16;

            Text {
                text: @tr("Portefeuille");
                color: Tokens.text-high;
                font-size: Tokens.font-h2;
                font-weight: Tokens.weight-semibold;
            }

            // ── Story 6.1 (FR37): multiple portfolios — one per bank/account. The selector picks the
            //    active one; the register below shows its holdings. Add / rename go through a form
            //    dialog; delete through a confirm (its guards refuse with a notice). ──
            PanelCard {
                title: @tr("Portefeuilles");
                subtitle: @tr("Un portefeuille par banque ou compte ; devise de référence : {} (modifiable dans Réglages).", Holdings.reference-currency);

                if Holdings.portfolios.length > 1: Flickable {
                    height: Tokens.row-height + Tokens.space-8;
                    viewport-width: chips.preferred-width;
                    viewport-height: self.height;
                    chips := HorizontalLayout {
                        spacing: Tokens.space-8;
                        alignment: start;
                        for p in Holdings.portfolios: ChoiceChip {
                            label: p.name;
                            selected: p.id == Holdings.active-portfolio-id;
                            activated => { Holdings.select-portfolio(p.id); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;
                    ActionButton {
                        label: @tr("Ajouter un portefeuille…");
                        enabled: !Holdings.read-only;
                        clicked => {
                            Dialog.form("portfolio-add", @tr("Ajouter un portefeuille"),
                                @tr("Un portefeuille regroupe les positions d'une banque ou d'un compte ; la consolidation les additionne toutes."),
                                "", "");
                        }
                    }
                    ActionButton {
                        label: @tr("Renommer…");
                        enabled: !Holdings.read-only && Holdings.active-portfolio-id != "";
                        clicked => {
                            Dialog.form("portfolio-rename", @tr("Renommer le portefeuille"), "", Holdings.active-portfolio-id, "");
                        }
                    }
                    ActionButton {
                        label: @tr("Supprimer le portefeuille");
                        enabled: !Holdings.read-only && Holdings.active-portfolio-id != "";
                        clicked => {
                            Dialog.confirm(@tr("Supprimer ce portefeuille ?"),
                                @tr("Un portefeuille qui contient un historique de positions n'est pas supprimé ; le dernier portefeuille non plus."),
                                @tr("Supprimer"), "delete-portfolio", Holdings.active-portfolio-id);
                        }
                    }
                }
            }

            // ── Story 6.8 (FR48): the replacement-candidates panel — watchlist candidates nearest
            // to / inside their Buy zone, with neutral re-concentration FACTS. Auto-opened after a
            // sell, or via « Candidats » on a trigger; the app surfaces facts, never « buy this one ».
            // Ink only — the zone is stated in words (Labels nouns); no hue outside §4. ──
            if Holdings.candidates-visible: PanelCard {
                title: Holdings.candidates-sold
                    ? @tr("Vente enregistrée : {} — candidats de la liste de suivi", Holdings.candidates-context)
                    : Holdings.candidates-context != ""
                        ? @tr("Candidats de remplacement pour {} (liste de suivi)", Holdings.candidates-context)
                        : @tr("Candidats de remplacement (liste de suivi)");

                if Holdings.candidates-unavailable: StatusBand {
                    icon: "⊘";
                    text: @tr("Liste de suivi indisponible.");
                }
                if Holdings.candidate-rows.length == 0 && !Holdings.candidates-unavailable: CaptionLine {
                    text: @tr("La liste de suivi est vide.");
                }
                for candidate in Holdings.candidate-rows: HorizontalLayout {
                    spacing: Tokens.space-8;
                    FactLine {
                        text: candidate.data == "no-study"
                            ? @tr("{} — aucune étude", candidate.ticker)
                            // Issue #95: a FAILED study read is « indisponible », never « aucune étude ».
                            : candidate.data == "study-unavailable"
                            ? @tr("{} — étude indisponible", candidate.ticker)
                            // Issue #48: a price BELOW the recorded band is its own neutral fact.
                            : candidate.below-band
                            ? @tr("{} — sous la bande de prévision", candidate.ticker)
                            : candidate.data == "insufficient"
                                ? @tr("{} — données insuffisantes", candidate.ticker)
                                : candidate.in-buy-zone
                                    ? @tr("{} — dans la zone d'achat", candidate.ticker)
                                    : candidate.distance != ""
                                        ? @tr("{} — à {} % au-dessus de la zone d'achat", candidate.ticker, candidate.distance)
                                        // A known zone without a statable distance (degenerate
                                        // band bottom) — the zone noun IS the fact. The key
                                        // comparisons stay OUTSIDE @tr (the register precedent).
                                        : candidate.zone == "neutral"
                                            ? @tr("{} — zone : {}", candidate.ticker, Labels.zone-hold)
                                            : candidate.zone == "sell"
                                                ? @tr("{} — zone : {}", candidate.ticker, Labels.zone-sell)
                                                : @tr("{} — zone : {}", candidate.ticker, Labels.zone-buy);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if candidate.ud != "": FactLine {
                        text: @tr("H/B {}", candidate.ud);
                        vertical-alignment: center;
                    }
                    if candidate.held-share != "": CaptionLine {
                        text: candidate.held-flagged
                            ? @tr("déjà détenu : {} % du capital · seuil {} % approché ou atteint", candidate.held-share, Holdings.concentration-threshold-display)
                            : @tr("déjà détenu : {} % du capital", candidate.held-share);
                        vertical-alignment: center;
                    }
                    // ── Issue #98 (FR48): the sector re-concentration facts — the currency
                    // block's exact mirror. An unknown sector is STATED (« non renseigné »,
                    // the 2026-07-09 decision), never silent; an absent share never flags. ──
                    if candidate.study-id != "" && candidate.sector == "": CaptionLine {
                        text: @tr("secteur : non renseigné");
                        vertical-alignment: center;
                    }
                    if candidate.sector-missing != "": CaptionLine {
                        text: @tr("secteur {} : exposition indisponible (taux manquant {})", candidate.sector, candidate.sector-missing);
                        vertical-alignment: center;
                    }
                    if candidate.sector-missing == "" && candidate.sector-share != "": CaptionLine {
                        text: candidate.sector-flagged
                            ? @tr("secteur {} : déjà {} % du capital · seuil {} % approché ou atteint", candidate.sector, candidate.sector-share, Holdings.concentration-threshold-display)
                            : @tr("secteur {} : déjà {} % du capital", candidate.sector, candidate.sector-share);
                        vertical-alignment: center;
                    }
                    if candidate.sector != "" && candidate.sector-missing == "" && candidate.sector-share == "": CaptionLine {
                        text: @tr("secteur {} : exposition indisponible", candidate.sector);
                        vertical-alignment: center;
                    }
                    if candidate.currency-missing != "": CaptionLine {
                        text: @tr("devise {} : exposition indisponible (taux manquant {})", candidate.currency, candidate.currency-missing);
                        vertical-alignment: center;
                    }
                    if candidate.currency-missing == "" && candidate.currency-share != "": CaptionLine {
                        text: candidate.currency-flagged
                            ? @tr("devise {} : déjà {} % du capital · seuil {} % approché ou atteint", candidate.currency, candidate.currency-share, Holdings.concentration-threshold-display)
                            : @tr("devise {} : déjà {} % du capital", candidate.currency, candidate.currency-share);
                        vertical-alignment: center;
                    }
                    // The exposure could not be stated at all (the shares' total is absent for a
                    // reason named on ANOTHER currency's line, or unformed) — an honest absence,
                    // never a silently missing fact.
                    if candidate.currency != "" && candidate.currency-missing == "" && candidate.currency-share == "": CaptionLine {
                        text: @tr("devise {} : exposition indisponible", candidate.currency);
                        vertical-alignment: center;
                    }
                    if candidate.study-id != "": ActionButton {
                        label: @tr("Ouvrir l'étude");
                        enabled: true;
                        clicked => { Holdings.open-candidate-study(candidate.study-id); }
                    }
                    if candidate.study-id == "": ActionButton {
                        label: @tr("Études");
                        enabled: true;
                        clicked => { Holdings.go-to-studies(); }
                    }
                }
                // Issue #98 (FR48): the sector blind spot, stated once at panel level — the
                // « non renseigné » bucket keeps the denominator whole (2026-07-09 decision).
                if Holdings.candidates-sector-unlabeled != "": CaptionLine {
                    text: @tr("secteur non renseigné : {} % du capital investi", Holdings.candidates-sector-unlabeled);
                }
                if Holdings.candidates-rates != "": CaptionLine {
                    text: @tr("Convertis aux taux : {}", Holdings.candidates-rates);
                }
                HorizontalLayout {
                    alignment: end;
                    ActionButton {
                        label: @tr("Fermer");
                        enabled: true;
                        clicked => { Holdings.close-candidates(); }
                    }
                }
            }

            // Story 4.6 (FR43) / Story 6.2 (FR38): the portfolio's capital-at-risk — a neutral fact (no
            // hue, no action), shown PER currency. Holdings can differ in currency, so there is no mixed
            // global total (FX only at consolidation, Story 6.5/6.6). The "% du capital investi" clause is
            // dropped for a currency with nothing invested. Issue #61: the un-protected exposure is a
            // STATE band, so a "0 %" CaR is never read as safety.
            if Holdings.capital-at-risk-by-currency.length > 0: PanelCard {
                title: @tr("Capital à risque");
                subtitle: @tr("Par devise : ce que les seuils suiveurs laissent exposé, en part du capital investi dans cette devise.");

                for line in Holdings.unstopped-exposure: StatusBand {
                    icon: "◦";
                    text: line;
                }
                for car in Holdings.capital-at-risk-by-currency: FactLine {
                    text: car.pct != ""
                        ? @tr("{} {} ({} % du capital investi)", car.amount, car.currency, car.pct)
                        : @tr("{} {}", car.amount, car.currency);
                }
            }

            // Story 6.4 (FR41): the NET reinvestable dividend cash, per currency — the study keeps the
            // gross (method fidelity); this is what is actually available to reinvest after the
            // withholding at source. No mixed-currency total (FX is Story 6.5). A neutral fact.
            if Holdings.reinvestable-cash.length > 0: PanelCard {
                title: @tr("Dividendes nets perçus (réinvestissables)");
                for cash in Holdings.reinvestable-cash: FactLine {
                    text: @tr("{} {}", cash.amount, cash.currency);
                }
            }

            // ── Story 6.6 (FR44): the consolidation hierarchy — per bank, then the global total, in
            // the reference currency; FX applied ONLY here (the per-currency lines above stay
            // native). Every converted figure's rates are named below (FR28 inspectability). ──
            if Holdings.consolidation-banks.length > 0: PanelCard {
                title: @tr("Consolidation (toutes banques, en {})", Holdings.reference-currency);

                if Holdings.consolidation-global == "" && Holdings.consolidation-missing != "": StatusBand {
                    icon: "◦";
                    text: @tr("Total global indisponible : taux manquant {}", Holdings.consolidation-missing);
                }
                if Holdings.consolidation-global == "" && Holdings.consolidation-missing == "": StatusBand {
                    icon: "⊘";
                    text: @tr("Total global indisponible");
                }
                for bank in Holdings.consolidation-banks: FactLine {
                    text: bank.missing != ""
                        ? @tr("{} — indisponible : taux manquant {}", bank.name, bank.missing)
                        : bank.unavailable
                            ? @tr("{} — indisponible", bank.name)
                            : bank.pct != ""
                                ? @tr("{} — {} ({} % du capital investi)", bank.name, bank.amount, bank.pct)
                                : @tr("{} — {}", bank.name, bank.amount);
                }
                if Holdings.consolidation-global != "": FactLine {
                    text: Holdings.consolidation-global-pct != ""
                        ? @tr("Total global : {} ({} % du capital investi)",
                            Holdings.consolidation-global, Holdings.consolidation-global-pct)
                        : @tr("Total global : {}", Holdings.consolidation-global);
                }
                if Holdings.consolidation-rates != "": CaptionLine {
                    text: @tr("Convertis aux taux : {}", Holdings.consolidation-rates);
                }
            }

            // ── Story 6.7 (FR45): concentration against the TOTAL invested capital — per security,
            // aggregated across ALL banks and currencies (largest share first) — plus the
            // diversify-by-size mix against the configured table. Neutral facts; the near-threshold
            // murmur and every « non classé » reason are STATE bands (ink only, no hue). ──
            if Holdings.concentration-rows.length > 0 || Holdings.concentration-unavailable: PanelCard {
                title: @tr("Concentration et taille");
                subtitle: @tr("Part de chaque titre dans le capital total investi (toutes banques, en {}), puis la répartition par taille d'entreprise d'après le chiffre d'affaires de l'étude liée.", Holdings.reference-currency);

                if Holdings.concentration-unavailable: StatusBand {
                    icon: "⊘";
                    text: @tr("Concentration indisponible");
                }
                if Holdings.concentration-global-absent && Holdings.concentration-missing != "": StatusBand {
                    icon: "◦";
                    text: @tr("Parts indisponibles : taux manquant {}", Holdings.concentration-missing);
                }
                if Holdings.concentration-global-absent && Holdings.concentration-missing == "": StatusBand {
                    icon: "⊘";
                    text: @tr("Parts indisponibles");
                }
                for line in Holdings.concentration-rows: VerticalLayout {
                    spacing: Tokens.space-4;
                    if line.missing != "": StatusBand {
                        icon: "◦";
                        text: @tr("{} — indisponible : taux manquant {}", line.ticker, line.missing);
                    }
                    if line.missing == "" && line.amount == "": StatusBand {
                        icon: "⊘";
                        text: @tr("{} — indisponible", line.ticker);
                    }
                    if line.missing == "" && line.amount != "" && line.flagged: StatusBand {
                        icon: "⚠";
                        text: @tr("{} — {} ({} % du capital total · seuil {} % approché ou atteint)",
                            line.ticker, line.amount, line.share, Holdings.concentration-threshold-display);
                    }
                    if line.missing == "" && line.amount != "" && !line.flagged: FactLine {
                        text: line.share != ""
                            ? @tr("{} — {} ({} % du capital total)", line.ticker, line.amount, line.share)
                            : @tr("{} — {}", line.ticker, line.amount);
                    }
                }
                if Holdings.size-mix-rows.length > 0: CaptionLine {
                    text: @tr("Répartition par taille (chiffre d'affaires) :");
                }
                // The walk's « rien ne s'affiche » : every class at 0 % because NOTHING is
                // classified — the reason bands below explain it, this band says it first.
                if Holdings.size-mix-rows.length > 0 && Holdings.size-unclassified-rows.length == Holdings.concentration-rows.length: StatusBand {
                    icon: "◦";
                    text: @tr("Aucune position n'a pu être classée par taille ; les parts ci-dessous sont à 0 % pour cette raison.");
                }
                for unclassified in Holdings.size-unclassified-rows: StatusBand {
                    icon: "◦";
                    text: unclassified.reason-key == "no-study"
                        ? @tr("{} — non classé (aucune étude)", unclassified.ticker)
                        // Issue #95: a FAILED study read is « indisponible », never « aucune étude ».
                        : unclassified.reason-key == "study-unavailable"
                        ? @tr("{} — non classé (étude indisponible)", unclassified.ticker)
                        : unclassified.reason-key == "no-sales"
                            ? @tr("{} — non classé (chiffre d'affaires indisponible)", unclassified.ticker)
                            : unclassified.reason-key == "missing-rate"
                                ? @tr("{} — non classé (taux manquant {})", unclassified.ticker, unclassified.missing)
                                : @tr("{} — non classé (conversion impossible)", unclassified.ticker);
                }
                for mix in Holdings.size-mix-rows: FactLine {
                    text: mix.share != ""
                        ? @tr("{} — {} % (cible {} %)",
                            mix.class-key == "small" ? @tr("Petite") : mix.class-key == "medium" ? @tr("Moyenne") : @tr("Grande"),
                            mix.share, mix.target)
                        : @tr("{} — indisponible (cible {} %)",
                            mix.class-key == "small" ? @tr("Petite") : mix.class-key == "medium" ? @tr("Moyenne") : @tr("Grande"),
                            mix.target);
                }
                if Holdings.concentration-rates != "": CaptionLine {
                    text: @tr("Convertis aux taux : {}", Holdings.concentration-rates);
                }
            }

            // ── The register: the active portfolio's positions. Add → form dialog; refresh (Story
            //    4.4, FR40) user-initiated, never background-polled; the outcome notice slot. ──
            PanelCard {
                title: @tr("Positions");

                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;
                    ActionButton {
                        label: @tr("Ajouter une position…");
                        enabled: !Holdings.read-only;
                        clicked => { root.open-add-holding(); }
                    }
                    ActionButton {
                        // Disabled while a refresh is in flight (issue #52) — no double-click duplicate jobs.
                        label: Holdings.refreshing ? @tr("Rafraîchissement…") : @tr("Rafraîchir les prix");
                        enabled: !Holdings.read-only && Holdings.holding-count > 0 && !Holdings.refreshing;
                        clicked => { Holdings.refresh-prices(); }
                    }
                    // Issue #100: the paced batch counts up (n/t) and can be cancelled instead of a frozen wait.
                    if Holdings.refreshing: FactLine {
                        text: Holdings.refresh-progress;
                        vertical-alignment: center;
                    }
                    if Holdings.refreshing: ActionButton {
                        label: @tr("Annuler");
                        enabled: true;
                        clicked => { Holdings.cancel-refresh(); }
                    }
                }

                // The OUTCOME slot (« … a été enregistré. ») — refusals go to the Dialog, never here.
                if Holdings.notice != "": CaptionLine {
                    text: Holdings.notice;
                }

                // ── Empty state ──
                if Holdings.holding-count == 0: Text {
                    text: @tr("Aucune position pour le moment ; « Ajouter une position… » en crée une.");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-body;
                    wrap: word-wrap;
                }

                // ── The rows ──
                for row[index] in Holdings.rows: hrow := Rectangle {
                    background: Tokens.surface-alt;
                    border-width: Tokens.border;
                    border-color: Tokens.separator;
                    border-radius: Tokens.radius;
                    VerticalLayout {
                        padding: Tokens.space-12;
                        spacing: Tokens.space-8;

                        // The facts line + the row actions.
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            Text {
                                text: row.ticker;
                                color: Tokens.text-high;
                                font-size: Tokens.font-body;
                                font-weight: Tokens.weight-semibold;
                                vertical-alignment: center;
                            }
                            CaptionLine {
                                text: @tr("Quantité : {}", row.quantity);
                                vertical-alignment: center;
                            }
                            CaptionLine {
                                text: @tr("Prix d'achat : {} {}", row.purchase-price, row.currency);
                                vertical-alignment: center;
                            }
                            // Issue #98 (FR48): the sector fact, when known (a caption — neutral ink).
                            if row.sector != "": CaptionLine {
                                text: @tr("Secteur : {}", row.sector);
                                vertical-alignment: center;
                            }
                            // ── Story 4.4 (FR40): the matched study's zone + present price + freshness.
                            // The zone marker is NEUTRAL ink + a glyph — never a buy/hold/sell hue. ──
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                if row.linked: CaptionLine {
                                    text: row.zone == "buy" ? @tr("◆ {}", Labels.zone-buy)
                                        : row.zone == "neutral" ? @tr("◆ {}", Labels.zone-hold)
                                        : row.zone == "sell" ? @tr("◆ {}", Labels.zone-sell)
                                        // Issue #48: a price BELOW the recorded band is its own neutral fact.
                                        : row.below-band ? @tr("◆ Sous la bande de prévision")
                                        : "—";
                                }
                                if row.linked && row.current-price != "": FactLine {
                                    text: @tr("Prix actuel : {} {}", row.current-price, row.currency);
                                }
                                // Freshness murmur (Story 3.3/3.5 vocabulary): "périmé" after a failed/older
                                // refresh, else "à jour le {}" once a successful refresh has stamped an as-of.
                                if row.linked && row.stale: CaptionLine {
                                    text: @tr("◦ périmé");
                                }
                                if row.linked && !row.stale && row.as-of != "": CaptionLine {
                                    text: @tr("à jour le {}", row.as-of);
                                }
                            }
                            // ── Story 4.5 (FR42): the trailing stop — a neutral fact; set/clear in a dialog. ──
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                if row.has-stop: CaptionLine {
                                    text: @tr("Stop {}% : {} {}", row.stop-pct, row.stop-level, row.currency);
                                }
                                if row.has-stop && row.stop-breached: CaptionLine {
                                    text: @tr("◆ sous le stop");
                                }
                                if row.has-stop && !row.stop-breached && row.stop-distance != "": CaptionLine {
                                    text: @tr("à {} {} au-dessus", row.stop-distance, row.currency);
                                }
                            }
                            ActionButton {
                                label: row.has-stop ? @tr("Seuil…") : @tr("Définir un seuil…");
                                enabled: !Holdings.read-only;
                                clicked => { root.open-stop(row); }
                            }
                            // Story 6.3 (FR39): show/hide this holding's transaction ledger (one at a time).
                            ActionButton {
                                label: Holdings.ledger-holding-id == row.id
                                    ? @tr("Masquer les transactions") : @tr("Transactions");
                                clicked => {
                                    if (Holdings.ledger-holding-id == row.id) {
                                        Holdings.close-ledger();
                                    } else {
                                        Holdings.open-ledger(row.id);
                                    }
                                }
                            }
                            ActionButton {
                                label: @tr("Modifier…");
                                enabled: !Holdings.read-only;
                                clicked => { root.open-edit-holding(row); }
                            }
                            ActionButton {
                                label: @tr("Retirer");
                                enabled: !Holdings.read-only;
                                clicked => {
                                    Dialog.confirm(@tr("Retirer la position {} ?", row.ticker),
                                        @tr("La position et son registre de transactions sont retirés du portefeuille ; cette suppression est définitive."),
                                        @tr("Retirer"), "remove-holding", row.id);
                                }
                            }
                        }

                        // ── STATE bands: the study link, named with its cause. ──
                        // Issue #95: a FAILED study read is « indisponible », never « aucune étude liée ».
                        if row.study-unavailable: StatusBand {
                            icon: "⊘";
                            text: @tr("Étude indisponible : la zone et le prix actuel ne peuvent pas être lus.");
                        }
                        if !row.study-unavailable && !row.linked && row.study-other-currency != "": StatusBand {
                            icon: "◦";
                            text: @tr("Aucune étude liée : l'étude {} est en {} et cette position en {} ; une étude ne se lie qu'à une position de même devise.", row.ticker, row.study-other-currency, row.currency);
                        }
                        if !row.study-unavailable && !row.linked && row.study-other-currency == "": StatusBand {
                            icon: "◦";
                            text: @tr("Aucune étude liée : sans étude {}, la position n'a ni zone ni prix actuel.", row.ticker);
                        }

                        // ── Story 4.7 (FR46/FR47): the neutral trigger + its manual actions. Shown only
                        // while the holding fires a trigger and the user hasn't dismissed it. The app never
                        // auto-acts: Vendre / Relever le stop / Ignorer are each an explicit user choice. ──
                        if row.trigger-kind != "" && !row.dismissed: HorizontalLayout {
                            spacing: Tokens.space-8;
                            StatusBand {
                                icon: "⚠";
                                text: row.trigger-kind == "stop"
                                    ? @tr("Le prix a atteint votre stop.")
                                    : @tr("Le prix est dans la zone de vente.");
                                horizontal-stretch: 1;
                            }
                            ActionButton {
                                label: @tr("Vente…");
                                enabled: !Holdings.read-only;
                                clicked => { root.open-sell-trigger(row); }
                            }
                            ActionButton {
                                label: @tr("Relever le stop…");
                                enabled: !Holdings.read-only;
                                clicked => { root.open-stop(row); }
                            }
                            // Story 6.8 (FR48): the same surfacing, BEFORE deciding — a sell-zone entry or
                            // a stop breach is a redeployment moment too.
                            ActionButton {
                                label: @tr("Candidats");
                                enabled: true;
                                clicked => { Holdings.open-candidates(row.ticker); }
                            }
                            ActionButton {
                                label: @tr("Ignorer");
                                enabled: true;
                                clicked => { Holdings.dismiss-trigger(row.id); }
                            }
                        }

                        // ── Story 6.3 (FR39): the holding's transaction ledger — buys and (partial) sells,
                        // editable and deletable; the position's quantity and weighted-average cost derive
                        // from it. The operations open their own dialogs (the UX pass). ──
                        if Holdings.ledger-holding-id == row.id: VerticalLayout {
                            spacing: Tokens.space-8;
                            HorizontalLayout {
                                alignment: start;
                                spacing: Tokens.space-8;
                                ActionButton {
                                    label: @tr("Achat…");
                                    enabled: !Holdings.read-only;
                                    clicked => { root.open-buy(row.id, row.ticker, row.currency); }
                                }
                                ActionButton {
                                    label: @tr("Vente…");
                                    enabled: !Holdings.read-only;
                                    clicked => { root.open-sell(row.id, row.ticker, row.currency); }
                                }
                                ActionButton {
                                    label: @tr("Dividende…");
                                    enabled: !Holdings.read-only;
                                    clicked => { root.open-dividend(row.id, row.ticker, row.currency); }
                                }
                            }
                            if Holdings.ledger-rows.length == 0: CaptionLine {
                                text: @tr("Aucune transaction enregistrée pour cette position.");
                            }
                            for lrow in Holdings.ledger-rows: HorizontalLayout {
                                spacing: Tokens.space-8;
                                CaptionLine {
                                    text: lrow.date;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: lrow.kind == "buy" ? @tr("Achat")
                                        : lrow.kind == "dividend" ? @tr("Dividende")
                                        : @tr("Vente");
                                    color: Tokens.text-high;
                                    font-size: Tokens.font-caption;
                                    vertical-alignment: center;
                                }
                                FactLine {
                                    text: @tr("{} × {} {}", lrow.quantity, lrow.unit-price, lrow.currency);
                                    vertical-alignment: center;
                                }
                                CaptionLine {
                                    // On a dividend row the fees column IS the withholding (Story 6.4).
                                    text: lrow.kind == "dividend"
                                        ? @tr("Retenue : {}", lrow.fees) : @tr("Frais : {}", lrow.fees);
                                    vertical-alignment: center;
                                }
                                if lrow.net != "": FactLine {
                                    text: @tr("net {} {}", lrow.net, lrow.currency);
                                    vertical-alignment: center;
                                }
                                CaptionLine {
                                    text: lrow.rationale;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ActionButton {
                                    label: @tr("Modifier…");
                                    enabled: !Holdings.read-only;
                                    clicked => {
                                        Dialog.form("txn-edit", @tr("Modifier la transaction du {}", lrow.date),
                                            @tr("Le type et la devise de la transaction ne changent pas ; la position est recalculée depuis son registre."),
                                            lrow.id, @tr("Montants en {}", lrow.currency));
                                        Dialog.draft-date = lrow.date;
                                        Dialog.draft-quantity = lrow.quantity;
                                        Dialog.draft-price = lrow.unit-price;
                                        Dialog.draft-fees = lrow.fees;
                                        Dialog.draft-rationale = lrow.rationale;
                                    }
                                }
                                ActionButton {
                                    label: @tr("Supprimer");
                                    enabled: !Holdings.read-only;
                                    clicked => {
                                        // Issue #86: never a one-click irreversible delete.
                                        Dialog.confirm(@tr("Supprimer cette transaction ?"),
                                            @tr("Le coût de revient de la position est recalculé ; cette suppression est définitive."),
                                            @tr("Supprimer définitivement"), "delete-transaction", lrow.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Issue #84 (Story 6.3 defer): « Positions vendues » — the retired holdings, collapsed
            // by default. Each row states the neutral facts (ticker, sold day, currency) and opens its
            // ledger READ-ONLY through the same `ledger-holding-id` mechanism as the register; the one
            // write offered is a re-buy (the record-buy rail), which re-opens the position. ──
            if Holdings.sold-rows.length > 0: PanelCard {
                title: @tr("Positions vendues ({})", Holdings.sold-rows.length);

                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: root.sold-open ? @tr("Masquer") : @tr("Afficher");
                        enabled: true;
                        clicked => { root.sold-open = !root.sold-open; }
                    }
                }
                if root.sold-open: VerticalLayout {
                    spacing: Tokens.space-8;
                    for srow in Holdings.sold-rows: Rectangle {
                        background: Tokens.surface-alt;
                        border-width: Tokens.border;
                        border-color: Tokens.separator;
                        border-radius: Tokens.radius;
                        VerticalLayout {
                            padding: Tokens.space-12;
                            spacing: Tokens.space-8;
                            HorizontalLayout {
                                spacing: Tokens.space-8;
                                Text {
                                    text: @tr("{} — vendue le {}", srow.ticker, srow.sold-date);
                                    color: Tokens.text-high;
                                    font-size: Tokens.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ActionButton {
                                    label: Holdings.ledger-holding-id == srow.id
                                        ? @tr("Masquer les transactions") : @tr("Transactions");
                                    enabled: true;
                                    clicked => {
                                        if (Holdings.ledger-holding-id == srow.id) {
                                            Holdings.close-ledger();
                                        } else {
                                            Holdings.open-ledger(srow.id);
                                        }
                                    }
                                }
                                ActionButton {
                                    label: @tr("Rachat…");
                                    enabled: !Holdings.read-only;
                                    clicked => { root.open-rebuy(srow.id, srow.ticker, srow.currency); }
                                }
                            }
                            if Holdings.ledger-holding-id == srow.id: VerticalLayout {
                                spacing: Tokens.space-8;
                                if Holdings.ledger-rows.length == 0: CaptionLine {
                                    text: @tr("Aucune transaction enregistrée pour cette position.");
                                }
                                // Read-only history (the product decision: lecture + ré-achat only —
                                // editing a retired ledger happens after the position is active again).
                                for lrow in Holdings.ledger-rows: HorizontalLayout {
                                    spacing: Tokens.space-8;
                                    CaptionLine {
                                        text: lrow.date;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: lrow.kind == "buy" ? @tr("Achat")
                                            : lrow.kind == "dividend" ? @tr("Dividende")
                                            : @tr("Vente");
                                        color: Tokens.text-high;
                                        font-size: Tokens.font-caption;
                                        vertical-alignment: center;
                                    }
                                    FactLine {
                                        text: @tr("{} × {} {}", lrow.quantity, lrow.unit-price, lrow.currency);
                                        vertical-alignment: center;
                                    }
                                    CaptionLine {
                                        text: lrow.kind == "dividend"
                                            ? @tr("Retenue : {}", lrow.fees) : @tr("Frais : {}", lrow.fees);
                                        vertical-alignment: center;
                                    }
                                    if lrow.net != "": FactLine {
                                        text: @tr("net {} {}", lrow.net, lrow.currency);
                                        vertical-alignment: center;
                                    }
                                    CaptionLine {
                                        text: lrow.rationale;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
