// Études — the studies dashboard (Story 2.2): create a study (ticker + native currency), see it
// listed (StudySummary rows in deterministic order), and reopen it with full state. Scope is
// list + open only — search/sort/filter/archive/delete is 2.12, the actionable empty state +
// legend is 2.13 (a calm "no studies yet" line is enough here). Story 2.3: reopening a study now
// mounts the faithful collapsible §1–§5 `StudyScreen` (replacing the 2.2 minimal restore view);
// the create flow + list stay here and the form's "‹ Retour" returns to them.
//
// Every colour/size reads `Tokens`; every user-visible string is French inside `@tr()`.

import { Tokens } from "../tokens.slint";
import { Labels, Studies, StudyRow, Confront } from "../state.slint";
import { TextField } from "../components/text_field.slint";
import { ActionButton } from "../components/action_button.slint";
import { ChoiceChip } from "../components/choice_chip.slint";
import { StudyScreen } from "study_screen.slint";

// One list row: ticker + date + status, openable by click or keyboard (Enter/Space). Default
// assistive action reopens the study. Story 2.12 adds lifecycle actions (archive/un-archive/delete)
// as SEPARATE hit targets — the row's primary gesture stays "open", a stray click is never destructive.
component StudyListRow inherits Rectangle {
    in property <StudyRow> entry;
    callback open();
    callback archive();
    callback unarchive();
    callback delete-study();
    callback export-study();
    callback export-study-pdf();
    callback confront-study();

    accessible-role: button;
    accessible-label: root.entry.ticker;
    accessible-action-default => {
        root.open();
    }

    height: Tokens.row-height + Tokens.space-8;
    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.surface-alt : Tokens.surface;
    border-width: fs.has-focus ? Tokens.focus-border : Tokens.border;
    border-color: fs.has-focus ? Tokens.focus : Tokens.separator;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.open();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-12;
        padding-right: Tokens.space-12;
        spacing: Tokens.space-12;

        Text {
            text: root.entry.ticker;
            color: Tokens.text-high;
            font-size: Tokens.font-body;
            font-weight: Tokens.weight-medium;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.entry.created-at;
            color: Tokens.text-mid;
            font-family: Tokens.font-numeric;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
        }
        // Issue #107: the estimated potential (§5 projected total annualized return) — a neutral FACT,
        // no hue, right-aligned tabular figures; "—" when the study withholds it. Also the sort key.
        Text {
            text: root.entry.potential-return;
            color: Tokens.text-mid;
            font-family: Tokens.font-numeric;
            font-size: Tokens.font-caption;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: Tokens.space-48 + Tokens.space-24;
        }
        Text {
            text: root.entry.status;
            color: Tokens.text-low;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
        }
        // ── Story 2.12 — lifecycle actions. These sit on top of the row's TouchArea (declared after
        //    it), so their own TouchAreas consume the click — opening the row needs the ticker area. ──
        if root.entry.status != "archived": ActionButton {
            label: @tr("Archiver");
            clicked => { root.archive(); }
        }
        if root.entry.status == "archived": ActionButton {
            label: @tr("Réactiver");
            clicked => { root.unarchive(); }
        }
        // Story 5.2 (FR59): export this study as a portable file (data contract + schema_version +
        // integrity hash). Its own TouchArea consumes the click, so it never opens the row.
        ActionButton {
            label: @tr("Exporter");
            clicked => { root.export-study(); }
        }
        // Story 5.6 (FR52): export this study's faithful, neutral, greyscale PDF. Its own TouchArea
        // consumes the click, so it never opens the row.
        ActionButton {
            label: @tr("Exporter PDF");
            clicked => { root.export-study-pdf(); }
        }
        // Story 5.1 (FR50): reopen this study's recorded §4 forecast band beside the security's actual
        // close trajectory since the decision. Read-only — its own TouchArea consumes the click.
        ActionButton {
            label: @tr("Confronter");
            clicked => { root.confront-study(); }
        }
        ActionButton {
            label: @tr("Supprimer");
            clicked => { root.delete-study(); }
        }
    }
}

export component DashboardScreen inherits Rectangle {
    // A reopened study mounts the faithful §1–§5 form (Story 2.3); otherwise the list + create flow
    // (2.2). The form's own "‹ Retour" control clears `study-open` to return here.
    if Studies.study-open: StudyScreen { }

    if !Studies.study-open: Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            // One submit path shared by the Créer button and the Enter key in either field. Declared
            // here (not at component root) so it can reach the field ids, which live in this
            // conditional branch. Clear the fields only when a study was actually written — a
            // recoverable refusal keeps the user's input so they can fix it without retyping.
            function submit-create() {
                if (Studies.create-study(ticker.text, currency.text)) {
                    ticker.text = "";
                    currency.text = "";
                    ticker.focus();
                }
            }

            alignment: start;
            padding: Tokens.space-24;
            spacing: Tokens.space-16;

            Text {
                text: @tr("Études");
                color: Tokens.text-high;
                font-size: Tokens.font-h2;
                font-weight: Tokens.weight-semibold;
            }

            // ── Create a study ──
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-8;

                ticker := TextField {
                    placeholder: @tr("Symbole (p. ex. NESN)");
                    width: 220px;
                    accepted => {
                        content.submit-create();
                    }
                }
                currency := TextField {
                    placeholder: @tr("Devise (p. ex. CHF)");
                    width: 140px;
                    accepted => {
                        content.submit-create();
                    }
                }
                create := ActionButton {
                    label: @tr("Créer l'étude");
                    enabled: !Studies.read-only;
                    clicked => {
                        content.submit-create();
                    }
                }
            }

            // ── Neutral banner (errors / read-only / startup notices) ──
            if Studies.notice != "": Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.radius;
                border-width: Tokens.border;
                border-color: Tokens.separator;

                HorizontalLayout {
                    padding: Tokens.space-12;
                    Text {
                        text: Studies.notice;
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Story 2.12 — archive/delete confirmation banner (mirrors the §-screen unlock overlay;
            //    a SEPARATE channel). Fact-stating, NO colour spent; the delete confirm is labeled as
            //    an irreversible removal. Annuler mutates nothing. ──
            if Studies.study-action-confirm-visible: Rectangle {
                background: Tokens.surface;
                border-width: Tokens.focus-border;
                border-color: Tokens.focus;
                border-radius: Tokens.radius;

                HorizontalLayout {
                    padding: Tokens.space-12;
                    spacing: Tokens.space-16;
                    Text {
                        text: Studies.study-action-message;
                        color: Tokens.text-high;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        label: Studies.study-action-destructive ? @tr("Supprimer définitivement") : @tr("Confirmer");
                        clicked => { Studies.confirm-study-action(); }
                    }
                    ActionButton {
                        label: @tr("Annuler");
                        clicked => { Studies.cancel-study-action(); }
                    }
                }
            }

            // ── Story 2.12 — search / sort / filter controls. Shown whenever the journal holds ANY
            //    study (total, before curation) — so a filter that curates to empty (e.g. every study
            //    archived) never strands the user without a way to switch back. Ink only; user search
            //    text is never posture-scanned. ──
            if Studies.study-count > 0: VerticalLayout {
                spacing: Tokens.space-8;

                search := TextField {
                    placeholder: @tr("Rechercher un symbole");
                    width: 260px;
                    // Live filter as the user types; the field owns its text, Rust re-curates `rows`.
                    changed text => { Studies.set-search(self.text); }
                    accepted => { Studies.set-search(self.text); }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    ChoiceChip {
                        label: @tr("Actives");
                        selected: Studies.status-filter == "active";
                        activated => { Studies.set-status-filter("active"); }
                    }
                    ChoiceChip {
                        label: @tr("Archivées");
                        selected: Studies.status-filter == "archived";
                        activated => { Studies.set-status-filter("archived"); }
                    }
                    ChoiceChip {
                        label: @tr("Toutes");
                        selected: Studies.status-filter == "all";
                        activated => { Studies.set-status-filter("all"); }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    ChoiceChip {
                        label: @tr("Tri : date");
                        selected: Studies.sort-key == "date";
                        activated => { Studies.set-sort("date", Studies.sort-descending); }
                    }
                    ChoiceChip {
                        label: @tr("Tri : symbole");
                        selected: Studies.sort-key == "ticker";
                        activated => { Studies.set-sort("ticker", Studies.sort-descending); }
                    }
                    // Issue #107: sort by estimated potential (§5 projected total annualized return),
                    // so the highest-potential candidates surface first (descending default).
                    ChoiceChip {
                        label: @tr("Tri : potentiel");
                        selected: Studies.sort-key == "potential";
                        activated => { Studies.set-sort("potential", Studies.sort-descending); }
                    }
                    ChoiceChip {
                        label: Studies.sort-descending ? @tr("Ordre : décroissant") : @tr("Ordre : croissant");
                        selected: false;
                        activated => { Studies.set-sort(Studies.sort-key, !Studies.sort-descending); }
                    }
                }
            }

            // ── Story 2.13 — actionable empty state (FR58): a truly-empty journal gets a heading +
            //    explanation + a path to the demonstration study; a filtered-to-empty list gets a calm
            //    "no match" line (the controls above stay visible to switch the filter back). ──
            if Studies.study-count == 0: VerticalLayout {
                spacing: Tokens.space-8;
                alignment: start;

                Text {
                    text: @tr("Aucune étude pour le moment.");
                    color: Tokens.text-high;
                    font-size: Tokens.font-h3;
                    font-weight: Tokens.weight-semibold;
                }
                Text {
                    text: @tr("Créez votre première étude avec le champ ci-dessus, ou explorez l'étude de démonstration.");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-body;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: @tr("Charger l'étude de démonstration");
                        clicked => { Studies.load-demo(); }
                    }
                }
            }
            if Studies.study-count > 0 && Studies.rows.length == 0: Text {
                text: @tr("Aucune étude ne correspond au filtre.");
                color: Tokens.text-mid;
                font-size: Tokens.font-body;
            }

            if Studies.rows.length > 0: VerticalLayout {
                spacing: Tokens.space-4;

                for studyrow in Studies.rows: StudyListRow {
                    entry: studyrow;
                    open => {
                        Studies.open-study(studyrow.id);
                    }
                    archive => {
                        Studies.request-study-action("archive", studyrow.id);
                    }
                    unarchive => {
                        Studies.request-study-action("unarchive", studyrow.id);
                    }
                    delete-study => {
                        Studies.request-study-action("delete", studyrow.id);
                    }
                    export-study => {
                        Studies.export-study(studyrow.id);
                    }
                    export-study-pdf => {
                        Studies.export-study-pdf(studyrow.id);
                    }
                    confront-study => {
                        Confront.request(studyrow.id);
                    }
                }
            }

            // ── Story 5.2 (FR59): import a study from a portable export file (path-based — the native
            // file picker is Story 5.5). The envelope's integrity + schema_version are verified before
            // anything is written. ──
            HorizontalLayout {
                spacing: Tokens.space-8;
                import-path := TextField {
                    placeholder: @tr("Chemin du fichier d'étude à importer");
                    horizontal-stretch: 1;
                }
                ActionButton {
                    label: @tr("Importer une étude");
                    enabled: !Studies.read-only && import-path.text != "";
                    clicked => {
                        Studies.import-study(import-path.text);
                        import-path.text = "";
                    }
                }
            }

            Text {
                text: @tr("Méthode : {}", Labels.study-method);
                color: Tokens.text-low;
                font-size: Tokens.font-caption;
            }
        }
    }
}
