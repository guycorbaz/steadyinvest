// Études — the studies dashboard (Story 2.2): create a study (ticker + native currency), see it
// listed (StudySummary rows in deterministic order), and reopen it with full state. Scope is
// list + open only — search/sort/filter/archive/delete is 2.12, the actionable empty state +
// legend is 2.13 (a calm "no studies yet" line is enough here). Story 2.3: reopening a study now
// mounts the faithful collapsible §1–§5 `StudyScreen` (replacing the 2.2 minimal restore view);
// the create flow + list stay here and the form's "‹ Retour" returns to them.
//
// Every colour/size reads `Tokens`; every user-visible string is French inside `@tr()`.

import { Tokens } from "../tokens.slint";
import { Comparison, Dialog, Holdings, Labels, Prefs, Studies, StudyRow, Confront, Drafts } from "../state.slint";
import { TextField } from "../components/text_field.slint";
import { ActionButton } from "../components/action_button.slint";
import { ChoiceChip } from "../components/choice_chip.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBand } from "../components/status_band.slint";
import { StudyScreen } from "study_screen.slint";
import { ComparisonScreen } from "comparison.slint";
import { QuickScreenScreen } from "quick_screen.slint";
import { QuickScreen } from "../state.slint";
import { TextField } from "../components/text_field.slint";
import { Dropdown } from "../components/dropdown.slint";

// One list row: ticker + date + status, openable by click or keyboard (Enter/Space). Default
// assistive action reopens the study. Story 2.12 adds lifecycle actions (archive/un-archive/delete)
// as SEPARATE hit targets — the row's primary gesture stays "open", a stray click is never destructive.
component StudyListRow inherits Rectangle {
    in property <StudyRow> entry;
    callback open();
    callback archive();
    callback unarchive();
    callback delete-study();
    callback export-study();
    callback export-study-pdf();
    callback confront-study();

    // Issue #294: the emoticon's words — its tooltip and its accessible label. The thresholds are
    // the effective Réglages values, spelled in the number format (« 1/3 » as a fraction).
    property <string> mood-text: root.entry.ud-mood == "high" ? @tr("U/D ≥ {} (seuil haut)", Prefs.ud-high-threshold)
        : root.entry.ud-mood == "unbounded" ? @tr("U/D indéfini (∞) : cours au prix bas prévu ou en dessous")
        : root.entry.ud-mood == "middle" ? @tr("U/D entre {} et {} (seuils bas et haut)", Prefs.ud-low-threshold, Prefs.ud-high-threshold)
        : root.entry.ud-mood == "low" ? @tr("U/D < {} (seuil bas)", Prefs.ud-low-threshold)
        : "";
    property <string> mood-tip: root.entry.ud-mood-greyed ? @tr("{} — verdict provisoire, émoticône grisée", root.mood-text) : root.mood-text;

    accessible-role: button;
    accessible-label: root.entry.ticker;
    accessible-action-default => {
        root.open();
    }

    height: Tokens.row-height + Tokens.space-8;
    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.surface-alt : Tokens.surface;
    border-width: fs.has-focus ? Tokens.focus-border : Tokens.border;
    border-color: fs.has-focus ? Tokens.focus : Tokens.separator;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.open();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-12;
        padding-right: Tokens.space-12;
        spacing: Tokens.space-12;

        // Identity column (2026-07-12): fixed width so every row's ticker+name cell is the same
        // size. Ticker in high ink; the user-entered company name follows in muted ink, elided
        // when long. "" name → just the ticker.
        Rectangle {
            width: 360px;
            background: transparent;
            HorizontalLayout {
                spacing: Tokens.space-8;
                alignment: start;
                // Issue #294 (Guy, 2026-10-03): the U/D emoticon beside the ticker — 🙂 at or above
                // the high threshold or an undefined ratio (« ∞ »), 😐 between, 🙁 below the low
                // threshold; nothing where the U/D column reads « — ». Greyed (reduced opacity) when
                // the verdict is provisional. A fixed slot ALWAYS reserved, so the tickers stay
                // aligned whether a row has an emoticon or not. Screen only — never in a PDF.
                mood-slot := Rectangle {
                    width: 22px;
                    background: transparent;
                    Text {
                        text: root.entry.ud-mood == "high" || root.entry.ud-mood == "unbounded" ? "🙂"
                            : root.entry.ud-mood == "middle" ? "😐"
                            : root.entry.ud-mood == "low" ? "🙁"
                            : "";
                        // A renderer that draws the face from a monochrome font uses this ink (a
                        // colour emoji ignores it); the provisional greying is the opacity.
                        color: Tokens.text-high;
                        font-size: Tokens.font-body;
                        opacity: root.entry.ud-mood-greyed ? 0.4 : 1.0;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        accessible-role: text;
                        accessible-label: root.mood-text;
                    }
                    // The tooltip's hover (no Slint tooltip widget): a click still opens the row.
                    mood-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            fs.focus();
                            root.open();
                        }
                    }
                }
                Text {
                    text: root.entry.ticker;
                    color: Tokens.text-high;
                    font-size: Tokens.font-body;
                    font-weight: Tokens.weight-medium;
                    vertical-alignment: center;
                }
                // Story 8.5a (UX spec §5.4): the study's pending AI drafts, « ★ {n} », in ink; while
                // the inbox is unreadable, « ★ ⊘ » on every row — each study's state is unknown,
                // never a vanished marker (G3).
                if Drafts.read-failed || root.entry.pending-drafts > 0: Text {
                    text: Drafts.read-failed ? @tr("{} ⊘", Tokens.ai-glyph)
                        : @tr("{} {}", Tokens.ai-glyph, root.entry.pending-drafts);
                    color: Tokens.text-high;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                }
                Text {
                    text: root.entry.company-name;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        // Fixed-width slot (2026-07-12): a shorter/absent date must never shift the columns after
        // it — the slot is always reserved, only its content varies.
        Rectangle {
            width: 90px;
            background: transparent;
            Text {
                text: root.entry.created-at;
                color: Tokens.text-mid;
                font-family: Tokens.font-numeric;
                font-size: Tokens.font-caption;
                vertical-alignment: center;
            }
        }
        // The present-price zone at a glance — the localized noun (permitted zone nouns, FR13) in
        // the zone's OWN §4 hue (2026-07-12: the text itself carries the same meaning the §4 zone
        // bar does). OUTSIDE the band (« Sous la bande » / « Au-dessus de la bande ») is a distinct
        // honest state in NEUTRAL ink — never a forced buy/sell (the SSG method defines zones only
        // within the band). Fixed-width slot ALWAYS reserved so a study never shifts the columns
        // after it; wide enough for the longest label (« Au-dessus de la bande »).
        Rectangle {
            width: 200px;
            background: transparent;
            Text {
                // FR63 (Guy's on-screen test, 2026-10-01): the zone nouns of the ACTIVE label set
                // (NAIC « Zone d'achat » / neutral « Zone basse »), never hard-coded.
                text: root.entry.zone == "buy" ? Labels.zone-buy
                    : root.entry.zone == "sell" ? Labels.zone-sell
                    : root.entry.zone == "neutral" ? Labels.zone-hold
                    : root.entry.zone == "below" ? @tr("Sous la bande")
                    : root.entry.zone == "above" ? @tr("Au-dessus de la bande")
                    : "";
                color: root.entry.zone == "buy" ? Tokens.zone-buy
                    : root.entry.zone == "sell" ? Tokens.zone-sell
                    : root.entry.zone == "neutral" ? Tokens.zone-hold
                    : Tokens.text-mid;
                font-size: Tokens.font-caption;
                vertical-alignment: center;
            }
        }
        // Issue #107: the estimated potential (§5 projected total annualized return) — a neutral FACT,
        // no hue, right-aligned tabular figures; "—" when the study withholds it. Also the sort key.
        // Fixed-width slot (2026-07-12) so the column aligns across every row.
        Rectangle {
            width: 100px;
            background: transparent;
            Text {
                text: root.entry.potential-return;
                color: Tokens.text-mid;
                font-family: Tokens.font-numeric;
                font-size: Tokens.font-caption;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 100%;
            }
        }
        // Guy's on-screen test (2026-09-30): the upside/downside ratio right after the potential —
        // a neutral FACT like it (no hue, right-aligned tabular figures; « ∞ » when undefined —
        // price ≤ forecast low, Guy 2026-10-03; « — » when unknown or when the verdict is withheld,
        // Guy 2026-10-01). Fixed-width slot so the column aligns across every row. Also the
        // « Tri : U/D » sort key.
        Rectangle {
            width: 80px;
            background: transparent;
            Text {
                text: root.entry.ud-ratio;
                color: Tokens.text-mid;
                font-family: Tokens.font-numeric;
                font-size: Tokens.font-caption;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 100%;
            }
        }
        // Issue #148: a neutral "à compléter" marker when the study still has a MISSING load-bearing
        // input (verdict Withheld) — so an unfinished study is evident from the list, before opening
        // it. NEUTRAL ink only (no hue — the colour budget is the §4 zones). Fixed-width slot ALWAYS
        // reserved (2026-07-12): the text shows only when incomplete, but the column keeps its place
        // so a complete study never shifts the status/actions after it.
        Rectangle {
            width: 110px;
            background: transparent;
            Text {
                text: root.entry.incomplete ? @tr("à compléter") : "";
                color: Tokens.text-mid;
                font-size: Tokens.font-caption;
                font-italic: true;
                vertical-alignment: center;
            }
        }
        // Status — fixed-width slot so the column aligns across rows.
        Rectangle {
            width: 90px;
            background: transparent;
            Text {
                text: root.entry.status;
                color: Tokens.text-low;
                font-size: Tokens.font-caption;
                vertical-alignment: center;
            }
        }
        // Flexible spacer (2026-07-12): absorbs the remaining width so the fixed data columns stay
        // left-aligned as a table and the action cluster sits at the right edge.
        Rectangle { horizontal-stretch: 1; background: transparent; }
        // ── Story 2.12 — lifecycle actions. These sit on top of the row's TouchArea (declared after
        //    it), so their own TouchAreas consume the click — opening the row needs the ticker area. ──
        if root.entry.status != "archived": ActionButton {
            label: @tr("Archiver");
            clicked => { root.archive(); }
        }
        if root.entry.status == "archived": ActionButton {
            label: @tr("Réactiver");
            clicked => { root.unarchive(); }
        }
        // Story 5.2 (FR59): export this study as a portable file (data contract + schema_version +
        // integrity hash). Its own TouchArea consumes the click, so it never opens the row.
        ActionButton {
            label: @tr("Exporter");
            clicked => { root.export-study(); }
        }
        // Story 5.6 (FR52): export this study's faithful, neutral, greyscale PDF. Its own TouchArea
        // consumes the click, so it never opens the row.
        ActionButton {
            label: @tr("Exporter PDF");
            clicked => { root.export-study-pdf(); }
        }
        // Story 5.1 (FR50): reopen this study's recorded §4 forecast band beside the security's actual
        // close trajectory since the decision. Read-only — its own TouchArea consumes the click.
        ActionButton {
            label: @tr("Confronter");
            clicked => { root.confront-study(); }
        }
        ActionButton {
            label: @tr("Supprimer");
            clicked => { root.delete-study(); }
        }
    }

    // Issue #294: the emoticon's tooltip, drawn over the row's own identity column (declared last,
    // so it sits above the ticker and the name) while the pointer rests on the emoticon.
    if mood-touch.has-hover && root.mood-tip != "": Rectangle {
        x: Tokens.space-12 + mood-slot.width + Tokens.space-4;
        y: (root.height - self.height) / 2;
        width: tip.preferred-width + 2 * Tokens.space-8;
        height: tip.preferred-height + 2 * Tokens.space-4;
        background: Tokens.surface-alt;
        border-width: Tokens.border;
        border-color: Tokens.separator;
        border-radius: Tokens.radius;
        tip := Text {
            text: root.mood-tip;
            color: Tokens.text-high;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
        }
    }
}

export component DashboardScreen inherits Rectangle {
    // A reopened study mounts the faithful §1–§5 form (Story 2.3); otherwise the list + create flow
    // (2.2). The form's own "‹ Retour" control clears `study-open` to return here.
    // Story 7.3: the examination sits on top of whatever opened it (the list or a study).
    if Studies.screen-open: QuickScreenScreen { }

    if Studies.study-open && !Studies.screen-open: StudyScreen { }

    // Story 7.1: the comparison table takes the list's place (an open study stays on top).
    if !Studies.study-open && !Studies.screen-open && Studies.compare-open: ComparisonScreen { }

    if !Studies.study-open && !Studies.screen-open && !Studies.compare-open: Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Tokens.space-24;
            spacing: Tokens.space-16;

            Text {
                text: @tr("Études");
                color: Tokens.text-high;
                font-size: Tokens.font-h2;
                font-weight: Tokens.weight-semibold;
            }

            // ── The UX pass (2026-09-23): one titled card; the create form is a Dialog form; the
            //    2.12 archive/delete prompt is a Dialog confirm (Rust parks it); a refusal is
            //    acknowledged in the Dialog; the notice slot keeps outcomes and startup states. ──
            PanelCard {
                title: @tr("Études");
                subtitle: @tr("Une étude par titre, dans la devise de ses chiffres ; la liste s'ouvre d'un clic sur le symbole.");

            // Story 8.5a (UX spec §5.4): AI draft STUDIES waiting — first row of the card; the
            // tickers are listed on the Propositions screen, not here.
            // The card is wider than a 1600 px window (the G6 debt): the action goes under the text.
            if !Drafts.read-failed && Drafts.draft-study-count > 0: StatusBand {
                icon: Tokens.ai-glyph;
                text: @tr("{} proposition(s) d'étude de l'IA en attente.", Drafts.draft-study-count);
                action-label: @tr("Voir les propositions");
                action-below: true;
                action => { Drafts.show-draft-studies(); }
            }
            // G3: an unreadable inbox is SAID here too — nothing vanishes.
            if Drafts.read-failed: StatusBand {
                icon: "⊘";
                text: @tr("Les propositions d'étude n'ont pas pu être lues ; état indisponible.");
                action-label: @tr("Voir les propositions");
                action-below: true;
                action => { Drafts.show-draft-studies(); }
            }

            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-8;
                ActionButton {
                    label: @tr("Créer une étude…");
                    enabled: !Studies.read-only;
                    clicked => {
                        Dialog.form("study-create", @tr("Créer une étude"),
                            @tr("Le symbole est celui du fournisseur de données (p. ex. NESN.SW) ; la devise est celle dans laquelle les chiffres du titre sont publiés."),
                            "", "");
                        // G1 decision 8: no currency prefilled — an explicit pick, never the
                        // reference currency by reflex (the CHF/USD trap of the walk).
                    }
                }
                // FR62 (project review 2026-10-01): the demonstration study stays reachable once the
                // dossier has studies (it was offered only on the empty list); read-only, never
                // stored, never a row of the list.
                if Studies.study-count > 0: ActionButton {
                    label: @tr("Charger l'étude de démonstration");
                    clicked => { Studies.load-demo(); }
                }
            }

            if Studies.notice != "": StatusBand {
                icon: "◦";
                text: Studies.notice;
            }

            // ── Story 2.12 — search / sort / filter controls. Shown whenever the journal holds ANY
            //    study (total, before curation) — so a filter that curates to empty (e.g. every study
            //    archived) never strands the user without a way to switch back. Ink only; user search
            //    text is never posture-scanned. ──
            if Studies.study-count > 0: VerticalLayout {
                spacing: Tokens.space-8;

                search := TextField {
                    placeholder: @tr("Rechercher un symbole");
                    // 300 px: the hint fits whole now that a field no longer grows with its text.
                    width: 300px;
                    // Live filter as the user types; the field owns its text, Rust re-curates `rows`.
                    changed text => { Studies.set-search(self.text); }
                    accepted => { Studies.set-search(self.text); }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    ChoiceChip {
                        label: @tr("Actives");
                        selected: Studies.status-filter == "active";
                        activated => { Studies.set-status-filter("active"); }
                    }
                    ChoiceChip {
                        label: @tr("Archivées");
                        selected: Studies.status-filter == "archived";
                        activated => { Studies.set-status-filter("archived"); }
                    }
                    ChoiceChip {
                        label: @tr("Toutes");
                        selected: Studies.status-filter == "all";
                        activated => { Studies.set-status-filter("all"); }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    ChoiceChip {
                        label: @tr("Tri : date");
                        selected: Studies.sort-key == "date";
                        activated => { Studies.set-sort("date", Studies.sort-descending); }
                    }
                    ChoiceChip {
                        label: @tr("Tri : symbole");
                        selected: Studies.sort-key == "ticker";
                        activated => { Studies.set-sort("ticker", Studies.sort-descending); }
                    }
                    // Issue #107: sort by estimated potential (§5 projected total annualized return),
                    // so the highest-potential candidates surface first (descending default).
                    ChoiceChip {
                        label: @tr("Tri : potentiel");
                        selected: Studies.sort-key == "potential";
                        activated => { Studies.set-sort("potential", Studies.sort-descending); }
                    }
                    // Guy, 2026-10-01: sort by the U/D ratio column (exact decimals); a withheld
                    // verdict or an absent ratio (« — ») sorts last in both orders, as potential.
                    ChoiceChip {
                        label: @tr("Tri : U/D");
                        selected: Studies.sort-key == "ud";
                        activated => { Studies.set-sort("ud", Studies.sort-descending); }
                    }
                    ChoiceChip {
                        label: Studies.sort-descending ? @tr("Ordre : décroissant") : @tr("Ordre : croissant");
                        selected: false;
                        activated => { Studies.set-sort(Studies.sort-key, !Studies.sort-descending); }
                    }
                }
            }

            // ── Story 2.13 — actionable empty state (FR58): a truly-empty journal gets a heading +
            //    explanation + a path to the demonstration study; a filtered-to-empty list gets a calm
            //    "no match" line (the controls above stay visible to switch the filter back). ──
            if Studies.study-count == 0: VerticalLayout {
                spacing: Tokens.space-8;
                alignment: start;

                Text {
                    text: @tr("Aucune étude pour le moment.");
                    color: Tokens.text-high;
                    font-size: Tokens.font-h3;
                    font-weight: Tokens.weight-semibold;
                }
                Text {
                    text: @tr("« Créer une étude… » en commence une, ou explorez l'étude de démonstration.");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-body;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: @tr("Charger l'étude de démonstration");
                        clicked => { Studies.load-demo(); }
                    }
                }
            }
            if Studies.study-count > 0 && Studies.rows.length == 0: Text {
                text: @tr("Aucune étude ne correspond au filtre.");
                color: Tokens.text-mid;
                font-size: Tokens.font-body;
            }

            if Studies.rows.length > 0: VerticalLayout {
                spacing: Tokens.space-4;

                for studyrow in Studies.rows: StudyListRow {
                    entry: studyrow;
                    open => {
                        Studies.open-study(studyrow.id);
                    }
                    archive => {
                        Studies.request-study-action("archive", studyrow.id);
                    }
                    unarchive => {
                        Studies.request-study-action("unarchive", studyrow.id);
                    }
                    delete-study => {
                        Studies.request-study-action("delete", studyrow.id);
                    }
                    export-study => {
                        Studies.export-study(studyrow.id);
                    }
                    export-study-pdf => {
                        Studies.export-study-pdf(studyrow.id);
                    }
                    confront-study => {
                        Confront.request(studyrow.id);
                    }
                }
            }

            }

            // ── Story 7.3: a look before a study — the beginner's check list on a fetched ticker. ──
            PanelCard {
                title: @tr("Examiner un titre");
                subtitle: @tr("La liste de contrôle pour débutant sur un symbole du fournisseur, avant une étude complète ; rien n'est enregistré.");
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    TextField {
                        placeholder: @tr("Symbole, p. ex. NESN.SW");
                        text <=> QuickScreen.pick-ticker;
                        width: 300px;
                        accepted => { QuickScreen.examine(QuickScreen.pick-ticker, QuickScreen.pick-currency); }
                    }
                    Dropdown {
                        options: Holdings.supported-currencies;
                        value <=> QuickScreen.pick-currency;
                        placeholder: @tr("devise");
                        width: 160px;
                    }
                    ActionButton {
                        label: QuickScreen.fetching ? @tr("Examen en cours…") : @tr("Examiner");
                        enabled: !QuickScreen.fetching && QuickScreen.pick-ticker != "" && QuickScreen.pick-currency != "";
                        clicked => { QuickScreen.examine(QuickScreen.pick-ticker, QuickScreen.pick-currency); }
                    }
                }
                // G1 final review: a result that arrived while another screen was open is kept
                // and named here — never lost, never laid over what was open.
                if QuickScreen.ready-ticker != "" && QuickScreen.ready-failure == "": StatusBand {
                    icon: "◦";
                    text: @tr("L'examen de {} est arrivé pendant qu'un autre écran était ouvert ; il est gardé ici.", QuickScreen.ready-ticker);
                }
                if QuickScreen.ready-ticker != "" && QuickScreen.ready-failure == "": HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: @tr("Ouvrir l'examen");
                        clicked => { QuickScreen.open-ready(); }
                    }
                }
                // A failure that arrived meanwhile: named here with its own cause, not in a
                // dialog over what was open.
                if QuickScreen.ready-failure != "": StatusBand {
                    icon: "◦";
                    text: @tr("Examen de {}, demandé pendant qu'un autre écran était ouvert : {}", QuickScreen.ready-ticker, QuickScreen.ready-failure);
                }
                if QuickScreen.ready-failure != "": HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        label: @tr("Compris");
                        clicked => { QuickScreen.dismiss-ready(); }
                    }
                }
            }

            // ── Story 7.1: pick up to five studies to compare side by side (the comparison form). ──
            PanelCard {
                title: @tr("Comparer des études");
                subtitle: @tr("Jusqu'à cinq études côte à côte, sur les trente lignes du formulaire de comparaison ; des faits, jamais un classement.");
                // G1 decision 3 (#237): each list names STUDIES (« TICKER · CUR » when a ticker has
                // several); a pick resolves to its study id in Rust BY INDEX (the dropdown contract)
                // and leaves the other lists.
                if Comparison.choices-unavailable: StatusBand {
                    icon: "◦";
                    text: @tr("La liste des études est indisponible : aucune étude ne peut être choisie pour la comparaison.");
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    Dropdown { options: Comparison.options1; value <=> Comparison.pick1; placeholder: @tr("étude 1"); horizontal-stretch: 1; picked(i) => { Comparison.picked(0, i); } }
                    Dropdown { options: Comparison.options2; value <=> Comparison.pick2; placeholder: @tr("étude 2"); horizontal-stretch: 1; picked(i) => { Comparison.picked(1, i); } }
                    Dropdown { options: Comparison.options3; value <=> Comparison.pick3; placeholder: @tr("étude 3"); horizontal-stretch: 1; picked(i) => { Comparison.picked(2, i); } }
                    Dropdown { options: Comparison.options4; value <=> Comparison.pick4; placeholder: @tr("étude 4"); horizontal-stretch: 1; picked(i) => { Comparison.picked(3, i); } }
                    Dropdown { options: Comparison.options5; value <=> Comparison.pick5; placeholder: @tr("étude 5"); horizontal-stretch: 1; picked(i) => { Comparison.picked(4, i); } }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-8;
                    ActionButton {
                        label: @tr("Comparer");
                        // Two DISTINCT studies (identity, not a count of filled slots).
                        enabled: Comparison.distinct-picks >= 2;
                        clicked => { Studies.compare-open = true; }
                    }
                    ActionButton {
                        label: @tr("Effacer");
                        enabled: Comparison.pick1 != "" || Comparison.pick2 != "" || Comparison.pick3 != "" || Comparison.pick4 != "" || Comparison.pick5 != "";
                        clicked => { Comparison.clear-picks(); }
                    }
                }
            }

            // ── Story 5.2 (FR59): import a study from a portable export file. The native picker runs
            // in Rust (the established `rfd` rail); the envelope's integrity + schema_version are
            // verified before anything is written. Cancel = a silent no-op. ──
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-8;
                ActionButton {
                    label: @tr("Importer une étude…");
                    enabled: !Studies.read-only;
                    clicked => { Studies.pick-and-import-study(); }
                }
            }

            Text {
                text: @tr("Méthode : {}", Labels.study-method);
                color: Tokens.text-low;
                font-size: Tokens.font-caption;
            }
        }
    }
}
