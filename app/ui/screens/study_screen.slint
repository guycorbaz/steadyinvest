// The faithful, collapsible §1–§5 SSG study form (Story 2.3). Replaces the 2.2 minimal restore view:
// a non-collapsible identity header + capitalization block, then five `CollapsibleSection`s in the
// canonical SSG order — §3's A–H lettered P/E table with formula captions on a visible cell grid, the
// §2 management grid, and the §4/§5 calc rows — each foldable with an information-scent summary, on a
// regime-driven fold preset (entry ↔ contemplation) at CONSTANT GEOMETRY.
//
// SCOPE (2.3 = the faithful STRUCTURE only): NO engine/compute, NO verdict, NO zone bar (2.6); NO §1
// interactive chart (2.8); NO data entry (2.4); NO validation markers (2.5). The §1 chart and §4 zone
// bar are explicit faithful PLACEHOLDERS. Computed columns (D/E/G/H) and every result slot show their
// caption only and a faithful em-dash value — NEVER a fake number, NEVER `0`.
//
// All colours/sizes read `Tokens`; every user-visible string is French inside `@tr()` (UX-DR29). The
// formula captions (`A÷C`, …) are static display text, not computed.

import { Tokens } from "../tokens.slint";
import { Studies, FormHeader, PeRow, MgmtRow, Warnings } from "../state.slint";
import { CollapsibleSection } from "../components/collapsible_section.slint";
import { ChoiceChip } from "../components/choice_chip.slint";
import { ActionButton } from "../components/action_button.slint";
import { EditableCell } from "../components/editable_cell.slint";
import { JudgmentField } from "../components/judgment_field.slint";
import { ZoneBar } from "../components/zone_bar.slint";
import { VerdictBar } from "../components/verdict_badge.slint";
import { GrowthChart } from "../components/growth_chart.slint";

// The faithful em-dash slot, in one place (mirrors `viewmodel::form::EMPTY_SLOT`). A gap, never `0`.
global FormConst {
    out property <string> empty-slot: "—";
}

// ── Grid primitives (visible 1 px cell borders, the high-fidelity SSG look) ──

// A data cell: right-aligned tabular figures on a bordered cell.
component GridCell inherits Rectangle {
    in property <string> value;
    in property <bool> emphasise: false;
    min-height: Tokens.row-height;
    horizontal-stretch: 1;
    background: transparent;
    border-width: Tokens.border;
    border-color: Tokens.grid-line;
    HorizontalLayout {
        padding-left: Tokens.space-8;
        padding-right: Tokens.space-8;
        Text {
            text: root.value;
            color: root.emphasise ? Tokens.text-high : Tokens.text-mid;
            font-family: Tokens.font-numeric;
            font-size: Tokens.font-body;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 1;
        }
    }
}

// A left-aligned label cell (row labels, year cells) on the same grid.
component GridLabelCell inherits Rectangle {
    in property <string> label;
    in property <bool> numeric: false;
    min-height: Tokens.row-height;
    horizontal-stretch: 1;
    background: Tokens.surface-alt;
    border-width: Tokens.border;
    border-color: Tokens.grid-line;
    HorizontalLayout {
        padding-left: Tokens.space-8;
        padding-right: Tokens.space-8;
        Text {
            text: root.label;
            color: Tokens.text-mid;
            font-family: root.numeric ? Tokens.font-numeric : Tokens.font-ui;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// A §3 column header: the lettered box (A…H) + its formula/field caption beneath.
component PeHeaderCell inherits Rectangle {
    in property <string> letter;
    in property <string> caption;
    min-height: Tokens.row-height + Tokens.space-12;
    horizontal-stretch: 1;
    background: Tokens.surface-alt;
    border-width: Tokens.border;
    border-color: Tokens.grid-line;
    VerticalLayout {
        padding: Tokens.space-4;
        Text {
            text: root.letter;
            color: Tokens.text-high;
            font-family: Tokens.font-numeric;
            font-size: Tokens.font-body;
            font-weight: Tokens.weight-semibold;
            horizontal-alignment: center;
        }
        Text {
            text: root.caption;
            color: Tokens.text-low;
            font-size: Tokens.font-caption;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// One §3 P/E table data row: year label + the A…H cells. A/B/C/F are editable input cells (Story
// 2.4); D/E/G/H stay caption-only em-dash slots (engine, Story 2.6).
component PeTableRow inherits HorizontalLayout {
    in property <PeRow> pe;
    spacing: 0;
    GridLabelCell { label: root.pe.year; numeric: true; }
    EditableCell { state: root.pe.a; }
    EditableCell { state: root.pe.b; }
    EditableCell { state: root.pe.c; }
    GridCell { value: root.pe.d; }
    GridCell { value: root.pe.e; }
    EditableCell { state: root.pe.f; }
    GridCell { value: root.pe.g; }
    GridCell { value: root.pe.h; }
}

// One §2 management-grid editable raw-input row: a left label + one editable cell per year column.
component MgmtInputRow inherits HorizontalLayout {
    in property <string> label;
    in property <MgmtRow> mgmt;
    spacing: 0;
    GridLabelCell { label: root.label; horizontal-stretch: 2; }
    for cell in root.mgmt.cells: EditableCell { state: cell; }
    GridCell { value: FormConst.empty-slot; } // Moy. 5 ans (computed, 2.6)
    GridCell { value: FormConst.empty-slot; } // Tendance (computed, 2.6)
}

// A §3 summary row: a wide label + a single value slot (Total / Moyenne / PER moyen / PER courant).
component PeSummaryRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 0;
    GridLabelCell { label: root.label; horizontal-stretch: 4; }
    GridCell { value: root.value; horizontal-stretch: 5; }
}

// A §4/§5 calc row: label · formula expression · boxed result slot.
component CalcRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> formula;
    in property <string> result;
    spacing: Tokens.space-8;
    min-height: Tokens.row-height;
    Text {
        text: root.label;
        color: Tokens.text-high;
        font-size: Tokens.font-body;
        vertical-alignment: center;
        horizontal-stretch: 0;
        width: 38%;
        overflow: elide;
    }
    Text {
        text: root.formula;
        color: Tokens.text-low;
        font-size: Tokens.font-caption;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    Rectangle {
        width: 22%;
        border-width: Tokens.border;
        border-color: Tokens.grid-line;
        background: Tokens.surface-alt;
        Text {
            text: root.result;
            color: Tokens.text-mid;
            font-family: Tokens.font-numeric;
            font-size: Tokens.font-body;
            horizontal-alignment: right;
            vertical-alignment: center;
            x: parent.width - self.width - Tokens.space-8;
        }
    }
}


export component StudyScreen inherits Rectangle {
    in property <FormHeader> header: Studies.form-header;
    in property <[PeRow]> pe-rows: Studies.pe-rows;

    background: Tokens.bg;

    VerticalLayout {
        // ── Sticky verdict bar (Story 2.6, AC 5): pinned at the top of the study scroll area, always
        //    visible while scrolling/folding. Derives from the SAME snapshot as the §4 badge/zone bar. ──
        VerdictBar {
            v: Studies.verdict;
            open-traceability => { Studies.open-traceability("verdict"); }
        }
        Rectangle { height: Tokens.border; background: Tokens.separator; }

        Flickable {
        vertical-stretch: 1;
        viewport-height: content.preferred-height;
        // While the §1 judgment endpoint is held, yield the scroll so the vertical drag is not stolen
        // by the form's flick (Story 2.8). The flag flips on the chart handle's pointer down/up.
        interactive: !Studies.judgment-dragging;

        content := VerticalLayout {
            alignment: start;
            padding: Tokens.space-24;
            spacing: Tokens.space-16;

            // ── Back to the studies list (closes the open form; pure-Slint view state) ──
            HorizontalLayout {
                alignment: start;
                ActionButton {
                    label: @tr("‹ Retour aux études");
                    clicked => {
                        Studies.study-open = false;
                        Studies.judgment-dragging = false; // clear any stuck drag flag (review P5)
                    }
                }
            }

            // ── Regime toggle (active regime clearly indicated; label-not-colour, keyboard-operable) ──
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-8;
                Text {
                    text: @tr("Mode de lecture");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                }
                ChoiceChip {
                    label: @tr("Saisie");
                    selected: Studies.regime == "entry";
                    activated => { Studies.set-regime("entry"); }
                }
                ChoiceChip {
                    label: @tr("Contemplation");
                    selected: Studies.regime == "contemplation";
                    activated => { Studies.set-regime("contemplation"); }
                }
            }

            // ── Source revealed on demand (focused cell) + the entry-gesture hints. Provenance is
            //    fact-stating texture, never advice or colour. ──
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-16;
                Text {
                    text: Studies.active-source != "" ? @tr("Source : {}", Studies.active-source) : "";
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                }
                // Story 2.7 — the focused cell's plausibility fact, revealed on demand (mirrors the
                // source caption). Keyboard-reachable (NFR-U2), no animation (AC5). "" hides it.
                Text {
                    text: Studies.active-warning != "" ? @tr("Signalement : {}", Studies.active-warning) : "";
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("Ctrl+V : coller une colonne · Ctrl+Espace : marquer non disponible · Ctrl+Entrée : à revoir / validé");
                    color: Tokens.text-low;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }

            // ── "Unlock all" confirmation overlay (Story 2.5) — the app's FIRST confirm-before-act.
            //    A fact-stating, neutral banner (NO colour spent); Confirmer flips ✓→? in the chosen
            //    scope, Annuler leaves every tag untouched. ──
            if Studies.confirm-visible: Rectangle {
                background: Tokens.surface;
                border-width: Tokens.focus-border;
                border-color: Tokens.focus;
                border-radius: Tokens.radius;

                HorizontalLayout {
                    padding: Tokens.space-12;
                    spacing: Tokens.space-16;
                    Text {
                        text: Studies.confirm-message;
                        color: Tokens.text-high;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        label: @tr("Confirmer");
                        clicked => { Studies.confirm-unlock(); }
                    }
                    ActionButton {
                        label: @tr("Annuler");
                        clicked => { Studies.cancel-unlock(); }
                    }
                }
            }

            // ── "Unlock all" entry points (Story 2.5): study-wide, per-year-column, per-metric-row.
            //    Each turns a saved study into a re-check worklist (flips ✓→? behind the confirmation
            //    above). Keyboard-reachable ActionButtons; fact-stating, posture-gated labels. ──
            Rectangle {
                background: Tokens.surface;
                border-width: Tokens.border;
                border-color: Tokens.separator;
                border-radius: Tokens.radius;

                VerticalLayout {
                    padding: Tokens.space-12;
                    spacing: Tokens.space-8;

                    Text {
                        text: @tr("Retirer les validations");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        font-weight: Tokens.weight-medium;
                    }
                    // Study-wide + per-year-column.
                    HorizontalLayout {
                        spacing: Tokens.space-8;
                        alignment: start;
                        ActionButton {
                            label: @tr("Toute l'étude");
                            clicked => { Studies.request-unlock("study", ""); }
                        }
                        for yh[i] in Studies.year-headers: ActionButton {
                            label: yh;
                            clicked => { Studies.request-unlock("year", "\{i}"); }
                        }
                    }
                    // Per-metric-row (the §3 A/B/C/F columns + the §2 sales/pre-tax/book rows).
                    HorizontalLayout {
                        spacing: Tokens.space-8;
                        alignment: start;
                        ActionButton {
                            label: @tr("Haut");
                            clicked => { Studies.request-unlock("metric", "a"); }
                        }
                        ActionButton {
                            label: @tr("Bas");
                            clicked => { Studies.request-unlock("metric", "b"); }
                        }
                        ActionButton {
                            label: @tr("BPA");
                            clicked => { Studies.request-unlock("metric", "c"); }
                        }
                        ActionButton {
                            label: @tr("Div./action");
                            clicked => { Studies.request-unlock("metric", "f"); }
                        }
                        ActionButton {
                            label: @tr("Ventes");
                            clicked => { Studies.request-unlock("metric", "sales"); }
                        }
                        ActionButton {
                            label: @tr("Bénéfice avant impôt");
                            clicked => { Studies.request-unlock("metric", "pretax"); }
                        }
                        ActionButton {
                            label: @tr("Valeur comptable / action");
                            clicked => { Studies.request-unlock("metric", "book"); }
                        }
                    }
                }
            }

            // ── Non-collapsible header: identity + capitalization block ──
            Rectangle {
                background: Tokens.surface;
                border-width: Tokens.border;
                border-color: Tokens.separator;
                border-radius: Tokens.radius;

                VerticalLayout {
                    padding: Tokens.space-16;
                    spacing: Tokens.space-12;

                    // Identity line: ticker · devise · créée le · méthode.
                    HorizontalLayout {
                        spacing: Tokens.space-16;
                        Text {
                            text: root.header.ticker;
                            color: Tokens.text-high;
                            font-size: Tokens.font-h2;
                            font-weight: Tokens.weight-semibold;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("Devise : {}", root.header.currency);
                                color: Tokens.text-mid;
                                font-size: Tokens.font-caption;
                            }
                            Text {
                                text: @tr("Créée le {}", root.header.created-at);
                                color: Tokens.text-low;
                                font-family: Tokens.font-numeric;
                                font-size: Tokens.font-caption;
                            }
                        }
                        Text {
                            text: @tr("Méthode : {}", root.header.method-version);
                            color: Tokens.text-low;
                            font-family: Tokens.font-numeric;
                            font-size: Tokens.font-caption;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle { height: Tokens.border; background: Tokens.separator; }

                    // Capitalization block (faithful header table region). The contract does not yet
                    // carry these fields, so each value is a faithful empty slot — the BLOCK exists
                    // and is recognizable; it is not populated from non-existent data.
                    Text {
                        text: @tr("Capitalisation");
                        color: Tokens.text-mid;
                        font-size: Tokens.font-caption;
                        font-weight: Tokens.weight-medium;
                    }
                    HorizontalLayout {
                        spacing: 0;
                        GridLabelCell { label: @tr("Actions en circulation"); }
                        GridCell { value: FormConst.empty-slot; }
                        GridLabelCell { label: @tr("Dette à long terme"); }
                        GridCell { value: FormConst.empty-slot; }
                    }
                    HorizontalLayout {
                        spacing: 0;
                        GridLabelCell { label: @tr("Actions privilégiées"); }
                        GridCell { value: FormConst.empty-slot; }
                        GridLabelCell { label: @tr("Valeur comptable / action"); }
                        GridCell { value: FormConst.empty-slot; }
                    }
                }
            }

            // ── §1 — Analyse visuelle (chart is a PLACEHOLDER; 2.8) ──
            CollapsibleSection {
                number: "§1";
                title: @tr("Analyse visuelle des ventes, bénéfices & prix");
                fold-summary: @tr("Croissance BPA est. — · ventes —");
                open: Studies.folds[0];
                toggled(v) => { Studies.toggle-fold(0, v); }

                GrowthChart { }

                // Historical CAGRs — now the engine's (Story 2.6), em-dash when unknown (never 0).
                HorizontalLayout {
                    spacing: 0;
                    GridLabelCell { label: @tr("Croissance des ventes (TCAC)"); }
                    GridCell { value: Studies.growth-computed.sales-cagr; emphasise: true; }
                    GridLabelCell { label: @tr("Croissance du BPA (TCAC)"); }
                    GridCell { value: Studies.growth-computed.eps-cagr; emphasise: true; }
                }
                // Growth & EPS judgment inputs (exact-value entry → persisted → recompute).
                HorizontalLayout {
                    spacing: Tokens.space-16;
                    JudgmentField {
                        label: @tr("Croissance projetée des ventes");
                        field-key: "sales_growth";
                        value: Studies.judgment.sales-growth;
                        suffix: "%";
                    }
                    JudgmentField {
                        label: @tr("Croissance projetée du BPA");
                        field-key: "eps_growth";
                        value: Studies.judgment.eps-growth;
                        suffix: "%";
                    }
                    JudgmentField {
                        label: @tr("BPA estimé haut");
                        field-key: "est_high_eps";
                        value: Studies.judgment.est-high-eps;
                    }
                    JudgmentField {
                        label: @tr("BPA estimé bas");
                        field-key: "est_low_eps";
                        value: Studies.judgment.est-low-eps;
                    }
                }
            }

            // ── §2 — Évaluation de la gestion (management grid) ──
            CollapsibleSection {
                number: "§2";
                title: @tr("Évaluation de la gestion");
                fold-summary: @tr("Marge — · ROE —");
                open: Studies.folds[1];
                toggled(v) => { Studies.toggle-fold(1, v); }

                // Header row: row-label column + the materialized year columns + Moy + Tendance.
                HorizontalLayout {
                    spacing: 0;
                    GridLabelCell { label: @tr("Indicateur"); horizontal-stretch: 2; }
                    for yh in Studies.year-headers: GridLabelCell { label: yh; numeric: true; }
                    GridLabelCell { label: @tr("Moy. 5 ans"); }
                    GridLabelCell { label: @tr("Tendance"); }
                }
                // Editable raw-input rows (sales · pre-tax profit · book value), paired with their
                // label by index — the row order is fixed by `viewmodel/form.rs`.
                MgmtInputRow { label: @tr("Ventes"); mgmt: Studies.mgmt-rows[0]; }
                MgmtInputRow { label: @tr("Bénéfice avant impôt"); mgmt: Studies.mgmt-rows[1]; }
                MgmtInputRow { label: @tr("Valeur comptable / action"); mgmt: Studies.mgmt-rows[2]; }
                // Computed management ratios — now the engine's (Story 2.6). Per-year cells align to
                // the year columns; the empty-study case (no computed values yet) keeps em-dash cells
                // so the grid never misaligns.
                HorizontalLayout {
                    spacing: 0;
                    GridLabelCell { label: @tr("PTP — Bén. av. impôt ÷ ventes"); horizontal-stretch: 2; }
                    if Studies.mgmt-computed.ptp.length > 0: HorizontalLayout {
                        spacing: 0;
                        horizontal-stretch: Studies.year-headers.length;
                        for v in Studies.mgmt-computed.ptp: GridCell { value: v; }
                    }
                    if Studies.mgmt-computed.ptp.length == 0: HorizontalLayout {
                        spacing: 0;
                        horizontal-stretch: Studies.year-headers.length;
                        for yh in Studies.year-headers: GridCell { value: FormConst.empty-slot; }
                    }
                    GridCell { value: Studies.mgmt-computed.avg-ptp; }
                    GridCell { value: Studies.mgmt-computed.ptp-trend; }
                }
                HorizontalLayout {
                    spacing: 0;
                    GridLabelCell { label: @tr("ROE — BPA ÷ valeur comptable/action"); horizontal-stretch: 2; }
                    if Studies.mgmt-computed.roe.length > 0: HorizontalLayout {
                        spacing: 0;
                        horizontal-stretch: Studies.year-headers.length;
                        for v in Studies.mgmt-computed.roe: GridCell { value: v; }
                    }
                    if Studies.mgmt-computed.roe.length == 0: HorizontalLayout {
                        spacing: 0;
                        horizontal-stretch: Studies.year-headers.length;
                        for yh in Studies.year-headers: GridCell { value: FormConst.empty-slot; }
                    }
                    GridCell { value: Studies.mgmt-computed.avg-roe; }
                    GridCell { value: Studies.mgmt-computed.roe-trend; }
                }
            }

            // ── §3 — Historique cours / bénéfices (A–H lettered P/E table) ──
            CollapsibleSection {
                number: "§3";
                title: @tr("Historique cours / bénéfices");
                fold-summary: @tr("PER moy — · courant —");
                open: Studies.folds[2];
                toggled(v) => { Studies.toggle-fold(2, v); }

                // Column header row: Année + lettered boxes A…H with formula/field captions.
                HorizontalLayout {
                    spacing: 0;
                    PeHeaderCell { letter: @tr("Année"); caption: ""; }
                    PeHeaderCell { letter: "A"; caption: @tr("Haut"); }
                    PeHeaderCell { letter: "B"; caption: @tr("Bas"); }
                    PeHeaderCell { letter: "C"; caption: @tr("BPA"); }
                    PeHeaderCell { letter: "D"; caption: "A÷C"; }
                    PeHeaderCell { letter: "E"; caption: "B÷C"; }
                    PeHeaderCell { letter: "F"; caption: @tr("Div./action"); }
                    PeHeaderCell { letter: "G"; caption: "F÷C×100"; }
                    PeHeaderCell { letter: "H"; caption: "F÷B×100"; }
                }
                // Year rows (data-driven; faithful empties until 2.4 fills them).
                for pe in root.pe-rows: PeTableRow { pe: pe; }
                // Summary rows — now the engine's (Story 2.6). "Total"/"Moyenne" aggregate paper
                // columns the single-slot layout can't faithfully render (recorded interpretation —
                // the avg high/low P/E surface via the D/E columns); PER moyen / PER courant are direct.
                PeSummaryRow { label: @tr("PER haut moyen"); value: Studies.pe-computed.avg-high-pe; }
                PeSummaryRow { label: @tr("PER bas moyen"); value: Studies.pe-computed.avg-low-pe; }
                PeSummaryRow { label: @tr("PER moyen"); value: Studies.pe-computed.avg-pe; }
                PeSummaryRow { label: @tr("PER courant"); value: Studies.pe-computed.current-pe; }
                PeSummaryRow { label: @tr("Valeur relative"); value: Studies.pe-computed.relative-value; }

                // The §3 judged-multiple judgment inputs (exact-value entry → persist → recompute).
                HorizontalLayout {
                    spacing: Tokens.space-16;
                    JudgmentField {
                        label: @tr("PER haut moyen jugé");
                        field-key: "high_pe";
                        value: Studies.judgment.high-pe;
                    }
                    JudgmentField {
                        label: @tr("PER bas moyen jugé");
                        field-key: "low_pe";
                        value: Studies.judgment.low-pe;
                    }
                }
            }

            // ── §4 — Évaluation du risque & de la récompense (zone bar is a PLACEHOLDER; 2.6) ──
            CollapsibleSection {
                number: "§4";
                title: @tr("Évaluation du risque & de la récompense — 5 ans");
                fold-summary: @tr("Zone — · H/B —");
                open: Studies.folds[3];
                toggled(v) => { Studies.toggle-fold(3, v); }

                CalcRow { label: @tr("A · Prix haut"); formula: @tr("PER haut moy. × BPA est. haut"); result: Studies.risk-computed.forecast-high; }
                // The four forecast-low options expose only the SELECTED value in v1 (the engine
                // returns one forecast-low); the individual (a)–(d) values stay caption-only em-dash.
                CalcRow { label: @tr("B(a) · PER bas moy. × BPA est. bas"); formula: ""; result: FormConst.empty-slot; }
                CalcRow { label: @tr("B(b) · Prix bas moyen 5 ans"); formula: ""; result: FormConst.empty-slot; }
                CalcRow { label: @tr("B(c) · Plus bas sévère récent"); formula: ""; result: FormConst.empty-slot; }
                CalcRow { label: @tr("B(d) · Soutenu par dividende"); formula: ""; result: FormConst.empty-slot; }
                CalcRow { label: @tr("B · Prix bas prévu (sélectionné)"); formula: ""; result: Studies.risk-computed.forecast-low; }
                CalcRow { label: @tr("D · Ratio hausse/baisse"); formula: ""; result: Studies.risk-computed.ud-ratio; }
                CalcRow { label: @tr("E · Appréciation potentielle"); formula: ""; result: Studies.risk-computed.appreciation; }

                // The four-option forecast-low method selector (keyboard-operable chips).
                Text {
                    text: @tr("Méthode du prix bas prévu");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    font-weight: Tokens.weight-medium;
                }
                HorizontalLayout {
                    spacing: Tokens.space-8;
                    alignment: start;
                    ChoiceChip {
                        label: @tr("PER bas × BPA bas");
                        selected: Studies.judgment.forecast-low-option == "avg_low_pe_times_eps";
                        activated => { Studies.set-forecast-low-option("avg_low_pe_times_eps"); }
                    }
                    ChoiceChip {
                        label: @tr("Prix bas moyen 5 ans");
                        selected: Studies.judgment.forecast-low-option == "avg_low_price_last_5y";
                        activated => { Studies.set-forecast-low-option("avg_low_price_last_5y"); }
                    }
                    ChoiceChip {
                        label: @tr("Plus bas sévère récent");
                        selected: Studies.judgment.forecast-low-option == "recent_severe_low";
                        activated => { Studies.set-forecast-low-option("recent_severe_low"); }
                    }
                    ChoiceChip {
                        label: @tr("Soutenu par dividende");
                        selected: Studies.judgment.forecast-low-option == "dividend_supported";
                        activated => { Studies.set-forecast-low-option("dividend_supported"); }
                    }
                }
                // §4 price/dividend judgment inputs.
                HorizontalLayout {
                    spacing: Tokens.space-16;
                    JudgmentField {
                        label: @tr("Plus bas sévère récent");
                        field-key: "recent_severe_low";
                        value: Studies.judgment.recent-severe-low;
                    }
                    JudgmentField {
                        label: @tr("Prix actuel");
                        field-key: "current_price";
                        value: Studies.judgment.current-price;
                    }
                    JudgmentField {
                        label: @tr("Dividende annuel courant");
                        field-key: "dividend";
                        value: Studies.judgment.dividend;
                    }
                }

                // Story 2.7 — a study-level plausibility finding (low_price_above_current, year-less)
                // anchors here near the forecast-low surface, not a §2/§3 cell. Neutral fact-stating
                // text, silent by default (AC6). "" key → hidden.
                if Studies.section4-warning-key != "": Text {
                    text: @tr("Signalement : {}", Warnings.text(Studies.section4-warning-key));
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    vertical-alignment: center;
                }

                // ── The §4 zone bar (Story 2.6) — the first saturated-colour spend ──
                ZoneBar { bar: Studies.zone-bar; }
            }

            // ── §5 — Potentiel à 5 ans ──
            CollapsibleSection {
                number: "§5";
                title: @tr("Potentiel à 5 ans");
                fold-summary: @tr("Rdt annuel total —");
                open: Studies.folds[4];
                toggled(v) => { Studies.toggle-fold(4, v); }

                CalcRow { label: @tr("Rendement courant"); formula: @tr("div. ÷ prix × 100"); result: Studies.return-computed.present-yield; }
                CalcRow { label: @tr("Rendement moyen 5 ans"); formula: ""; result: Studies.return-computed.avg-yield; }
                CalcRow { label: @tr("Appréciation annualisée"); formula: @tr("appr.% ÷ 5"); result: FormConst.empty-slot; }
                CalcRow { label: @tr("Rendement annuel total"); formula: @tr("appréciation + rendement moyen"); result: Studies.return-computed.total-return; }
            }
        }
        }
    }

    // ── Traceability surface (Story 2.6, AC 7): any result → its inputs, their provenance, and the
    //    rule that produced it. Spends NO colour; the open gates are the honest "why not full". A
    //    pinned overlay (the 2.5 confirm-overlay shape), keyboard-dismissable. ──
    if Studies.trace.visible: Rectangle {
        background: Tokens.bg.with-alpha(0.6);
        TouchArea { clicked => { Studies.close-traceability(); } }
        Rectangle {
            width: Math.min(parent.width - Tokens.space-48, 560px);
            height: Math.min(parent.height - Tokens.space-48, panel.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.surface;
            border-width: Tokens.focus-border;
            border-color: Tokens.focus;
            border-radius: Tokens.radius;

            panel := VerticalLayout {
                padding: Tokens.space-16;
                spacing: Tokens.space-12;

                HorizontalLayout {
                    Text {
                        text: Studies.trace.title;
                        color: Tokens.text-high;
                        font-size: Tokens.font-h3;
                        font-weight: Tokens.weight-semibold;
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        label: @tr("Fermer");
                        clicked => { Studies.close-traceability(); }
                    }
                }

                Text {
                    text: @tr("Entrées & provenance");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    font-weight: Tokens.weight-medium;
                }
                for line in Studies.trace.inputs: Text {
                    text: line;
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                }

                Text {
                    text: @tr("Règle");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    font-weight: Tokens.weight-medium;
                }
                Text {
                    text: Studies.trace.rule;
                    color: Tokens.text-low;
                    font-family: Tokens.font-numeric;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }

                if Studies.trace.open-gates.length > 0: Text {
                    text: @tr("Pourquoi pas complet");
                    color: Tokens.text-mid;
                    font-size: Tokens.font-caption;
                    font-weight: Tokens.weight-medium;
                }
                for gate in Studies.trace.open-gates: Text {
                    text: gate;
                    color: Tokens.text-low;
                    font-size: Tokens.font-caption;
                }
            }
        }
    }
}
