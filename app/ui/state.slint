// UI-side state globals owned by the Rust side (`main.rs` wires the callbacks).
//
// Two strictly independent axes (FR63 / UX-DR29):
//  - `Labels` — the NAIC↔neutral METHOD-VOCABULARY label set: a runtime data table owned by
//    `app/src/labels.rs`, pushed here on startup and on every swap. NOT translations.
//  - the UI language itself lives in `@tr()` source strings (French), compile-time axis.

export global Labels {
    // Resolved display strings for the active label set; `labels.rs` is the single source of
    // truth and pushes values before the window shows (empty defaults are never visible).
    in-out property <string> study-method;
    in-out property <string> zone-buy;
    in-out property <string> zone-hold;
    in-out property <string> zone-sell;
}

// One row of the Studies dashboard list — the indexed columns of `persistence::StudySummary`,
// mapped to display strings by `app/src/viewmodel/studies.rs` (dates/status formatted in Rust,
// never computed in the UI). `id` is the stringified UUID, passed back verbatim on open.
export struct StudyRow {
    id: string,
    ticker: string,
    created-at: string,
    status: string,
}

// One watchlist row (Story 4.1, FR34). `linked` is the authoritative link state (the cell's
// `study_id` is set); `study-link` is the linked study's ticker for display ("" if it does not
// resolve). Built by `app/src/main.rs::refresh_watchlist`.
export struct WatchRow {
    id: string,
    ticker: string,
    linked: bool,
    study-link: string,
    in-buy-zone: bool, // the linked study's current price is in its §4 buy zone (Story 4.2, FR35)
}

// The non-collapsible header identity block of the faithful SSG form (Story 2.3). Every field is an
// already-formatted display string built by `app/src/viewmodel/form.rs` — never a float/Decimal.
export struct FormHeader {
    ticker: string,
    currency: string,
    created-at: string,
    method-version: string,
}

// One data cell's full presentation state (Story 2.4). Money still crosses as an already-formatted
// `value` string (never a float); the rest are enum-derived strings/bools the cell switches its
// texture on — provenance is texture, NEVER colour. `value` is "" for a gap (to-fill / not-available);
// the shouting gap glyph / quiet n-a marker is rendered from `coverage`, not from `value`. The
// `(year-index, field)` pair is the address the edit callbacks pass back. Built by `viewmodel/form.rs`.
export struct GridCellState {
    value: string,        // formatted display for a present cell; "" for a gap
    coverage: string,     // "present" | "to-fill" | "not-available"
    stale: bool,          // freshness == Stale (the ~60% murmur); current is the silent default
    source: string,       // "manuel" | "fournisseur" | "calculé" — revealed on demand; "" when none
    timestamp: string,    // freshness as-of date (YYYY-MM-DD), revealed on demand; "" for a gap (Story 3.3)
    pending: string,      // a divergent provider value preserved alongside a manual one; "" when none (Story 3.4)
    review: string,       // "none" | "to-review" | "validated" — the tri-state trust marker (Story 2.5)
    editable: bool,       // true for a raw input cell; false for a computed/derived slot
    year-index: int,      // row address (0-based, into the materialized year window)
    field: string,        // column address: "a"|"b"|"c"|"f" (§3) | "sales"|"pretax"|"book" (§2)
    // ── Story 2.7 — the plausibility warning channel (FR10 surfacing). A neutral, non-colour
    //    attention glyph (△) distinct from the coverage/stale/review markers; its human-readable
    //    fact is revealed on focus (via `Studies.active-warning`). Silent by default (AC6).
    warning: bool,        // an input-shape / calc-time plausibility finding anchors at this cell
    warning-key: string,  // the PlausibilityKey wire key ("" when none) → `Warnings.text(...)`
}

// One year row of the §3 A–H P/E table. A/B/C/F are editable raw-input cells (Story 2.4); D/E/G/H are
// caption-only (computed by the engine in Story 2.6) and render as faithful em-dash slots — NEVER `0`.
// Built by `viewmodel/form.rs`.
export struct PeRow {
    year: string,
    year-index: int,
    a: GridCellState,
    b: GridCellState,
    c: GridCellState,
    d: string,
    e: string,
    f: GridCellState,
    g: string,
    h: string,
}

// One §2 management-grid raw-input row (Story 2.4): one editable cell per year column. The row order
// is fixed by `viewmodel/form.rs` (sales · pre-tax profit · book value), so the screen pairs each
// with its own `@tr()` label by index — keeping every user-visible label posture-scanned. Each cell
// already carries its own `(year-index, field)` address. Built by `viewmodel/form.rs`.
export struct MgmtRow {
    cells: [GridCellState],
}

// ── Story 2.6 — engine outputs, judgment inputs, the §4 zone bar, the verdict & traceability ──
// Every value below is an already-formatted display string (or a layout float / enum-derived key)
// built by `viewmodel/engine.rs` from ONE `core::verdict::StudySnapshot`. No Decimal / domain enum
// crosses into `.slint` (the adapter rule); `None` outputs render as the em-dash, NEVER `0`.

// The current judgment-input values, surfaced so reopening restores them (locale-formatted; "" for a
// cleared/None input — never "0"). `forecast-low-option` is the selected option key.
export struct JudgmentFields {
    sales-growth: string,
    eps-growth: string,
    est-high-eps: string,
    est-low-eps: string,
    high-pe: string,
    low-pe: string,
    forecast-low-option: string, // "avg_low_pe_times_eps"|"avg_low_price_last_5y"|"recent_severe_low"|"dividend_supported"
    recent-severe-low: string,
    current-price: string,
    dividend: string,
}

// §1 growth computed results (the historical CAGRs; the projected growths are editable inputs).
export struct GrowthComputed {
    sales-cagr: string,
    eps-cagr: string,
}

// ── Story 2.8 — the §1 interactive semi-log growth chart ──
// One 1→200 semi-log axis tick: its decade label + the viewbox-y it sits at.
export struct AxisTick {
    label: string,
    y: float,
}

// The §1 chart geometry, ALL pre-computed in `viewmodel/chart.rs` against a FIXED viewbox
// (`chart-w` × `chart-h` logical units). The series cross as Slint `Path` `commands` strings; the
// Slint `Path` scales the viewbox onto the rendered element, so the only floats here are layout
// coordinates (rendering, NEVER the decision chain — the spike-proven rule). The judgment line is
// the draggable EPS-forecast handle: `judgment-y` is its viewbox-y (`-1` = unset → the line is NOT
// drawn; the chart NEVER auto-places a judgment line, FR33). `available == false` → a calm
// placeholder (no data to plot). No zones live on the §1 chart (UX-DR10) — zones are the §4 bar.
export struct GrowthChartState {
    available: bool,
    chart-w: float,
    chart-h: float,
    sales-commands: string,             // historical, solid
    eps-commands: string,               // historical, solid
    price-commands: string,             // historical (high price), solid
    judgment-commands: string,          // the trend line: last historical EPS (fixed) → forecast endpoint
    fan-commands: [string],             // the 5–30 % growth-guide fan from the last historical EPS
    axis-ticks: [AxisTick],             // 1→200 semi-log decade labels
    judgment-x: float,                  // viewbox-x of the draggable endpoint (the future edge)
    judgment-y: float,                  // viewbox-y of the draggable endpoint; -1 = unset
    judgment-label: string,             // formatted est. high EPS caption ("" when unset)
}

// §2 computed results: per-year PTP%/ROE% (aligned with year-headers), the 5-yr averages + trends.
export struct MgmtComputed {
    ptp: [string],
    roe: [string],
    avg-ptp: string,
    avg-roe: string,
    ptp-trend: string,
    roe-trend: string,
}

// §3 P/E summary results.
export struct PeComputed {
    avg-high-pe: string,
    avg-low-pe: string,
    avg-pe: string,
    current-pe: string,
    relative-value: string,
}

// §4 risk/reward computed results (the zone bands themselves cross via `ZoneBarState`).
export struct RiskComputed {
    forecast-high: string,
    forecast-low: string,
    ud-ratio: string,
    appreciation: string,
}

// §5 five-year-potential computed results.
export struct ReturnComputed {
    present-yield: string,
    avg-yield: string,
    total-return: string,
}

// The §4 zone bar geometry + saturation gate. `available == false` → the calm empty state (no fake
// band). Boundary prices are formatted strings; `marker-pos` is a LAYOUT float (0 = bottom = forecast
// low, 1 = top = forecast high; -1 = no marker). `confidence` is the verdict state — full saturated
// colour ONLY when "full" (AC 6); "provisional" hatches the bands, "withheld" spends no colour.
export struct ZoneBarState {
    available: bool,
    confidence: string,    // "full" | "provisional" | "withheld"
    forecast-low: string,
    buy-top: string,
    neutral-top: string,
    forecast-high: string,
    present-price: string,
    present-zone: string,  // "buy" | "neutral" | "sell" | "" (outside range / unknown)
    marker-pos: float,
}

// ── Story 2.9 — scenario compare (Phase-1, one alternate). The outcome of ONE judgment placement:
//    its §4 forecast boundaries + present-zone, U/D ratio, projected return, and verdict confidence
//    — all already-formatted strings from `engine::scenario_outcome` (two `build_frame` calls). The
//    two placements are differentiated by LABEL/position only (no fourth hue); each scenario's bands
//    still gate on its own `confidence` (full/provisional/withheld).
export struct ScenarioOutcome {
    confidence: string,      // "full" | "provisional" | "withheld"
    forecast-high: string,
    forecast-low: string,
    buy-top: string,
    neutral-top: string,
    present-zone: string,    // "buy" | "neutral" | "sell" | ""
    ud-ratio: string,
    projected-return: string,
}

// The scenario-compare overlay state: the saved (current) placement vs a user-set alternate, shown
// alongside. `alt-input` echoes the alternate est-high-EPS the user typed. NON-committing: closing
// discards the alternate (the saved judgment is never overwritten).
export struct ScenarioCompareState {
    visible: bool,
    alt-input: string,
    current: ScenarioOutcome,
    alternate: ScenarioOutcome,
}

// The verdict badge + sticky-bar facts (all from the SAME snapshot — one coherence frame). `state`
// drives the badge texture; `provenance-date` ("DD/MM") is present only for a degraded verdict;
// `open-gates` names the load-bearing inputs that are not validated-and-fresh (the honest "why not
// full"). Neutral facts — never a buy/sell command.
export struct VerdictState {
    state: string,         // "full" | "provisional" | "withheld" | "" (no study)
    // ── Story 2.7 (AC1) — the FR8 low-confidence reason, carried ON the verdict surface (badge +
    //    sticky bar) so it travels with the verdict wherever it renders. `low-confidence` is true
    //    iff fewer than five usable years exist (never for a Full verdict); `confidence-label` is the
    //    fact-stating reason text ("" when not low-confidence → silent, AC6). Neutral ink, no colour.
    low-confidence: bool,
    confidence-label: string,
    present-price: string,
    projected-return: string,
    appreciation: string,
    ud-ratio: string,
    present-zone: string,  // "buy" | "neutral" | "sell" | ""
    provenance-date: string,
    open-gates: [string],
}

// ── Story 2.7 — neutral plausibility microcopy (FR10 + FR13). One fact-only French string per
//    PlausibilityKey, resolved from the stable wire key. Kept as `@tr()` literals here so the
//    `ui_tr_strings_are_neutral_no_banned_verb` posture gate scans them (AC4). "" for an unknown/
//    empty key — the channel is silent by default.
export global Warnings {
    public pure function text(key: string) -> string {
        return key == "split_series_break" ? @tr("Rupture de série détectée")
            : key == "currency_mismatch" ? @tr("Devise incohérente")
            : key == "fiscal_period_misalignment" ? @tr("Période fiscale non alignée")
            : key == "out_of_bounds_ratio" ? @tr("Valeur hors de la plage attendue")
            : key == "negative_or_zero_denominator" ? @tr("Dénominateur nul ou négatif")
            : key == "low_price_above_current" ? @tr("Prix bas supérieur au prix actuel")
            : "";
    }
}

// The traceability surface for a chosen result (AC 7): the inputs it descends from (+ provenance),
// the rule (method identity + formula), and — for a degraded verdict — the open gates. Spends NO colour.
export struct TraceState {
    visible: bool,
    title: string,
    inputs: [string],
    rule: string,
    open-gates: [string],
}

// Study-state axis (Story 2.2 create → list → reopen; Story 2.3 adds the faithful form + the
// fold/regime view-state). Owned by the Rust side (`main.rs` wires the callbacks against
// `state::JournalState` and `config::AppConfig`); the UI only renders what Rust pushes here.
export global Studies {
    // The current list (deterministic created_at,id order from persistence). Empty = none yet.
    in-out property <[StudyRow]> rows;
    // A neutral, fact-stating banner (errors / read-only / startup notices). Empty = hidden.
    in-out property <string> notice;
    // True when the open journal is read-only (newer-schema file) — creation is refused.
    in-out property <bool> read-only;

    // ── Reopened study → the faithful §1–§5 form (Story 2.3, replaces the 2.2 minimal restore) ──
    // True when a study is open (its form is mounted). False = the dashboard list view.
    in-out property <bool> study-open;
    // The header identity block + the §3 P/E table rows, built by `viewmodel/form.rs`.
    in-out property <FormHeader> form-header;
    in-out property <[PeRow]> pe-rows;
    // ── §2 management grid + the cell-cursor (Story 2.4) ──
    // The year-column header labels for the §2 grid (the materialized year window).
    in-out property <[string]> year-headers;
    // The §2 editable raw-input rows (sales / pre-tax profit / book value per share).
    in-out property <[MgmtRow]> mgmt-rows;
    // The active editing cell (the cell cursor). `active-year == -1` = no active cell. An
    // `EditableCell` focuses itself when it becomes the active cell, so Rust-driven arrow/Enter
    // navigation moves the keyboard focus. NO colour spent — the cursor is a brighter surface + ink
    // ring (the 2.1/Spike-A pattern).
    in-out property <int> active-year: -1;
    in-out property <string> active-field;
    // The focused cell's source, revealed on demand (a section caption shows it) — "" hides it. A
    // gap reveals nothing (only a present cell carries a source). NOT an always-on per-cell badge.
    in-out property <string> active-source;
    // The focused cell's freshness as-of date, revealed on demand beside the source (Story 3.3,
    // FR18) — "" hides it (a gap has no as-of). NOT an always-on per-cell badge.
    in-out property <string> active-timestamp;
    // The focused cell's pending provider divergence, revealed on demand (Story 3.4, FR22) — ""
    // hides it (no divergence). When non-empty, the resolve controls (accept/keep) are offered.
    in-out property <string> active-pending;
    // Resolve a pending divergence on the (year-index, field) cell (Story 3.4, AC4). `accept-provider`
    // takes the provider value; `keep-manual` keeps the manual value and dismisses the pending.
    callback accept-provider(int, string);
    callback keep-manual(int, string);
    // ── Story 2.7 — the focused cell's plausibility fact, revealed on demand (mirrors active-source).
    //    The already-resolved human-readable warning text ("" hides it); set on focus from the cell's
    //    `warning-key` via `Warnings.text(...)`. Keyboard-reachable (NFR-U2), no animation (AC5).
    in-out property <string> active-warning;
    // A study-level (§4 / judgment-area) plausibility finding's wire key — `low_price_above_current`
    // (year-less), anchored near the forecast-low surface, not a §2/§3 cell. "" = none (silent, AC6).
    in-out property <string> section4-warning-key;
    // The active reading regime, "entry" | "contemplation" (mirrored from app-config per study).
    in-out property <string> regime;
    // Per-section open/closed flags §1..§5 (index 0 = §1). Mirrored from app-config per study; the
    // five `CollapsibleSection`s read these and the regime toggle applies a preset.
    in-out property <[bool]> folds;

    // User intents — handled in Rust (validate + persist + refresh).
    // create-study returns true only when a study was actually written, so the UI keeps the
    // user's typed input on a recoverable refusal (blank field / read-only / save failure).
    callback create-study(string, string) -> bool; // ticker, native-currency → written?
    callback open-study(string); // row id (stringified UUID)
    // Fold/regime view-state intents (Story 2.3) — Rust mutates `AppConfig.study_view_state` and
    // persists (validate→mutate→persist, the 2.2 Prefs pattern), then pushes `folds`/`regime` back.
    callback toggle-fold(int, bool); // section index (0..4), open
    callback set-regime(string); // "entry" | "contemplation"

    // ── Manual-entry intents (Story 2.4) — handled in Rust (parse → Cell::edited → put_study →
    //    re-read → re-push). Money is parsed locale-aware in the viewmodel, never in the UI. ──
    // Commit a typed cell: (year-index, field, raw-text) → written? A blank/unparseable text clears
    // the cell to a to-fill gap (never 0). Returns false on a refusal (read-only / save failure).
    callback commit-cell(int, string, string) -> bool;
    // Paste a clipboard column of newline-separated values downward from (year-index, field).
    callback paste-column(int, string);
    // Set/clear not-available-accepted on (year-index, field).
    callback set-not-available(int, string, bool);
    // Move the cell cursor from (year-index, field) in a direction ("up"|"down"|"left"|"right").
    // Rust computes the neighbour and updates `active-year`/`active-field`; the target cell focuses.
    callback cell-move(int, string, string);

    // ── Tri-state review tag + soft-lock + bulk unlock (Story 2.5) — handled in Rust (set review →
    //    put_study → re-read → re-push, the one-source-of-truth shape). The tag crosses as the
    //    enum-derived string "none"|"to-review"|"validated"; never a 0/1/2. ──
    // Set a cell's review tag (year-index, field, target). The cycle none→?→✓→none and the deliberate
    // clear-✓ (✓→?) both call this; the UI computes the target. A review-only change (value untouched).
    callback set-review(int, string, string);
    // The bulk "unlock all" confirmation overlay (the app's first confirm-before-act). `request-unlock`
    // asks Rust to count the ✓ in scope and raise the overlay (scope-kind "study"|"year"|"metric",
    // scope-arg = year index as string / field key / "" for study). Confirm performs the flip; cancel
    // mutates nothing.
    callback request-unlock(string, string); // scope-kind, scope-arg
    callback confirm-unlock();
    callback cancel-unlock();
    // A value edit was attempted on a soft-locked (`✓`) cell — Rust raises the neutral notice (the
    // French string lives in `state.rs`, posture-scanned there). The value is never mutated.
    callback notify-soft-lock();
    // The confirmation overlay state, pushed by Rust: visible flag + the fact-stating "{n} cellule(s)"
    // prompt. NO colour spent on the overlay (neutral surface + ink, like every other notice).
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-message;
    // OS reduced-motion: when true the ✓ draw micro-animation is disabled (AC 1 / AC 7). Mirrored
    // from the platform by `main.rs`; default false (animation on).
    in-out property <bool> reduced-motion;

    // ── Story 2.6 — judgment inputs, engine outputs, the §4 zone bar, the verdict & traceability.
    //    Pushed by `main.rs` from ONE `core::verdict::StudySnapshot` after every data/judgment edit. ──
    // The current judgment-input values (locale-formatted, restored on reopen).
    in-out property <JudgmentFields> judgment;
    // The computed engine results per section (already-formatted strings; "—" for unknown, never 0).
    in-out property <GrowthComputed> growth-computed;
    in-out property <MgmtComputed> mgmt-computed;
    in-out property <PeComputed> pe-computed;
    in-out property <RiskComputed> risk-computed;
    in-out property <ReturnComputed> return-computed;
    // The §4 zone bar + the verdict (badge + sticky bar) + the traceability surface.
    in-out property <ZoneBarState> zone-bar;
    in-out property <VerdictState> verdict;
    in-out property <TraceState> trace;
    // ── Story 2.8 — the §1 interactive growth chart geometry (pre-computed by `viewmodel/chart.rs`).
    in-out property <GrowthChartState> growth-chart;
    // True while the user holds the §1 judgment endpoint — the enclosing form `Flickable` disables its
    // scroll so the vertical drag is not stolen (set on pointer-down, cleared on release).
    in-out property <bool> judgment-dragging;
    // ── Story 2.9 — undo/redo availability (the controls disable when their stack is empty).
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    // ── Story 2.9 — the scenario-compare overlay (current vs one alternate placement).
    in-out property <ScenarioCompareState> scenario-compare;

    // Set a numeric judgment field (field-key, raw-text). Rust parses locale-aware → Money/None
    // (a cleared field is None, never 0), persists to `Study.judgment`, recomputes the snapshot.
    // Field keys: "sales_growth"|"eps_growth"|"est_high_eps"|"est_low_eps"|"high_pe"|"low_pe"|
    // "recent_severe_low"|"current_price"|"dividend".
    callback set-judgment(string, string);
    // Select the §4 forecast-low option (option-key).
    callback set-forecast-low-option(string);
    // Open / close the traceability surface for a result key (v1: "verdict").
    callback open-traceability(string);
    callback close-traceability();

    // ── Story 2.8 — the draggable §1 judgment line. The chart area is a FIXED viewbox so the
    //    TouchArea's `mouse-y` (px) equals the viewbox-y the adapter mapped against. The gesture
    //    writes the SAME `Study.judgment` field as the exact-value `JudgmentField` (FR31, kept in
    //    sync). `drag-start` caches the open study for a journal-free live recompute; `moved` pushes
    //    a live (NON-persisted) recompute frame (<100 ms, NFR-P1); `commit` persists once on release.
    callback judgment-drag-start();
    callback judgment-moved(string, length);  // field-key, viewbox-y
    callback judgment-commit(string, length);  // field-key, viewbox-y → persist (pointer up)
    callback judgment-cancel();                // gesture abandoned → revert to saved, no persist

    // ── Story 2.9 — undo/redo of any judgment or grid edit (snapshot stack). No-op when its stack
    //    is empty; the controls disable on `!can-undo` / `!can-redo`.
    callback undo();
    callback redo();
    // ── Story 2.9 — scenario compare: open (seed alternate = current), set the alternate est-high-EPS
    //    (recompute the alternate outcome, non-committing), and close (discard the alternate).
    callback open-compare();
    callback set-alternate(string);
    callback close-compare();

    // ── Story 2.10 — decision rationale (FR49): a study-level, free-text "why I judged this way"
    //    note. Restored on reopen (pushed by `main.rs` in `push_form`); committed on focus-out via
    //    `set-rationale(text)` (Rust trims → `Some`/`None`, persists atomically, undoable). Plain
    //    text only. The user's own words are NOT posture-scanned — only the label/placeholder are.
    in-out property <string> rationale;
    callback set-rationale(string);

    // ── Story 2.11 — extend the projection (FR3): the annual roll-forward. Appends the next actual
    //    fiscal year as a new ToFill column (`latest_year + 1`); the engine re-bases its canonical
    //    5-year forward projection off the new latest usable year. Atomic + undoable (the 2.10
    //    mutate_study rail). Structural — carries no payload; `main.rs` re-reads + re-renders the grid.
    callback extend-history();

    // ── Story 2.12 — dashboard search / sort / filter + archive (soft) / delete (hard) ──
    // View controls. Rust holds the authoritative view state and re-curates `rows` on each change;
    // these mirror it so the controls render the current selection.
    in-out property <string> search-query;
    in-out property <string> sort-key: "date";       // "date" | "ticker"
    in-out property <bool> sort-descending: true;     // default: most-recent / Z→A first
    in-out property <string> status-filter: "active"; // "active" | "archived" | "all"
    // The TOTAL study count (all statuses, before curation) — so the controls stay reachable even when
    // the current filter curates to an empty list (e.g. every study archived → switch to "Archivées").
    in-out property <int> study-count;
    callback set-search(string);
    callback set-sort(string, bool);                  // key, descending
    callback set-status-filter(string);
    // Lifecycle actions — each routed through a confirm overlay before it acts (the 2.5 unlock
    // pattern): request parks the intent + raises the overlay; confirm performs it; cancel does nothing.
    // action = "archive" | "unarchive" | "delete"; arg = study id (stringified UUID).
    callback request-study-action(string, string);
    callback confirm-study-action();
    callback cancel-study-action();
    // The dashboard confirm overlay state, pushed by Rust — DISTINCT from the study-screen `unlock`
    // overlay (`confirm-visible`/`confirm-message`) so the two never clobber each other. `destructive`
    // is true for delete, so the UI can label the confirm button as an irreversible removal.
    in-out property <bool> study-action-confirm-visible;
    in-out property <string> study-action-message;
    in-out property <bool> study-action-destructive;

    // ── Story 2.13 — the read-only demonstration study (FR62). `load-demo` opens the bundled
    //    worked-example in memory (Rust keeps `current_study` None, so every edit rail no-ops and the
    //    journal is untouched); `demo-active` drives a neutral "lecture seule" banner. "‹ Retour"
    //    clears it (Rust). The demo is never persisted and never appears as a dashboard row.
    callback load-demo();
    in-out property <bool> demo-active;

    // ── Story 3.1 — provider auto-fetch (EODHD). `fetch-provider` runs the off-thread fetch for the
    //    open study (Rust reads the ticker + the STEADYINVEST_EODHD_API_KEY env key); `fetching` drives
    //    a neutral in-progress state (the button disables); the neutral result/cause lands in `notice`.
    //    Reconciliation of existing manual data, staleness and the cause-classified banner are 3.4/3.3/3.5.
    callback fetch-provider();
    in-out property <bool> fetching;
}

// ── Story 2.13 — verify engine (FR9). Rust replays the bundled golden fixtures through
//    `core::golden::check_all` and pushes the report here; the Réglages hub renders it. ──
export struct FixtureLine {
    id: string,
    passed: bool,
    // The deviation lines joined for display, or "" when the fixture passed.
    detail: string,
}

export global Verify {
    in-out property <bool> ran;              // false until the user runs it once (hide results before)
    in-out property <string> method-version;
    in-out property <string> method-fingerprint;
    in-out property <string> summary;        // "11/11 réussies" / "N écart(s)"
    in-out property <bool> all-passed;
    in-out property <[FixtureLine]> results;
    callback run();
}

export global Prefs {
    // Current selections, mirrored from AppConfig by the Rust side.
    in-out property <bool> dark-theme: true;
    in-out property <string> label-set: "naic"; // "naic" | "neutral"
    in-out property <string> number-format: "comma"; // "comma" | "point"
    // Locale-format sample amounts (formatted by viewmodel/format.rs; constants, computed nothing).
    in-out property <string> sample-amount;
    in-out property <string> sample-amount-alt;
    // ── Story 3.2 — Provider / API key (FR25/FR63) ──
    // The selected provider, mirrored from AppConfig.preferred_provider ("eodhd" | "none").
    in-out property <string> provider: "eodhd";
    // Whether a key is currently stored in the OS keychain for the selected provider. The key VALUE
    // is NEVER mirrored to the UI (NFR-S1) — only this boolean status crosses the boundary.
    in-out property <bool> key-configured: false;
    // The latest neutral provider/key notice (save/delete/test outcome), set by the Rust side.
    in-out property <string> provider-status;
    // ── Story 4.3 — reference currency (FR63) ──
    // The single global reference currency the portfolio is read in, mirrored from
    // AppConfig.reference_currency (a 3-letter ISO-4217 code: "CHF" | "EUR" | "USD" | "GBP" | …).
    in-out property <string> reference-currency: "CHF";
    // ── Story 4.5 — default trailing-stop percentage (FR42/FR63 thresholds) ──
    // Mirrored from AppConfig.default_trailing_stop_pct ("" when none); the per-holding set-stop
    // control pre-fills it.
    in-out property <string> default-trailing-stop-pct;
    // User intents — handled in Rust (apply + persist).
    callback theme-selected(string); // "dark" | "light"
    callback label-set-selected(string); // "naic" | "neutral"
    callback number-format-selected(string); // "comma" | "point"
    callback provider-selected(string); // "eodhd" | "none"
    callback reference-currency-selected(string); // "CHF" | "EUR" | "USD" | "GBP" | …
    callback default-trailing-stop-pct-changed(string); // "" clears; else a percent in (0,100)
    // The key travels ONE WAY into Rust as a call argument — never stored in an `in-out` property
    // that could round-trip back out to config/UI (NFR-S1).
    callback key-saved(string);
    callback key-deleted();
    callback key-tested();
}

// The watchlist surface (Story 4.1, FR34). Rows are built/ordered by Rust; intents are handled in
// Rust (persist + re-render). `link-watch` links the entry to a saved study of the same ticker (if
// one exists); `unlink-watch` clears the link.
export global Watchlist {
    in-out property <[WatchRow]> rows;
    in-out property <int> count;
    // How many watched securities are currently in their buy zone (Story 4.2) — the summary alert.
    in-out property <int> in-buy-zone-count;
    in-out property <bool> read-only;
    in-out property <string> notice;
    callback add-watch(string); // ticker
    callback remove-watch(string); // id
    callback move-watch(string, bool); // id, up?
    callback link-watch(string); // id → link to a same-ticker study
    callback unlink-watch(string); // id
}

// One holding in the single portfolio (Story 4.3, FR36). Amounts cross as already-formatted display
// strings (never a float/Decimal); `quantity`/`purchase-price` are the canonical decimal spellings.
export struct HoldingRow {
    id: string,
    ticker: string,
    quantity: string,
    purchase-price: string,
    // Story 4.4 (FR40): the auto-matched study's zone + freshness. `linked` is false when no saved
    // study matches the ticker (neutral "no study" state). `zone` is the key crossed from Rust
    // ("buy"/"neutral"/"sell"/"" — "" shows "—", outside the band or undefined). `current-price` and
    // `as-of` are display strings; `stale` marks a failed/older last refresh.
    linked: bool,
    study-link: string,
    zone: string,
    current-price: string,
    stale: bool,
    as-of: string,
    // Story 4.5 (FR42): the trailing stop. `has-stop` is false when none is set; `stop-pct` /
    // `stop-level` are display strings; `stop-breached` is true when the current price ≤ the stop
    // level (a neutral fact — no action; the sell/raise-stop sheet is Story 4.7).
    has-stop: bool,
    stop-pct: string,
    stop-level: string,
    stop-breached: bool,
    // The current price's margin above the stop level (display string; "" when breached or unknown).
    stop-distance: string,
    // Story 4.7 (FR46/FR47): the neutral trigger this holding fires — "stop" (breached, takes
    // priority), "sell" (in its Sell zone), or "" (none). `dismissed` is true while the user has
    // hidden this trigger's action panel for the session (transient; never persisted).
    trigger-kind: string,
    dismissed: bool,
}

// The single-portfolio holdings register (Story 4.3, FR36). Rows are built/ordered by Rust; intents
// are handled in Rust (validate + persist + re-render). `reference-currency` is the global currency
// the amounts are read in (FR63) — a label only, no conversion in Epic 4.
export global Holdings {
    in-out property <[HoldingRow]> rows;
    in-out property <int> holding-count;
    in-out property <bool> read-only;
    in-out property <string> notice;
    in-out property <string> reference-currency: "CHF";
    // Story 4.4 / issue #52: true while a price refresh is in flight — disables the refresh button
    // so a double-click can't enqueue duplicate jobs. Cleared when the last job's outcome arrives.
    in-out property <bool> refreshing;
    // Story 4.6 (FR43): the portfolio's capital-at-risk figure + its share of invested capital, both
    // already-formatted display strings (the figure is "0.00" at the Price scale when none;
    // `capital-at-risk-pct` is "" when invested=0, else a locale-formatted 1-dp percent).
    in-out property <string> capital-at-risk;
    in-out property <string> capital-at-risk-pct;
    // ticker, quantity, purchase-price → written? (so the form keeps the user's input on refusal)
    callback add-holding(string, string, string) -> bool;
    // id, ticker, quantity, purchase-price → written?
    callback edit-holding(string, string, string, string) -> bool;
    callback remove-holding(string); // id
    // Story 4.4 (FR40): user-initiated price refresh for every linked holding (off the UI thread).
    callback refresh-prices();
    // Story 4.5 (FR42): set/clear a holding's trailing-stop percentage (id, pct — "" clears).
    callback set-trailing-stop(string, string);
    // Story 4.7 (FR46/FR47): record a sell on a neutral trigger (id, rationale — rationale optional);
    // the app never auto-sells. Dismiss hides a trigger's action panel for the session (id).
    callback sell-holding(string, string);
    callback dismiss-trigger(string);
}
