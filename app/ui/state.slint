// UI-side state globals owned by the Rust side (`main.rs` wires the callbacks).
//
// Two strictly independent axes (FR63 / UX-DR29):
//  - `Labels` — the NAIC↔neutral METHOD-VOCABULARY label set: a runtime data table owned by
//    `app/src/labels.rs`, pushed here on startup and on every swap. NOT translations.
//  - the UI language itself lives in `@tr()` source strings (French), compile-time axis.

export global Labels {
    // Resolved display strings for the active label set; `labels.rs` is the single source of
    // truth and pushes values before the window shows (empty defaults are never visible).
    in-out property <string> study-method;
    in-out property <string> zone-buy;
    in-out property <string> zone-hold;
    in-out property <string> zone-sell;
}

// One row of the Studies dashboard list — the indexed columns of `persistence::StudySummary`,
// mapped to display strings by `app/src/viewmodel/studies.rs` (dates/status formatted in Rust,
// never computed in the UI). `id` is the stringified UUID, passed back verbatim on open.
export struct StudyRow {
    id: string,
    ticker: string,
    created-at: string,
    status: string,
    // Issue #107: the estimated potential — the §5 projected total annualized return, already
    // locale-formatted (e.g. "12,5 %"); "—" when the study withholds it. Also the "Potentiel" sort key.
    potential-return: string,
    // Issue #148: the study still has a MISSING load-bearing input (verdict Withheld) — drives a
    // neutral "à compléter" marker so an unfinished study is evident from the list, before opening it.
    // Distinct from the ambiguous "—" potential (a complete study may also withhold its return).
    incomplete: bool,
    // 2026-07-12: the present-price zone key ("buy" | "neutral" | "sell"; "" = unknown/outside the
    // band) — a dot in the zone's own §4 hue + the localized noun on the list row.
    zone: string,
    // 2026-07-12: the user-entered company name shown after the ticker ("" when unset).
    company-name: string,
}

// One watchlist row (Story 4.1, FR34). `linked` is the authoritative link state (the cell's
// `study_id` is set); `study-link` is the linked study's ticker for display ("" if it does not
// resolve). Built by `app/src/main.rs::refresh_watchlist`.
export struct WatchRow {
    id: string,
    ticker: string,
    linked: bool,
    study-link: string,
    in-buy-zone: bool, // the linked study's current price is in its §4 buy zone (Story 4.2, FR35)
    // Issue #48 (FR35): the price sits BELOW the recorded forecast band — a distinct neutral
    // fact (« sous la bande de prévision »), mutually exclusive with `in-buy-zone`.
    below-band: bool,
}

// Story 7.3 (PR 2): one row of the watchlist « criblage » — the examination's facts as already-
// formatted strings and keys (worded under @tr in the card). `state`: pending | done | unavailable
// | quota. No rank, no pass / fail: the reader's objective is not applied here.
export struct ScreeningRow {
    ticker: string,
    state: string,
    years: string,
    sales-rate: string,
    eps-rate: string,
    eps-vs-sales: string,   // eps | sales | same | ""
    pe-position: string,    // higher | similar | lower | ""
    price-vs-high: string,  // signed %, "" = unknown
    has-study: bool,
}

// One stored exchange rate (Story 6.5, FR28): dated + source-aware, BASE → QUOTE (the reference
// currency). `rate` is the exact TEXT spelling; display strings built in Rust.
export struct FxRateRow {
    id: string,        // issue #90: the stored row id — the delete key
    pair: string,      // "EUR → CHF"
    rate: string,
    date: string,      // AAAA-MM-JJ
    source: string,    // "manuel" | provider wire name
    // Issue #90: the QUOTE (target) currency of this stored rate. Rates are stored BASE → reference,
    // so after a reference-currency switch old rows still quote the FORMER reference — the panel
    // marks any row whose `quote != Prefs.reference-currency` as "ancienne référence" (stranded,
    // never used by the current consolidation), and the delete button lets the user prune it.
    quote: string,
}

// Story 6.6 (FR44): one bank's consolidated capital-at-risk line. `amount`/`pct` are formatted
// display strings in the reference currency; `missing` names the absent pair(s) when the bank
// could not consolidate ("" otherwise — then amount shows).
export struct BankCarRow {
    name: string,
    amount: string,
    pct: string,
    missing: string,
    // true = absent for a non-nameable reason (holdings read failure, checked overflow) — the
    // line renders a plain « indisponible », never a dangling empty amount (2026-07-02 review).
    unavailable: bool,
}

// Story 6.7 (FR45): one security's share of the TOTAL invested capital, aggregated across all
// banks and currencies. `amount`/`share` are formatted display strings in the reference currency;
// `flagged` marks a share near/above the configured threshold (a neutral murmur, ink only);
// `missing` names the absent pair(s) when the figure could not convert ("" otherwise).
export struct ConcentrationLine {
    ticker: string,
    amount: string,
    share: string,
    flagged: bool,
    missing: string,
}

// Story 6.7: one size class of the diversify-by-size mix. `class-key` crosses as a key
// ("small" | "medium" | "large" — translated at render, the zone-key pattern); `share` is the
// actual portfolio share ("" when absent), `target` the configured anchor.
export struct SizeMixLine {
    class-key: string,
    share: string,
    target: string,
}

// Story 6.7: one held security that could NOT be classified by size — an honest bucket, never a
// default class. `reason-key` crosses as a key ("no-study" | "no-sales" | "missing-rate" |
// "unconvertible" | "study-unavailable" — issue #95: a failed study read, distinct from a true
// absence); `missing` names the pair for "missing-rate" ("" otherwise).
export struct UnclassifiedLine {
    ticker: string,
    reason-key: string,
    missing: string,
}

// Story 6.8 (FR48): one replacement candidate from the watchlist. Facts only, formatted in Rust
// via the locale path; `data` crosses as a key ("ok" | "insufficient" | "no-study" |
// "study-unavailable" — issue #95: a failed study read, distinct from a true absence); `zone` is
// the engine zone key (Labels nouns at render — no hue, §4 owns the zone colours); the two
// `*-flagged` murmurs use the 6.7 threshold band (an absent share never flags).
export struct CandidateRow {
    ticker: string,
    study-id: string,        // "" when no study resolves
    data: string,
    zone: string,
    in-buy-zone: bool,
    // Issue #48 (FR35): the price sits BELOW the recorded forecast band — the line states this
    // neutral fact instead of « données insuffisantes » (rank unchanged).
    below-band: bool,
    distance: string,        // formatted % above the buy zone ("" inside the zone / unknown)
    ud: string,              // formatted "N:1" ratio ("" when Undefined/Unknown)
    currency: string,
    // Issue #98 (FR48): the candidate's sector ("" = non renseigné — stated, never silent) and
    // its journal-wide invested share, the sector twin of the currency facts below.
    sector: string,
    sector-share: string,    // formatted % ("" when absent)
    sector-flagged: bool,
    sector-missing: string,  // named pair when the sector share is absent for a missing rate
    held-share: string,      // formatted % ("" when not held or absent)
    held-flagged: bool,
    currency-share: string,  // formatted % ("" when absent)
    currency-flagged: bool,
    currency-missing: string, // named pair when the currency share is absent for a missing rate
}

// Story 6.5 (FR28): the FX-rates surface — stored rates + the two acquisition paths (provider
// refresh, user-initiated only; manual entry). NO conversion happens here (consolidation = 6.6).
export global Fx {
    in-out property <[FxRateRow]> rates;
    in-out property <bool> refreshing;
    // Issue #100: the "done / total" progress of the paced batch ("" when idle); shown beside the
    // button so a multi-minute refresh counts up instead of showing a frozen banner.
    in-out property <string> refresh-progress;
    in-out property <string> notice;
    callback refresh-rates();                     // provider fetch for the foreign currencies in use
    callback cancel-refresh();                     // issue #100: drain the in-flight batch
    callback add-rate(string, string, string) -> bool; // base, rate, date ("" = today) → recorded?
    callback delete-rate(string);                  // issue #90: retract a stored rate by id
}

// One entry of the recent-journals list (Story 5.5). `path` is the open key; `name` is a short label;
// `current` marks the journal that is open right now.
export struct RecentJournalRow {
    path: string,
    name: string,
    current: bool,
}

// The non-collapsible header identity block of the faithful SSG form (Story 2.3). Every field is an
// already-formatted display string built by `app/src/viewmodel/form.rs` — never a float/Decimal.
export struct FormHeader {
    ticker: string,
    currency: string,
    created-at: string,
    method-version: string,
    // 2026-07-12: user-entered company name for the header card ("" when unset → placeholder).
    company-name: string,
}

// One data cell's full presentation state (Story 2.4). Money still crosses as an already-formatted
// `value` string (never a float); the rest are enum-derived strings/bools the cell switches its
// texture on — provenance is texture, NEVER colour. `value` is "" for a gap (to-fill / not-available);
// the shouting gap glyph / quiet n-a marker is rendered from `coverage`, not from `value`. The
// `(year-index, field)` pair is the address the edit callbacks pass back. Built by `viewmodel/form.rs`.
export struct GridCellState {
    value: string,        // formatted display for a present cell; "" for a gap
    coverage: string,     // "present" | "to-fill" | "not-available"
    stale: bool,          // freshness == Stale (the ~60% murmur); current is the silent default
    source: string,       // "manuel" | "fournisseur" | "calculé" — revealed on demand; "" when none
    timestamp: string,    // freshness as-of date (YYYY-MM-DD), revealed on demand; "" for a gap (Story 3.3)
    pending: string,      // a divergent provider value preserved alongside a manual one; "" when none (Story 3.4)
    review: string,       // "none" | "to-review" | "validated" — the tri-state trust marker (Story 2.5)
    editable: bool,       // true for a raw input cell; false for a computed/derived slot
    year-index: int,      // row address (0-based, into the materialized year window)
    field: string,        // column address: "a"|"b"|"c"|"f" (§3) | "sales"|"pretax"|"book" (§2)
    // ── Story 2.7 — the plausibility warning channel (FR10 surfacing). A neutral, non-colour
    //    attention glyph (△) distinct from the coverage/stale/review markers; its human-readable
    //    fact is revealed on focus (via `Studies.active-warning`). Silent by default (AC6).
    warning: bool,        // an input-shape / calc-time plausibility finding anchors at this cell
    warning-key: string,  // the PlausibilityKey wire key ("" when none) → `Warnings.text(...)`
}

// One year row of the §3 A–H P/E table. A/B/C/F are editable raw-input cells (Story 2.4); D/E/G/H are
// caption-only (computed by the engine in Story 2.6) and render as faithful em-dash slots — NEVER `0`.
// Built by `viewmodel/form.rs`.
export struct PeRow {
    year: string,
    year-index: int,
    a: GridCellState,
    b: GridCellState,
    c: GridCellState,
    d: string,
    e: string,
    f: GridCellState,
    g: string,
    h: string,
}

// One §2 management-grid raw-input row (Story 2.4): one editable cell per year column. The row order
// is fixed by `viewmodel/form.rs` (sales · pre-tax profit · book value), so the screen pairs each
// with its own `@tr()` label by index — keeping every user-visible label posture-scanned. Each cell
// already carries its own `(year-index, field)` address. Built by `viewmodel/form.rs`.
export struct MgmtRow {
    cells: [GridCellState],
}

// ── Story 2.6 — engine outputs, judgment inputs, the §4 zone bar, the verdict & traceability ──
// Every value below is an already-formatted display string (or a layout float / enum-derived key)
// built by `viewmodel/engine.rs` from ONE `core::verdict::StudySnapshot`. No Decimal / domain enum
// crosses into `.slint` (the adapter rule); `None` outputs render as the em-dash, NEVER `0`.

// The current judgment-input values, surfaced so reopening restores them (locale-formatted; "" for a
// cleared/None input — never "0"). `forecast-low-option` is the selected option key.
export struct JudgmentFields {
    sales-growth: string,
    eps-growth: string,
    est-high-eps: string,
    est-low-eps: string,
    high-pe: string,
    low-pe: string,
    forecast-low-option: string, // "avg_low_pe_times_eps"|"avg_low_price_last_5y"|"recent_severe_low"|"dividend_supported"
    recent-severe-low: string,
    current-price: string,
    dividend: string,
    // Issue #31: `eps-growth` still drives the §5 average-annual-EPS projection even when a direct
    // `est-high-eps` also exists — but the §1 forecast-high LINE (and `est-high-eps` itself) ignores
    // it then (direct wins over derived, `core::ssg::growth::compute`). `true` when BOTH are set, so
    // the §1 field can name this precisely (never blanket "unused" — it stays live for §5).
    eps-growth-shadowed-in-growth-line: bool,
}

// §1 growth computed results (the historical CAGRs; the projected growths are editable inputs).
export struct GrowthComputed {
    sales-cagr: string,
    eps-cagr: string,
}

// Historical values proposed for the EMPTY judgment fields (2026-07-12): the §1 historical CAGRs
// (→ projected sales/EPS growth) and the §3 P/E averages (→ judged avg high/low P/E), formatted;
// "" when unknown (no proposal shown). Adopting one is an EXPLICIT user gesture — the « hist. »
// chip under the field — so the act of adoption IS the judgment (the #23 rail: a judgment is
// validated by the act of entry; nothing is ever prefilled silently).
export struct JudgmentSuggestions {
    sales-growth: string,
    eps-growth: string,
    // Issue #214: the low edge of the §1 least-squares seed band — proposed for « BPA estimé bas »
    // (adopting it is the judgment; the seed alone never flows into §4).
    est-low-eps: string,
    high-pe: string,
    low-pe: string,
    // The lowest low price over the §3 window (core `recent_severe_low_proposal`) — proposed for
    // « Plus bas sévère récent ».
    recent-severe-low: string,
    // Issue #214: the latest year's known dividend per share — proposed for « Dividende annuel
    // courant » (last year's figure, not the current run-rate: the adoption is the judgment).
    dividend: string,
}

// ── Story 2.8 — the §1 interactive semi-log growth chart ──
// One 1→200 semi-log axis tick: its decade label + the viewbox-y it sits at.
export struct AxisTick {
    label: string,
    y: float,
}

// The §1 chart geometry, ALL pre-computed in `viewmodel/chart.rs` against a FIXED viewbox
// (`chart-w` × `chart-h` logical units). The series cross as Slint `Path` `commands` strings; the
// Slint `Path` scales the viewbox onto the rendered element, so the only floats here are layout
// coordinates (rendering, NEVER the decision chain — the spike-proven rule). The judgment line is
// the draggable EPS-forecast handle: `judgment-y` is its viewbox-y (`-1` = unset → the line is NOT
// drawn; the chart NEVER auto-places a judgment line, FR33). `available == false` → a calm
// placeholder (no data to plot). No zones live on the §1 chart (UX-DR10) — zones are the §4 bar.
export struct GrowthChartState {
    available: bool,
    chart-w: float,
    chart-h: float,
    sales-commands: string,             // historical, solid
    eps-commands: string,               // historical, solid
    price-commands: string,             // historical (high price), solid
    judgment-commands: string,          // the est-HIGH trend line: last historical EPS (fixed) → forecast endpoint
    fan-commands: [string],             // the 5–30 % growth-guide fan from the last historical EPS
    axis-ticks: [AxisTick],             // ticks of the EPS scale (issue #25: the labelled scale)
    judgment-x: float,                  // viewbox-x of the draggable endpoint (the future edge)
    judgment-y: float,                  // viewbox-y of the est-HIGH endpoint; -1 = unset
    judgment-label: string,             // formatted est. high EPS caption ("" when unset)
    // Issue #121: est-LOW is a SECOND draggable EPS context (same scale). Only one handle is grabbed
    // at a time (the user picks the context via `Studies.active-judgment`), but BOTH trend lines are
    // always drawn so the judgment is made by LOOKING at the curves.
    judgment-low-commands: string,      // the est-LOW trend line: last historical EPS (fixed) → forecast endpoint
    judgment-low-y: float,              // viewbox-y of the est-LOW endpoint; -1 = unset
    judgment-low-label: string,         // formatted est. low EPS caption ("" when unset)
    // Provenance (issue #121): a line placed by the least-squares SEED (a draggable starting point,
    // NOT a judgment the user made) is drawn dimmed. `false` = the user's own judged value (solid).
    // The seed positions the line only — it never flows into §4/verdict until the user drags (core pure).
    judgment-high-derived: bool,
    judgment-low-derived: bool,
    // Issue #25 (multi-scale): the EPS series' OWN log-scale bounds — the scale the drag operates on
    // (the est-high-EPS handle lives on the EPS scale, so the drag inverse must use these, not a fixed
    // 1→200). Sales/Price are drawn on their own scales (in the commands) but the drag only touches EPS.
    axis-min: float,
    axis-max: float,
}

// ── Issue #115 — the §3 draggable P/E-history chart. The natural extension of the §1 signature
// interaction to §3: the historical per-year high/low P/E cross as `Path` `commands` polylines on a
// LINEAR P/E viewbox (unlike §1's semi-log EPS scale), and the two judged average P/E levels are
// horizontal lines the user DRAGS vertically (high solid, low dashed — same band language as §1).
// A judged level not yet set is SEEDED at the 5-yr historical average (`avg_high/low_pe`) and drawn
// dimmed (`derived`) — a starting point, never a committed judgment until dragged (as §1, FR33). Only
// one handle is grabbed at a time (`active-pe-judgment`); `-1` y = unset. `available == false` → calm.
export struct PeChartState {
    available: bool,
    chart-w: float,
    chart-h: float,
    high-pe-commands: string,           // historical per-year HIGH P/E polyline
    low-pe-commands: string,            // historical per-year LOW P/E polyline
    axis-ticks: [AxisTick],             // ticks of the LINEAR P/E scale
    judged-high-commands: string,       // the judged/seed avg-HIGH-P/E level (full-width horizontal, solid)
    judged-high-y: float,               // viewbox-y of the avg-HIGH-P/E level; -1 = unset
    judged-high-label: string,
    judged-high-derived: bool,          // true = only the seed (5-yr avg), drawn dimmed
    judged-low-commands: string,        // the judged/seed avg-LOW-P/E level (full-width horizontal, dashed)
    judged-low-y: float,                // viewbox-y of the avg-LOW-P/E level; -1 = unset
    judged-low-label: string,
    judged-low-derived: bool,
    axis-min: float,                    // LINEAR P/E scale bounds — the scale the drag inverts against
    axis-max: float,
}

// The confront overlay geometry (Story 5.1) — the recorded §4 forecast band (a shaded rectangle) and
// the security's actual close trajectory since the decision (a polyline), both Path `commands` on a
// shared linear-price viewbox. `available == false` → a neutral empty state.
export struct ConfrontState {
    available: bool,
    // Issue #95: the study READ failed — « étude indisponible », never the « pas encore de
    // cours » empty state a true absence shows.
    unavailable: bool,
    chart-w: float,
    chart-h: float,
    actual-commands: string,            // the actual close trajectory polyline
    band-commands: string,              // the recorded forecast band rectangle
    high-label: string,                 // formatted forecast-high bound
    low-label: string,                  // formatted forecast-low bound
    decision-date: string,
}

// §2 computed results: per-year PTP%/ROE% (aligned with year-headers), the 5-yr averages + trends.
export struct MgmtComputed {
    ptp: [string],
    roe: [string],
    avg-ptp: string,
    avg-roe: string,
    ptp-trend: string,
    roe-trend: string,
}

// §3 P/E summary results.
export struct PeComputed {
    avg-high-pe: string,
    avg-low-pe: string,
    avg-pe: string,
    current-pe: string,
    relative-value: string,
}

// §4 risk/reward computed results (the zone bands themselves cross via `ZoneBarState`).
export struct RiskComputed {
    forecast-high: string,
    forecast-low: string,
    // Issue #213: the four forecast-low candidates (a)–(d), each with its value ("" when unknown)
    // and a reason KEY for the absence ("" | "est_low_eps" | "low_pe" | "low_prices" |
    // "severe_low" | "dividend" | "yield") — the screen turns the key into words.
    low-a: string,
    low-a-why: string,
    low-b: string,
    low-b-why: string,
    low-c: string,
    low-c-why: string,
    low-d: string,
    low-d-why: string,
    ud-ratio: string,
    appreciation: string,
}

// §5 five-year-potential computed results.
export struct ReturnComputed {
    present-yield: string,
    avg-yield: string,
    annualized-appreciation: string,
    total-return: string,
}

// The §4 zone bar geometry + saturation gate. `available == false` → the calm empty state (no fake
// band). Boundary prices are formatted strings; `marker-pos` is a LAYOUT float (0 = bottom = forecast
// low, 1 = top = forecast high; -1 = no marker). `confidence` is the verdict state — full saturated
// colour ONLY when "full" (AC 6); "provisional" hatches the bands, "withheld" spends no colour.
export struct ZoneBarState {
    available: bool,
    confidence: string,    // "full" | "provisional" | "withheld"
    forecast-low: string,
    buy-top: string,
    neutral-top: string,
    forecast-high: string,
    present-price: string,
    present-zone: string,  // "buy" | "neutral" | "sell" | "" (outside range / unknown)
    marker-pos: float,
}

// ── Story 2.9 — scenario compare (Phase-1, one alternate). The outcome of ONE judgment placement:
//    its §4 forecast boundaries + present-zone, U/D ratio, projected return, and verdict confidence
//    — all already-formatted strings from `engine::scenario_outcome` (two `build_frame` calls). The
//    two placements are differentiated by LABEL/position only (no fourth hue); each scenario's bands
//    still gate on its own `confidence` (full/provisional/withheld).
export struct ScenarioOutcome {
    confidence: string,      // "full" | "provisional" | "withheld"
    forecast-high: string,
    forecast-low: string,
    buy-top: string,
    neutral-top: string,
    present-zone: string,    // "buy" | "neutral" | "sell" | ""
    ud-ratio: string,
    projected-return: string,
}

// The scenario-compare overlay state: the saved (current) placement vs a user-set alternate, shown
// alongside. `alt-input` echoes the alternate est-high-EPS the user typed. NON-committing: closing
// discards the alternate (the saved judgment is never overwritten).
export struct ScenarioCompareState {
    visible: bool,
    alt-input: string,
    current: ScenarioOutcome,
    alternate: ScenarioOutcome,
}

// The verdict badge + sticky-bar facts (all from the SAME snapshot — one coherence frame). `state`
// drives the badge texture; `provenance-date` ("DD/MM") is present only for a degraded verdict;
// `open-gates` names the load-bearing inputs that are not validated-and-fresh (the honest "why not
// full"). Neutral facts — never a buy/sell command.
export struct VerdictState {
    state: string,         // "full" | "provisional" | "withheld" | "" (no study)
    // ── Story 2.7 (AC1) — the FR8 low-confidence reason, carried ON the verdict surface (badge +
    //    sticky bar) so it travels with the verdict wherever it renders. `low-confidence` is true
    //    iff fewer than five usable years exist (never for a Full verdict); `confidence-label` is the
    //    fact-stating reason text ("" when not low-confidence → silent, AC6). Neutral ink, no colour.
    low-confidence: bool,
    confidence-label: string,
    present-price: string,
    projected-return: string,
    appreciation: string,
    ud-ratio: string,
    present-zone: string,  // "buy" | "neutral" | "sell" | ""
    provenance-date: string,
    open-gates: [string],
}

// ── Story 2.7 — neutral plausibility microcopy (FR10 + FR13). One fact-only French string per
//    PlausibilityKey, resolved from the stable wire key. Kept as `@tr()` literals here so the
//    `ui_tr_strings_are_neutral_no_banned_verb` posture gate scans them (AC4). "" for an unknown/
//    empty key — the channel is silent by default.
export global Warnings {
    public pure function text(key: string) -> string {
        return key == "split_series_break" ? @tr("Rupture de série détectée")
            : key == "currency_mismatch" ? @tr("Devise incohérente")
            : key == "fiscal_period_misalignment" ? @tr("Période fiscale non alignée")
            : key == "out_of_bounds_ratio" ? @tr("Valeur hors de la plage attendue")
            : key == "negative_or_zero_denominator" ? @tr("Dénominateur nul ou négatif")
            : key == "low_price_above_current" ? @tr("Prix bas supérieur au prix actuel")
            : "";
    }
}

// The traceability surface for a chosen result (AC 7): the inputs it descends from (+ provenance),
// the rule (method identity + formula), and — for a degraded verdict — the open gates. Spends NO colour.
export struct TraceState {
    visible: bool,
    title: string,
    inputs: [string],
    rule: string,
    open-gates: [string],
}

// Study-state axis (Story 2.2 create → list → reopen; Story 2.3 adds the faithful form + the
// fold/regime view-state). Owned by the Rust side (`main.rs` wires the callbacks against
// `state::JournalState` and `config::AppConfig`); the UI only renders what Rust pushes here.
// Issue #34 (FR51, PR 2): one « Historique » timeline entry — newest first; `first-of-day` marks
// the day-header position; `summary` is the Rust-built neutral one-liner (posture-inventoried
// vocabulary; values are data).
export struct HistoryEntryRow {
    id: string,
    day: string,          // AAAA-MM-JJ
    first-of-day: bool,
    time: string,         // HH:MM ("" on a malformed stamp)
    summary: string,
}

export global Studies {
    // The current list (deterministic created_at,id order from persistence). Empty = none yet.
    in-out property <[StudyRow]> rows;
    // A neutral, fact-stating banner (errors / read-only / startup notices). Empty = hidden.
    in-out property <string> notice;
    // True when the open journal is read-only (newer-schema file) — creation is refused.
    in-out property <bool> read-only;

    // ── Reopened study → the faithful §1–§5 form (Story 2.3, replaces the 2.2 minimal restore) ──
    // True when a study is open (its form is mounted). False = the dashboard list view.
    in-out property <bool> study-open;
    // Story 7.1: the comparison table is shown in place of the list (never over an open study).
    in-out property <bool> compare-open;
    // Story 7.3: the « Examen rapide » is shown over the list OR over an open study (its
    // « Retour » lands wherever it was opened from).
    in-out property <bool> screen-open;
    // The header identity block + the §3 P/E table rows, built by `viewmodel/form.rs`.
    in-out property <FormHeader> form-header;
    in-out property <[PeRow]> pe-rows;
    // ── §2 management grid + the cell-cursor (Story 2.4) ──
    // The year-column header labels for the §2 grid (the materialized year window).
    in-out property <[string]> year-headers;
    // The §2 editable raw-input rows (sales / pre-tax profit / book value per share).
    in-out property <[MgmtRow]> mgmt-rows;
    // The active editing cell (the cell cursor). `active-year == -1` = no active cell. An
    // `EditableCell` focuses itself when it becomes the active cell, so Rust-driven arrow/Enter
    // navigation moves the keyboard focus. NO colour spent — the cursor is a brighter surface + ink
    // ring (the 2.1/Spike-A pattern).
    in-out property <int> active-year: -1;
    in-out property <string> active-field;
    // The focused cell's source, revealed on demand (a section caption shows it) — "" hides it. A
    // gap reveals nothing (only a present cell carries a source). NOT an always-on per-cell badge.
    in-out property <string> active-source;
    // The focused cell's freshness as-of date, revealed on demand beside the source (Story 3.3,
    // FR18) — "" hides it (a gap has no as-of). NOT an always-on per-cell badge.
    in-out property <string> active-timestamp;
    // The focused cell's pending provider divergence, revealed on demand (Story 3.4, FR22) — ""
    // hides it (no divergence). When non-empty, the resolve controls (accept/keep) are offered.
    in-out property <string> active-pending;
    // Resolve a pending divergence on the (year-index, field) cell (Story 3.4, AC4). `accept-provider`
    // takes the provider value; `keep-manual` keeps the manual value and dismisses the pending.
    callback accept-provider(int, string);
    callback keep-manual(int, string);
    // ── Story 2.7 — the focused cell's plausibility fact, revealed on demand (mirrors active-source).
    //    The already-resolved human-readable warning text ("" hides it); set on focus from the cell's
    //    `warning-key` via `Warnings.text(...)`. Keyboard-reachable (NFR-U2), no animation (AC5).
    in-out property <string> active-warning;
    // A study-level (§4 / judgment-area) plausibility finding's wire key — `low_price_above_current`
    // (year-less), anchored near the forecast-low surface, not a §2/§3 cell. "" = none (silent, AC6).
    in-out property <string> section4-warning-key;
    // The active reading regime, "entry" | "contemplation" (mirrored from app-config per study).
    in-out property <string> regime;
    // Per-section open/closed flags §1..§5 (index 0 = §1). Mirrored from app-config per study; the
    // five `CollapsibleSection`s read these and the regime toggle applies a preset.
    in-out property <[bool]> folds;

    // User intents — handled in Rust (validate + persist + refresh).
    // create-study returns true only when a study was actually written, so the UI keeps the
    // user's typed input on a recoverable refusal (blank field / read-only / save failure).
    callback create-study(string, string) -> bool; // ticker, native-currency → written?
    callback open-study(string); // row id (stringified UUID)
    // 2026-07-12: rebuild the dashboard rows (per-row §5 potential / « à compléter » / zone) —
    // invoked by the in-form « Retour aux études » button, which flips `study-open` in pure Slint
    // and therefore never passes through `screen-activated`.
    callback list-refresh-requested();
    // Story 5.2 (FR59): export one study to a portable file (id) / import a study from a file path.
    callback export-study(string);
    callback import-study(string);
    callback pick-and-import-study(); // rfd open .json → import-study (the picker runs in Rust)
    // Story 5.6 (FR52): export one study's faithful, neutral, greyscale PDF (id).
    callback export-study-pdf(string);
    // Fold/regime view-state intents (Story 2.3) — Rust mutates `AppConfig.study_view_state` and
    // persists (validate→mutate→persist, the 2.2 Prefs pattern), then pushes `folds`/`regime` back.
    callback toggle-fold(int, bool); // section index (0..4), open
    callback set-regime(string); // "entry" | "contemplation"

    // ── Manual-entry intents (Story 2.4) — handled in Rust (parse → Cell::edited → put_study →
    //    re-read → re-push). Money is parsed locale-aware in the viewmodel, never in the UI. ──
    // Commit a typed cell: (year-index, field, raw-text) → written? A blank/unparseable text clears
    // the cell to a to-fill gap (never 0). Returns false on a refusal (read-only / save failure).
    callback commit-cell(int, string, string) -> bool;
    // Paste a clipboard column of newline-separated values downward from (year-index, field).
    callback paste-column(int, string);
    // Set/clear not-available-accepted on (year-index, field).
    callback set-not-available(int, string, bool);
    // Move the cell cursor from (year-index, field) in a direction ("up"|"down"|"left"|"right").
    // Rust computes the neighbour and updates `active-year`/`active-field`; the target cell focuses.
    callback cell-move(int, string, string);

    // ── Tri-state review tag + soft-lock + bulk unlock (Story 2.5) — handled in Rust (set review →
    //    put_study → re-read → re-push, the one-source-of-truth shape). The tag crosses as the
    //    enum-derived string "none"|"to-review"|"validated"; never a 0/1/2. ──
    // Set a cell's review tag (year-index, field, target). The cycle none→?→✓→none and the deliberate
    // clear-✓ (✓→?) both call this; the UI computes the target. A review-only change (value untouched).
    callback set-review(int, string, string);
    // The bulk "unlock all" confirmation overlay (the app's first confirm-before-act). `request-unlock`
    // asks Rust to count the ✓ in scope and raise the overlay (scope-kind "study"|"year"|"metric",
    // scope-arg = year index as string / field key / "" for study). Confirm performs the flip; cancel
    // mutates nothing.
    callback request-unlock(string, string); // scope-kind, scope-arg
    callback confirm-unlock();
    callback cancel-unlock();
    // A value edit was attempted on a soft-locked (`✓`) cell — Rust raises the neutral notice (the
    // French string lives in `state.rs`, posture-scanned there). The value is never mutated.
    callback notify-soft-lock();
    // The confirmation overlay state, pushed by Rust: visible flag + the fact-stating "{n} cellule(s)"
    // prompt. NO colour spent on the overlay (neutral surface + ink, like every other notice).
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-message;
    // OS reduced-motion: when true the ✓ draw micro-animation is disabled (AC 1 / AC 7). Mirrored
    // from the platform by `main.rs`; default false (animation on).
    in-out property <bool> reduced-motion;

    // ── Story 2.6 — judgment inputs, engine outputs, the §4 zone bar, the verdict & traceability.
    //    Pushed by `main.rs` from ONE `core::verdict::StudySnapshot` after every data/judgment edit. ──
    // The current judgment-input values (locale-formatted, restored on reopen).
    in-out property <JudgmentFields> judgment;
    // The computed engine results per section (already-formatted strings; "—" for unknown, never 0).
    in-out property <GrowthComputed> growth-computed;
    in-out property <MgmtComputed> mgmt-computed;
    in-out property <PeComputed> pe-computed;
    in-out property <RiskComputed> risk-computed;
    in-out property <ReturnComputed> return-computed;
    // The §4 zone bar + the verdict (badge + sticky bar) + the traceability surface.
    in-out property <ZoneBarState> zone-bar;
    in-out property <VerdictState> verdict;
    in-out property <TraceState> trace;
    // Issue #114: the JudgmentField keys of the verdict's open judgment gates (load-bearing inputs
    // still missing). A JudgmentField highlights itself when its key is in this set, so the user sees
    // exactly which inputs to fill; empty for a Full verdict. Pushed alongside the verdict.
    in-out property <[string]> required-fields;
    // Historical values proposed for the empty judgment fields (see JudgmentSuggestions) — pushed
    // from the same coherent frame as the computed §1/§3 results.
    in-out property <JudgmentSuggestions> judgment-suggestions;
    // 2026-07-12: the current price is wildly out of scale vs the historical range (a mis-scaled /
    // stale fetch or wrong symbol) → the §4 field carries an amber « à vérifier » signal so the
    // inflated §4/§5 potential is never taken as fact.
    in-out property <bool> current-price-out-of-scale;
    // ── Story 2.8 — the §1 interactive growth chart geometry (pre-computed by `viewmodel/chart.rs`).
    in-out property <GrowthChartState> growth-chart;
    // True while the user holds the §1 judgment endpoint — the enclosing form `Flickable` disables its
    // scroll so the vertical drag is not stolen (set on pointer-down, cleared on release).
    in-out property <bool> judgment-dragging;
    // Issue #187: true while the pointer HOVERS a chart drag strip. The Flickable captures a gesture
    // at press time, so flipping `judgment-dragging` inside the strip's own pointer-down arrives too
    // late — the scroll has already grabbed the drag. Disabling the Flickable on hover puts it out of
    // the way BEFORE the press. `judgment-dragging` stays load-bearing: it keeps the Flickable off
    // when a live drag wanders outside the strip (hover flips false mid-drag).
    in-out property <bool> judgment-hover;
    // Issue #121: which §1 EPS judgment the single drag handle currently edits — "est_high_eps" or
    // "est_low_eps". The context selector sets it; the chart shows the grip on that line only (all the
    // lines stay drawn). A pure UI selection — it changes nothing until the user actually drags.
    in-out property <string> active-judgment: "est_high_eps";
    // ── Issue #115 — the §3 P/E-history chart geometry + its own active drag context ("high_pe" /
    //    "low_pe"). Separate from the §1 chart: a LINEAR P/E scale, its own draggable judged levels.
    in-out property <PeChartState> pe-chart;
    in-out property <string> active-pe-judgment: "high_pe";
    // ── Story 2.9 — undo/redo availability (the controls disable when their stack is empty).
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    // ── Story 2.9 — the scenario-compare overlay (current vs one alternate placement).
    in-out property <ScenarioCompareState> scenario-compare;

    // Set a numeric judgment field (field-key, raw-text). Rust parses locale-aware → Money/None
    // (a cleared field is None, never 0), persists to `Study.judgment`, recomputes the snapshot.
    // Field keys: "sales_growth"|"eps_growth"|"est_high_eps"|"est_low_eps"|"high_pe"|"low_pe"|
    // "recent_severe_low"|"current_price"|"dividend".
    callback set-judgment(string, string);
    // Select the §4 forecast-low option (option-key).
    callback set-forecast-low-option(string);
    // Open / close the traceability surface for a result key (v1: "verdict").
    callback open-traceability(string);
    callback close-traceability();

    // ── Story 2.8 — the draggable §1 judgment line. The chart area is a FIXED viewbox so the
    //    TouchArea's `mouse-y` (px) equals the viewbox-y the adapter mapped against. The gesture
    //    writes the SAME `Study.judgment` field as the exact-value `JudgmentField` (FR31, kept in
    //    sync). `drag-start` caches the open study for a journal-free live recompute; `moved` pushes
    //    a live (NON-persisted) recompute frame (<100 ms, NFR-P1); `commit` persists once on release.
    callback judgment-drag-start();
    callback judgment-moved(string, length);  // field-key, viewbox-y
    callback judgment-commit(string, length);  // field-key, viewbox-y → persist (pointer up)
    callback judgment-cancel();                // gesture abandoned → revert to saved, no persist
    // Issue #28: the arrow-key equivalent of a whole click-drag-release, atomically (field-key, a
    // signed viewbox-px delta from the current endpoint) — persists immediately, one press = one
    // committed step, no separate uncommitted-drag state to abandon on blur.
    callback judgment-step(string, length);

    // ── Issue #115 — the draggable §3 judged-P/E lines. drag-start / cancel are scale-agnostic (they
    //    only cache / restore the study), so the P/E chart reuses `judgment-drag-start` /
    //    `judgment-cancel`; only move/commit need their own inversion against the LINEAR P/E scale
    //    (`pe-chart.axis-min/max`). Field-keys: "high_pe" | "low_pe" (same rail as the numeric fields).
    callback pe-judgment-moved(string, length);   // field-key, viewbox-y
    callback pe-judgment-commit(string, length);  // field-key, viewbox-y → persist (pointer up)

    // ── Story 2.9 — undo/redo of any judgment or grid edit (snapshot stack). No-op when its stack
    //    is empty; the controls disable on `!can-undo` / `!can-redo`.
    callback undo();
    callback redo();
    // ── Issue #34 (FR51, PR 2) — the durable « Historique » timeline of the open study. Rows are
    //    NEWEST first; `first-of-day` marks where the day header renders; `summary` and the detail
    //    lines are Rust-built neutral French (the verdict-trace precedent — vocabulary inventoried
    //    by the posture gate). `history-unavailable` is a READ FAILURE (the #95 discipline —
    //    « indisponible », never an empty-looking timeline); an EMPTY list on an old study is
    //    honest (its history starts at its next save). One expanded entry at a time
    //    (`history-detail-id`); its lines are computed on demand.
    in-out property <bool> history-open;
    in-out property <bool> history-unavailable;
    in-out property <[HistoryEntryRow]> history-rows;
    in-out property <string> history-detail-id;
    in-out property <[string]> history-detail-lines;
    callback open-history();
    callback close-history();
    callback toggle-history-entry(string); // snapshot id → expand (or collapse if already open)
    // ── Story 2.9 — scenario compare: open (seed alternate = current), set the alternate est-high-EPS
    //    (recompute the alternate outcome, non-committing), and close (discard the alternate).
    callback open-compare();
    callback set-alternate(string);
    callback close-compare();

    // ── Story 2.10 — decision rationale (FR49): a study-level, free-text "why I judged this way"
    //    note. Restored on reopen (pushed by `main.rs` in `push_form`); committed on focus-out via
    //    `set-rationale(text)` (Rust trims → `Some`/`None`, persists atomically, undoable). Plain
    //    text only. The user's own words are NOT posture-scanned — only the label/placeholder are.
    in-out property <string> rationale;
    callback set-rationale(string);
    // 2026-07-12: commit the header card's company name (free text; empty → cleared to absence).
    callback set-company-name(string);

    // ── Story 2.11 — extend the projection (FR3): the annual roll-forward. Appends the next actual
    //    fiscal year as a new ToFill column (`latest_year + 1`); the engine re-bases its canonical
    //    5-year forward projection off the new latest usable year. Atomic + undoable (the 2.10
    //    mutate_study rail). Structural — carries no payload; `main.rs` re-reads + re-renders the grid.
    callback extend-history();

    // ── Story 2.12 — dashboard search / sort / filter + archive (soft) / delete (hard) ──
    // View controls. Rust holds the authoritative view state and re-curates `rows` on each change;
    // these mirror it so the controls render the current selection.
    in-out property <string> search-query;
    in-out property <string> sort-key: "date";       // "date" | "ticker" | "potential"
    in-out property <bool> sort-descending: true;     // default: most-recent / Z→A first
    in-out property <string> status-filter: "active"; // "active" | "archived" | "all"
    // The TOTAL study count (all statuses, before curation) — so the controls stay reachable even when
    // the current filter curates to an empty list (e.g. every study archived → switch to "Archivées").
    in-out property <int> study-count;
    callback set-search(string);
    callback set-sort(string, bool);                  // key, descending
    callback set-status-filter(string);
    // Lifecycle actions — each routed through a confirm overlay before it acts (the 2.5 unlock
    // pattern): request parks the intent + raises the overlay; confirm performs it; cancel does nothing.
    // action = "archive" | "unarchive" | "delete"; arg = study id (stringified UUID).
    callback request-study-action(string, string);
    callback confirm-study-action();
    callback cancel-study-action();
    // The dashboard confirm overlay state, pushed by Rust — DISTINCT from the study-screen `unlock`
    // overlay (`confirm-visible`/`confirm-message`) so the two never clobber each other. `destructive`
    // is true for delete, so the UI can label the confirm button as an irreversible removal.
    in-out property <bool> study-action-confirm-visible;
    in-out property <string> study-action-message;
    in-out property <bool> study-action-destructive;

    // ── Story 2.13 — the read-only demonstration study (FR62). `load-demo` opens the bundled
    //    worked-example in memory (Rust keeps `current_study` None, so every edit rail no-ops and the
    //    journal is untouched); `demo-active` drives a neutral "lecture seule" banner. "‹ Retour"
    //    clears it (Rust). The demo is never persisted and never appears as a dashboard row.
    callback load-demo();
    in-out property <bool> demo-active;

    // ── Story 3.1 — provider auto-fetch (EODHD). `fetch-provider` runs the off-thread fetch for the
    //    open study (Rust reads the ticker + the STEADYINVEST_EODHD_API_KEY env key); `fetching` drives
    //    a neutral in-progress state (the button disables); the neutral result/cause lands in `notice`.
    //    Reconciliation of existing manual data, staleness and the cause-classified banner are 3.4/3.3/3.5.
    callback fetch-provider();
    in-out property <bool> fetching;
}

// ── Story 2.13 — verify engine (FR9). Rust replays the bundled golden fixtures through
//    `core::golden::check_all` and pushes the report here; the Réglages hub renders it. ──
export struct FixtureLine {
    id: string,
    passed: bool,
    // The deviation lines joined for display, or "" when the fixture passed.
    detail: string,
}

export global Verify {
    in-out property <bool> ran;              // false until the user runs it once (hide results before)
    in-out property <string> method-version;
    in-out property <string> method-fingerprint;
    in-out property <string> summary;        // "11/11 réussies" / "N écart(s)"
    in-out property <bool> all-passed;
    in-out property <[FixtureLine]> results;
    callback run();
}

// Issue #38: one key-using provider that still has a stored key while it is NOT the active provider
// — an orphaned secret the panel lists so the user can remove it (incl. while "Aucun" is selected).
export struct StoredKeyRow {
    wire: string,    // "eodhd" | "twelvedata" — the delete-key-for argument + keychain slot
    display: string, // "EODHD" | "Twelve Data"
}

export global Prefs {
    // Current selections, mirrored from AppConfig by the Rust side.
    in-out property <bool> dark-theme: true;
    in-out property <string> label-set: "naic"; // "naic" | "neutral"
    in-out property <string> number-format: "comma"; // "comma" | "point"
    // Locale-format sample amounts (formatted by viewmodel/format.rs; constants, computed nothing).
    in-out property <string> sample-amount;
    in-out property <string> sample-amount-alt;
    // ── Story 3.2 — Provider / API key (FR25/FR63) ──
    // The selected provider, mirrored from AppConfig.preferred_provider ("eodhd" | "none").
    in-out property <string> provider: "eodhd";
    // Whether a key is currently stored in the OS keychain for the selected provider. The key VALUE
    // is NEVER mirrored to the UI (NFR-S1) — only this boolean status crosses the boundary.
    in-out property <bool> key-configured: false;
    // Issue #44 (F10): true when the store is locked/unavailable so key presence is UNKNOWN — the
    // status line says "indéterminé" rather than a false "aucune clé configurée".
    in-out property <bool> key-status-unknown: false;
    // The latest neutral provider/key notice (save/delete/test outcome), set by the Rust side.
    in-out property <string> provider-status;
    // Issue #40: true while a key-test worker job is in flight — the provider-panel buttons gate on
    // this so a double-click can't stack duplicate test jobs. Latched by Rust on a successful send,
    // cleared when the TestKey outcome returns.
    in-out property <bool> key-testing: false;
    // Issue #38: key-using providers that still hold a stored key while NOT active (orphaned secrets),
    // mirrored from the keychain by Rust — the panel lists them with a per-row delete so a key is
    // removable even when the active provider is "Aucun" (NFR-S1: secret only as long as needed).
    in-out property <[StoredKeyRow]> orphan-keys;
    // ── Story 4.3 — reference currency (FR63) ──
    // The single global reference currency the portfolio is read in, mirrored from
    // AppConfig.reference_currency (a 3-letter ISO-4217 code: "CHF" | "EUR" | "USD" | "GBP" | …).
    in-out property <string> reference-currency: "CHF";
    // ── Story 4.5 — default trailing-stop percentage (FR42/FR63 thresholds) ──
    // Mirrored from AppConfig.default_trailing_stop_pct ("" when none); the per-holding set-stop
    // control pre-fills it.
    in-out property <string> default-trailing-stop-pct;
    // Story 6.4 (FR41): the default dividend withholding rate in percent (mirrors
    // AppConfig.withholding_rate_pct_or_default — always a value, 35 = CH impôt anticipé).
    in-out property <string> withholding-rate-pct;
    // ── Story 6.7 (FR45) — concentration threshold + the diversify-by-size table, mirrored from
    //    the validated AppConfig accessors (always effective values, defaults when unset). The
    //    commits are validated in Rust; a refusal names itself in `risk-settings-status` and
    //    writes nothing (the table commits whole or not at all). ──
    in-out property <string> concentration-threshold-pct;
    in-out property <string> size-small-max;
    in-out property <string> size-medium-max;
    in-out property <string> size-target-small-pct;
    in-out property <string> size-target-medium-pct;
    in-out property <string> size-target-large-pct;
    in-out property <string> risk-settings-status;
    // ── Story 6.9 (FR26) — the per-field-type FALLBACK providers, mirrored from the validated
    //    config accessors (wire strings; "" = no fallback). The PRIMARY stays `provider` above.
    //    The fundamentals row never offers Twelve Data (declared capability: no fundamentals). ──
    in-out property <string> price-fallback;
    in-out property <string> fundamentals-fallback;
    in-out property <string> fx-fallback;
    // field key ("price" | "fundamentals" | "fx"), provider wire ("" clears the fallback)
    callback fallback-provider-selected(string, string);
    callback concentration-threshold-pct-changed(string); // "" resets to the default (50)
    // small-max, medium-max, target-small, target-medium, target-large ("" = that field's default)
    callback size-table-changed(string, string, string, string, string);
    // ── Story 5.3 — whole-journal export / import (FR60) ──
    // The latest neutral outcome of an export/import (with counts on a successful import), set by Rust.
    in-out property <string> journal-status;
    // The path to import a whole-journal envelope from (path-based; the native picker is Story 5.5).
    in-out property <string> journal-import-path;
    // User intents — handled in Rust (export reads the journal; import verifies + applies atomically).
    callback export-journal();
    callback import-journal(string); // path to a whole-journal envelope file
    callback pick-and-import-journal(); // rfd open .json → import-journal (the picker runs in Rust)
    // Issue #65: the arbitration prompt for an OLDER same-journal import ("" = no banner) — the
    // version regression is stated and explicitly confirmed, never merged silently.
    in-out property <string> import-confirm;
    callback confirm-import();
    callback cancel-import();
    // ── Story 5.4 — backup / restore of the raw .db (FR61) ──
    // Latest neutral backup/restore outcome (set by Rust).
    in-out property <string> restore-status;
    // The confirm prompt for a parked restore — non-empty reveals the confirm banner (the backup's
    // (journal_id, version) + stale/foreign warning). A restore is never applied silently.
    in-out property <string> restore-confirm;
    callback create-backup();
    callback request-restore(string); // path to a backup .db → validate + (maybe) park for confirm
    callback pick-and-restore-backup(); // rfd open .db → request-restore (the picker runs in Rust)
    callback confirm-restore();
    callback cancel-restore();
    // ── Story 5.5 — journal location, recent journals & sync-safety (FR66) ──
    // The current journal's path (display) + the recent-journals list, set by Rust.
    in-out property <string> journal-current-path;
    in-out property <[RecentJournalRow]> recent-journals;
    // The latest neutral location outcome (opened / created / failed / sync-warning / stale), set by Rust.
    in-out property <string> journal-location-status;
    // When non-empty, a stale-lock blocked an open: the path that can be reclaimed (offer a button).
    in-out property <string> journal-reclaim-path;
    // User intents — native dialogs + the rails run in Rust.
    callback pick-and-open-journal();   // rfd open .db → open_journal
    callback pick-and-create-journal(); // rfd save .db → create_journal
    callback open-recent(string);       // path → open_journal
    callback reclaim-and-open(string);  // path → clear a stale lock + open
    // User intents — handled in Rust (apply + persist).
    callback theme-selected(string); // "dark" | "light"
    callback label-set-selected(string); // "naic" | "neutral"
    callback number-format-selected(string); // "comma" | "point"
    callback provider-selected(string); // "eodhd" | "none"
    callback reference-currency-selected(string); // "CHF" | "EUR" | "USD" | "GBP" | …
    callback default-trailing-stop-pct-changed(string); // "" clears; else a percent in (0,100)
    callback withholding-rate-pct-changed(string); // "" resets to 35; else a percent in [0,100]
    // The key travels ONE WAY into Rust as a call argument — never stored in an `in-out` property
    // that could round-trip back out to config/UI (NFR-S1). Issue #41: `key-saved` returns whether a
    // save actually happened, so the field is cleared ONLY on a real save (a blank/failed save keeps
    // the field + shows a neutral notice, never a silent field-clear read as success).
    callback key-saved(string) -> bool;
    callback key-deleted();
    callback key-tested();
    callback delete-key-for(string); // issue #38: remove the orphaned key of a non-active provider (wire)
}

// The watchlist surface (Story 4.1, FR34). Rows are built/ordered by Rust; intents are handled in
// Rust (persist + re-render). `link-watch` links the entry to a saved study of the same ticker (if
// one exists); `unlink-watch` clears the link.
export global Watchlist {
    in-out property <[WatchRow]> rows;
    in-out property <int> count;
    // How many watched securities are currently in their buy zone (Story 4.2) — the summary alert.
    in-out property <int> in-buy-zone-count;
    in-out property <bool> read-only;
    in-out property <string> notice;
    callback add-watch(string) -> bool; // ticker → written? (a dialog closes only then)
    callback remove-watch(string); // id
    callback move-watch(string, bool); // id, up?
    callback link-watch(string); // id → link to a same-ticker study
    callback unlink-watch(string); // id
    // Story 7.3 (PR 2) — the criblage: the run's rows (the watchlist's order at launch), its
    // progress, whether the usage limit stopped it.
    in-out property <[ScreeningRow]> screening-rows;
    in-out property <bool> screening-shown;
    in-out property <bool> screening-running;
    in-out property <int> screening-done;
    in-out property <int> screening-total;
    in-out property <bool> screening-quota;
    callback screen-list();
    callback open-screening(int); // row index → the full examination
    callback close-screening();
}

// The confront overlay (Story 5.1, FR50): reopen a saved study to compare its recorded §4 forecast
// band against the security's actual close trajectory since the decision. Read-only — never mutates.
export global Confront {
    in-out property <bool> open: false;          // is the overlay showing?
    in-out property <ConfrontState> state;       // the geometry to draw (or an empty state)
    callback request(string);                     // study id → host computes the ConfrontState
    callback dismiss();
}

// One holding in the single portfolio (Story 4.3, FR36). Amounts cross as already-formatted display
// strings (never a float/Decimal); `quantity`/`purchase-price` are the canonical decimal spellings.
// One portfolio in the selector (Story 6.1, FR37) — "one per bank/account". `id` is the stringified
// UUID, `name` the user's label. The active one is `Holdings.active-portfolio-id`.
// ── The modal dialog (the UX pass, 2026-09-23) — ONE overlay, three variants, driven by pure
//    Slint state that Rust also reaches (`wiring::dialog::refuse`). The routing rule: a REFUSAL
//    (the user acted, the write did not happen, the cause is named) is a `notice` the user
//    acknowledges; a destructive gesture is a `confirm`; every data entry/edit is a `form` with a
//    title, one explanatory sentence and labelled fields. A persistent STATE is never a dialog
//    (StatusBand); an OUTCOME (« … a été enregistré. ») stays an inline notice (F4 slot rule). ──
export global Dialog {
    in-out property <string> kind;        // "" (hidden) | "notice" | "confirm" | "form"
    in-out property <string> title;       // "" on a notice = the default « Action refusée »
    in-out property <string> body;        // the message (notice/confirm) or the explanatory sentence (form)
    in-out property <string> form-id;     // which form the overlay mounts (see ModalDialog)
    in-out property <string> action;      // confirm: what the verb does (ModalDialog dispatches)
    in-out property <string> verb;        // confirm: the destructive verb's label
    in-out property <string> target-id;   // the holding / transaction / portfolio the form or verb acts on
    in-out property <string> context;     // a fact shown under the sentence (the amounts' currency, a linked study…)
    in-out property <string> field-error; // a refusal raised BY the open form (kept inline, next to the fields)
    in-out property <bool> flag;          // form-specific (stop: the holding already has a stop)
    // The form drafts — one set, reset on every open.
    in-out property <string> draft-ticker;
    in-out property <string> draft-quantity;
    in-out property <string> draft-price;
    in-out property <string> draft-fees;
    in-out property <string> draft-date;
    in-out property <string> draft-rationale;
    in-out property <string> draft-currency;
    in-out property <string> draft-sector;
    in-out property <string> draft-name;

    public function close() {
        self.kind = "";
        self.form-id = "";
        self.action = "";
        self.field-error = "";
    }
    public function notice(message: string) {
        self.title = "";
        self.body = message;
        self.kind = "notice";
    }
    public function confirm(title: string, body: string, verb: string, action: string, target: string) {
        self.title = title;
        self.body = body;
        self.verb = verb;
        self.action = action;
        self.target-id = target;
        self.kind = "confirm";
    }
    public function form(id: string, title: string, body: string, target: string, context: string) {
        self.draft-ticker = "";
        self.draft-quantity = "";
        self.draft-price = "";
        self.draft-fees = "";
        self.draft-date = "";
        self.draft-rationale = "";
        self.draft-currency = "";
        self.draft-sector = "";
        self.draft-name = "";
        self.flag = false;
        self.field-error = "";
        self.form-id = id;
        self.title = title;
        self.body = body;
        self.target-id = target;
        self.context = context;
        self.kind = "form";
    }
}

// ── Story 7.2 — the portfolio health review (« Revue »): a read-only roll-up of the whole
//    dossier, pushed by Rust on activation. Facts only — words and glyphs, no hue, no ranking.
//    Keys (never prose) cross the boundary: study state, zone, data state, reasons; the screen
//    turns them into @tr words. ──
export struct ReviewShareRow {
    label: string,     // a sector / currency / bank / ticker, or a size key small|medium|large ("" = non renseigné)
    amount: string,
    share: string,
    target: string,
    missing: string,   // the missing pair blocking the figure ("EUR → CHF"), "" when none
    reason: string,    // "" | no_study | study_unavailable | no_sales | unconvertible (an unclassified size row)
    flagged: bool,
}
export struct ReviewPositionRow {
    ticker: string,
    study-id: string,
    name: string,
    banks: string,
    currency: string,
    invested: string,
    share: string,
    missing: string,        // the missing pair(s) blocking the invested figure
    study: string,          // full | provisional | withheld | none | unavailable
    other-currency: string, // a same-ticker study in ANOTHER currency (study == none)
    low-confidence: bool,
    zone: string,           // buy | neutral | sell | below | above | ""
    price: string,
    ud: string,
    relative: string,
    flags: string,          // the flags worded by Rust (inventory), joined; "" = none
    flag-count: int,
    stale: bool,
    as-of: string,
    stop: string,
    stop-breached: bool,
    trigger: string,        // stop | sell | ""
    last-saved: string,
    due: bool,
}
export struct ReviewDueRow {
    ticker: string,
    study-id: string,
    date: string,
    reason: string,         // age | withheld | low_confidence
}
export global Review {
    in-out property <bool> unavailable;
    in-out property <string> dossier;
    in-out property <string> date;
    in-out property <string> reference-currency;
    in-out property <int> bank-count;
    in-out property <string> rates;
    in-out property <[ReviewShareRow]> size-rows;
    in-out property <[ReviewShareRow]> unclassified-rows;
    in-out property <bool> sectors-unavailable;
    in-out property <[ReviewShareRow]> sector-rows;
    in-out property <bool> currencies-unavailable;
    in-out property <[ReviewShareRow]> currency-rows;
    in-out property <[ReviewShareRow]> bank-rows;
    in-out property <string> global-invested;
    in-out property <string> global-missing;
    in-out property <[ReviewShareRow]> concentration-rows;
    in-out property <string> concentration-missing;
    in-out property <bool> concentration-unavailable;
    in-out property <string> threshold;
    in-out property <[ReviewPositionRow]> positions;
    in-out property <[ReviewDueRow]> due;
    in-out property <int> count-positions;
    in-out property <int> count-linked;
    in-out property <int> count-full;
    in-out property <int> count-provisional;
    in-out property <int> count-withheld;
    in-out property <int> count-flagged;
    in-out property <int> count-high-zone;
    in-out property <int> count-stop-breached;
    in-out property <int> count-due;
    in-out property <string> notice;   // the export outcome (F4 slot)
    callback export-pdf();
    callback open-study(string);       // study id → Études + open
    callback go-to-portfolio();
}

// ── Story 7.1 — the company comparison: up to five studies as columns, the comparison form's
//    thirty rows. `cells` is row-major (row 1 first), `cells[(row − 1) × column-count + col]`;
//    rows 20 and 28 come from the column's `zone` / `state` keys (worded here). ──
export struct ComparisonHeader {
    ticker: string,
    study-id: string,
    name: string,
    currency: string,
    date: string,
    unavailable: bool,
    zone: string,           // buy | neutral | sell | below | above | ""
    state: string,          // full | provisional | withheld | ""
    low-confidence: bool,
}
export global Comparison {
    in-out property <[ComparisonHeader]> columns;
    in-out property <[string]> cells;
    in-out property <int> column-count;
    in-out property <bool> currency-mix;
    in-out property <string> date;
    in-out property <string> notice;
    // The five picks (study tickers), from the Études list's drop-downs.
    in-out property <string> pick1;
    in-out property <string> pick2;
    in-out property <string> pick3;
    in-out property <string> pick4;
    in-out property <string> pick5;
    callback compare();            // build the table from the picks and open it
    callback close();              // back to the list
    callback export-pdf();
    callback open-study(string);   // study id → open (the comparison stays behind it)
}

// ── Story 7.3 — the « Examen rapide » (the beginner's check list): two ladders, the five-year
//    price / P/E record, the reader's own fields, four conclusions worded as facts. Every figure
//    arrives formatted; every worded fact arrives as a KEY worded here (@tr) and in the report. ──
export struct QuickPriceRow {
    year: string,
    high: string,
    low: string,
    eps: string,
    pe-high: string,
    pe-low: string,
}
export global QuickScreen {
    in-out property <string> ticker;
    in-out property <string> name;
    in-out property <string> currency;
    in-out property <string> date;
    in-out property <string> source;
    in-out property <bool> from-study;      // opened from a study → no « Créer l'étude »
    in-out property <bool> from-watchlist;  // opened from the criblage → « Retour » to Liste de suivi
    in-out property <bool> fetching;
    in-out property <string> notice;
    // §1 / §2 ladders: ten lines each (row-major, "" = absent), the four years, the rate, the span.
    in-out property <[string]> sales-lines;
    in-out property <[string]> sales-years;
    in-out property <string> sales-rate;
    in-out property <string> sales-span;
    in-out property <bool> sales-unavailable;
    in-out property <[string]> eps-lines;
    in-out property <[string]> eps-years;
    in-out property <string> eps-rate;
    in-out property <string> eps-span;
    in-out property <bool> eps-unavailable;
    in-out property <string> eps-vs-sales;   // eps | sales | same | ""
    // §3
    in-out property <[QuickPriceRow]> price-rows;
    in-out property <string> pe-high-total;
    in-out property <string> pe-low-total;
    in-out property <string> pe-high-avg;
    in-out property <string> pe-low-avg;
    in-out property <string> pe-avg-of-avgs;
    // The §3 bases (G1 review): « cinq ans » only over the form's full five-year record.
    in-out property <string> pe-basis;            // five | all | partial | "" (no P/E row)
    in-out property <string> pe-years;            // rows the P/E totals / averages cover
    in-out property <string> record-years;        // rows of the record
    in-out property <string> present-price;
    in-out property <string> present-eps;
    in-out property <string> present-pe;
    in-out property <string> high-five-years-ago;
    in-out property <string> price-vs-high-pct;   // signed, "" = unknown
    in-out property <string> high-basis;          // five | year | "" (no high)
    in-out property <string> high-year;
    in-out property <string> years-sold-as-high;
    in-out property <string> sold-basis;          // five | count | "" (absent)
    in-out property <string> sold-of;             // rows with a known high
    in-out property <string> pe-position;         // higher | similar | lower | ""
    in-out property <string> pe-absent;           // pe | average | both | "" (why no position)
    // The reader's fields (session only, echoed as typed).
    in-out property <string> reasons;
    in-out property <string> factors-continue;    // yes | less | no | ""
    in-out property <string> pe-notes;
    in-out property <string> objective;
    in-out property <string> eps-will-meet;       // yes | no | ""
    // §4, derived in Rust from the objective (keys: yes | no | no-rate | unread | "" = blank).
    in-out property <string> sales-meets;
    in-out property <string> eps-meets;
    // The picker on Études.
    in-out property <string> pick-ticker;
    in-out property <string> pick-currency;
    callback examine(string, string);   // ticker, currency → fetch, then open
    callback examine-study();           // the open study's own years → open
    callback close();
    callback export-pdf();
    callback create-study();
    callback objective-edited(string);
}

export struct PortfolioRow {
    id: string,
    name: string,
}

// Story 6.2 (FR38): one per-currency capital-at-risk subtotal. `amount`/`pct` are already-formatted
// display strings (`pct` is "" when nothing is invested in that currency). There is deliberately NO
// consolidated global total — currencies are never mixed until FX lands (Story 6.5 / 6.6).
export struct CapitalAtRiskRow {
    currency: string,
    amount: string,
    pct: string,
}

// Story 6.3 (FR39): one row of the opened holding's transaction ledger. `kind` is the raw
// discriminator ("buy"/"sell" — the display noun is chosen in the view); decimals are the exact
// canonical TEXT spellings; `date` is the event date (AAAA-MM-JJ).
export struct LedgerRow {
    id: string,
    date: string,
    kind: string,
    quantity: string,
    unit-price: string,
    fees: string,
    currency: string,
    rationale: string,
    // Story 6.4 (FR41): the NET amount of a dividend row (gross − retenue), pre-formatted by
    // Rust; "" on buy/sell rows.
    net: string,
}

// Issue #84: one SOLD (retired) position of the « Positions vendues » section — read-only facts;
// its ledger opens through the same `ledger-holding-id` mechanism as the register, and a re-buy
// (the record-buy rail) re-opens the position. `sold-date` is the sold DAY (AAAA-MM-JJ).
export struct SoldRow {
    id: string,
    ticker: string,
    currency: string,
    sold-date: string,
}

export struct HoldingRow {
    id: string,
    ticker: string,
    quantity: string,
    purchase-price: string,
    // The purchase price as displayed (locale, the price scale): the ledger's weighted average is an
    // exact decimal with up to 28 digits — `purchase-price` keeps it for the edit form, this shows it.
    purchase-price-text: string,
    // Story 6.2 (FR38): the currency this holding is denominated in ("CHF" | "EUR" | …). Shown beside
    // every amount; a pre-6.2 holding is read under the reference currency (coalesced in Rust).
    currency: string,
    // Issue #98 (FR48): the holding's sector — provider-reported or manual ("" = non renseigné);
    // shown as a caption and prefilled in the edit form.
    sector: string,
    // Story 4.4 (FR40): the auto-matched study's zone + freshness. `linked` is false when no saved
    // study matches the ticker (neutral "no study" state). `zone` is the key crossed from Rust
    // ("buy"/"neutral"/"sell"/"" — "" shows "—", outside the band or undefined). `current-price` and
    // `as-of` are display strings; `stale` marks a failed/older last refresh.
    linked: bool,
    // Issue #95: the study auto-match READ failed — the row says « étude indisponible »,
    // never the factually wrong « aucune étude liée ».
    study-unavailable: bool,
    study-link: string,
    // The UX pass: when no study matches ticker+currency but one exists for the ticker in ANOTHER
    // currency, that currency ("" otherwise) — the register names the mismatch instead of a bare
    // « Aucune étude liée » (the on-display walk's CHF-vs-USD trap).
    study-other-currency: string,
    zone: string,
    // Issue #48 (FR35): the price sits BELOW the matched study's forecast band — a distinct
    // neutral fact; mutually exclusive with a defined `zone`.
    below-band: bool,
    current-price: string,
    stale: bool,
    as-of: string,
    // Story 4.5 (FR42): the trailing stop. `has-stop` is false when none is set; `stop-pct` /
    // `stop-level` are display strings; `stop-breached` is true when the current price ≤ the stop
    // level (a neutral fact — no action; the sell/raise-stop sheet is Story 4.7).
    has-stop: bool,
    stop-pct: string,
    stop-level: string,
    stop-breached: bool,
    // The current price's margin above the stop level (display string; "" when breached or unknown).
    stop-distance: string,
    // Story 4.7 (FR46/FR47): the neutral trigger this holding fires — "stop" (breached, takes
    // priority), "sell" (in its Sell zone), or "" (none). `dismissed` is true while the user has
    // hidden this trigger's action panel for the session (transient; never persisted).
    trigger-kind: string,
    dismissed: bool,
}

// The single-portfolio holdings register (Story 4.3, FR36). Rows are built/ordered by Rust; intents
// are handled in Rust (validate + persist + re-render). `reference-currency` is the global currency
// the amounts are read in (FR63) — a label only, no conversion in Epic 4.
export global Holdings {
    in-out property <[HoldingRow]> rows;
    in-out property <int> holding-count;
    in-out property <bool> read-only;
    in-out property <string> notice;
    in-out property <string> reference-currency: "CHF";
    // Story 6.2 (FR38): the fixed allow-list a holding may be denominated in, pushed from Rust
    // (config::SUPPORTED_CURRENCIES) so the picker and the validator share one source of truth.
    in-out property <[string]> supported-currencies: ["CHF", "EUR", "USD", "GBP", "JPY"];
    // Story 4.4 / issue #52: true while a price refresh is in flight — disables the refresh button
    // so a double-click can't enqueue duplicate jobs. Cleared when the last job's outcome arrives.
    in-out property <bool> refreshing;
    // Issue #100: the "done / total" progress of the paced price-refresh batch ("" when idle).
    in-out property <string> refresh-progress;
    // Story 4.6 (FR43) / Story 6.2 (FR38): the portfolio's capital-at-risk, one subtotal PER currency
    // (holdings can differ in currency, so a single mixed total is forbidden until FX lands). Each row
    // carries the currency + a formatted figure + its share of that currency's invested capital.
    in-out property <[CapitalAtRiskRow]> capital-at-risk-by-currency;
    // Issue #61: the un-protected exposure — one already-formatted, posture-gated line per currency
    // naming how many holdings have NO trailing stop + their uncovered value. Shown beneath the
    // capital-at-risk panel so "0 % du capital investi" (no stop set) is not misread as "no downside".
    // Empty when every holding is stop-protected.
    in-out property <[string]> unstopped-exposure;
    // Issue #218: a position exists only for a ticker with a study and takes that study's currency
    // (no currency argument — the rail refuses a symbol without a study).
    // ticker, quantity, purchase-price, sector ("" = non renseigné) → written?
    callback add-holding(string, string, string, string) -> bool;
    // id, ticker, quantity, purchase-price, sector → written?
    callback edit-holding(string, string, string, string, string) -> bool;
    callback remove-holding(string); // id
    // Story 4.4 (FR40): user-initiated price refresh for every linked holding (off the UI thread).
    callback refresh-prices();
    callback cancel-refresh();                     // issue #100: drain the in-flight refresh batch
    // Story 4.5 (FR42): set/clear a holding's trailing-stop percentage (id, pct — "" clears).
    callback set-trailing-stop(string, string) -> bool; // → written? (a dialog closes only then)
    // Story 4.7 (FR46/FR47) + Story 6.3 (FR39): record a sell on a neutral trigger (id, quantity,
    // rationale). An empty quantity sells the WHOLE position (the 4.7 flow); a smaller one is a
    // partial sell — the holding stays with the reduced quantity. The app never auto-sells.
    // Dismiss hides a trigger's action panel for the session (id).
    callback sell-holding(string, string, string) -> bool; // → sold? (a dialog closes only then)
    callback dismiss-trigger(string);
    // ── Story 6.3 (FR39): the transaction ledger of ONE opened holding. `ledger-holding-id` is ""
    //    while no ledger is shown; rows are pushed by Rust on open and after every mutation. The
    //    row currency is pinned to the holding's (FR28) — displayed, never chosen. ──
    in-out property <[LedgerRow]> ledger-rows;
    in-out property <string> ledger-holding-id;
    // Issue #84: the active portfolio's SOLD positions (most recently sold first), pushed with
    // every register re-render. The section is collapsed by default (pure-Slint toggle in the
    // screen); a sold row's ledger reuses `open-ledger` / `ledger-rows` above.
    in-out property <[SoldRow]> sold-rows;
    // Issue #86: deleting a ledger row is irreversible → the Dialog confirm variant (the UX pass).
    callback open-ledger(string);   // holding id → push rows + show
    callback close-ledger();
    // holding id, date (AAAA-MM-JJ, "" = today), quantity, unit price, fees ("" = 0), rationale → recorded?
    callback record-buy(string, string, string, string, string, string) -> bool;
    // Same shape for an ordinary ledger-form SELL (6.3 review decision, FR39): the unit price is
    // the one the user actually obtained — explicit, not the matched study's.
    callback record-sell(string, string, string, string, string, string) -> bool;
    // Story 6.4 (FR41): a DIVIDEND — id, date, shares paid on, GROSS per share, withholding
    // ("" = auto at the Réglages default rate; "0" = none), rationale → recorded?
    callback record-dividend(string, string, string, string, string, string) -> bool;
    // Story 6.4 (FR41): the NET reinvestable dividend cash per currency (pct unused — "").
    in-out property <[CapitalAtRiskRow]> reinvestable-cash;
    // ── Story 6.6 (FR44): the consolidation hierarchy — per bank + global, in the reference
    //    currency, FX only here. Empty banks list = nothing to consolidate (single bank, no
    //    foreign bucket) → the block hides. `consolidation-global` is "" when a pair is missing
    //    (then `consolidation-missing` names it); `consolidation-rates` is the footnote. ──
    in-out property <[BankCarRow]> consolidation-banks;
    in-out property <string> consolidation-global;
    in-out property <string> consolidation-global-pct;
    in-out property <string> consolidation-missing;
    in-out property <string> consolidation-rates;
    // ── Story 6.7 (FR45): concentration on the TOTAL invested capital + the diversify-by-size
    //    mix. Rows are per SECURITY (aggregated across banks/currencies), largest share first;
    //    `concentration-missing` names the pairs when the denominator is absent;
    //    `concentration-unavailable` marks a failed read (an absence, never a zero state);
    //    `concentration-rates` is the FR28 footnote for pairs not already named above. The
    //    threshold / boundary / target mirrors are canonical validated strings pushed from
    //    app-config (startup + Réglages change) — `refresh_holdings` bakes them at render time
    //    (the reference-currency pattern). ──
    in-out property <[ConcentrationLine]> concentration-rows;
    in-out property <bool> concentration-unavailable;
    // true when securities are listed but the shares' denominator is unusable: the total could
    // not be formed (missing pair named in `concentration-missing`, or a checked overflow when
    // it is ""), or the total is present but nonpositive (all-zero-cost positions).
    in-out property <bool> concentration-global-absent;
    in-out property <string> concentration-missing;
    in-out property <string> concentration-rates;
    in-out property <[SizeMixLine]> size-mix-rows;
    in-out property <[UnclassifiedLine]> size-unclassified-rows;
    in-out property <string> concentration-threshold-pct: "50";
    // The threshold's locale-formatted DISPLAY spelling (the murmur line shows it beside
    // locale-formatted shares; the canonical string above is the parse source, never shown).
    in-out property <string> concentration-threshold-display: "50";
    in-out property <string> size-small-max: "1000000000";
    in-out property <string> size-medium-max: "10000000000";
    in-out property <string> size-target-small-pct: "25";
    in-out property <string> size-target-medium-pct: "50";
    in-out property <string> size-target-large-pct: "25";
    // transaction id, date, quantity, unit price, fees, rationale → applied? (kind/currency are not editable)
    callback update-transaction(string, string, string, string, string, string) -> bool;
    callback delete-transaction(string); // transaction id
    // ── Story 6.1 (FR37): multiple portfolios. The list + the active id; the register above shows the
    //    active portfolio's holdings. Add/rename/delete are guarded (neutral notices on refusal). ──
    in-out property <[PortfolioRow]> portfolios;
    in-out property <string> active-portfolio-id;
    callback select-portfolio(string);          // id → make active
    callback add-portfolio(string) -> bool;             // name → created?
    callback rename-portfolio(string, string) -> bool;  // id, name → renamed?
    callback delete-portfolio(string);          // id
    // The UX pass: the add-position dialog looks the study up as the symbol is typed — its
    // native currency (the picker's default, so a USD study never gets a CHF position by
    // reflex) and its company name ("" when no study / no name). Read-only lookups.
    pure callback study-currency-for(string) -> string;
    pure callback study-name-for(string) -> string;
    // Guy, 2026-09-24: the symbols a position can be added for (every study's ticker, unique,
    // sorted) — the add-position dialog offers them as a drop-down list, never free text.
    in-out property <[string]> study-tickers;
    // ── Story 6.8 (FR48): the replacement-candidates panel — a PORTFOLIO-LEVEL pushed state
    //    (a whole-position sell removes its row, so the panel outlives it). Auto-opened by Rust
    //    after a successful sell (both paths), manually via the trigger-panel « Candidats »;
    //    session-only, cleared on journal switch, re-synced while open. ──
    in-out property <[CandidateRow]> candidate-rows;
    // Issue #98 (FR48): the « non renseigné » sector bucket's share of the invested capital
    // ("" = none) — the visible blind spot line of the candidates panel.
    in-out property <string> candidates-sector-unlabeled;
    in-out property <bool> candidates-visible;
    in-out property <string> candidates-context; // the sold/triggering ticker ("" = manual open)
    // true ONLY when the panel was opened by a RECORDED sell (the two sell hooks) — the
    // « Vente enregistrée » header must never assert a sale that did not happen (a trigger's
    // « Candidats » opens BEFORE deciding).
    in-out property <bool> candidates-sold;
    // true when the watchlist itself could not be read — « indisponible », never « liste vide ».
    in-out property <bool> candidates-unavailable;
    // The FR28 footnote for the exposure shares: every rate used, with its date and source.
    in-out property <string> candidates-rates;
    callback open-candidates(string);        // context ticker ("" allowed)
    callback close-candidates();
    callback open-candidate-study(string);   // study id → navigate to Études + open (one rail)
    callback go-to-studies();                // unlinked hand-off → the Études list/create form
}
