// Token design system — the single source of truth every component reads (UX-DR1/2/6/7).
// Governance rule: NO hard-coded colour or size anywhere else in ui/ — always read `Tokens`.
//
// Two families:
//  - colour/alpha (in-out): freely swappable at runtime. `app/src/theme.rs` owns the canonical
//    theme state and pushes a whole ink scale here on switch. Defaults below = the DARK scale.
//  - metric/typo (out): quasi-static — never swapped during interaction, so a theme switch
//    causes no geometry change.
//
// The judgment-zone hues (Okabe-Ito) and per-theme zone alphas are defined now so later stories
// (2.6 verdict bar, 2.8 chart) consume tokens only; nothing renders a zone in 2.1.

export global Tokens {
    // ── Colour/alpha family (runtime-swappable; dark scale as defaults) ──
    in-out property <bool> dark: true;
    in-out property <color> bg: #0E0F12;
    in-out property <color> surface: #16181D;
    in-out property <color> surface-alt: #1C1F26;
    in-out property <color> separator: #2A2E37;
    in-out property <color> text-high: #ECEEF2;
    in-out property <color> text-mid: #B8BDC7;
    in-out property <color> text-low: #8A8F98;
    // Judgment-zone hues — identical across themes; only the alpha is per-theme
    // (dark 32–40 %, light 15–18 %).
    in-out property <color> zone-buy: #009E73;
    in-out property <color> zone-hold: #E69F00;
    in-out property <color> zone-sell: #D55E00;
    in-out property <float> zone-alpha: 0.36;
    // Always-visible keyboard focus ring ink (NFR-U2).
    in-out property <color> focus: #B8BDC7;
    // Grid-line ink for the faithful SSG cell grid (§2/§3) — a hair lighter than `separator` so
    // the 1 px cell borders read as a table, not a set of boxes (Story 2.3).
    in-out property <color> grid-line: #2A2E37;
    // ── Manual-entry neutrals (Story 2.4) — the attention hierarchy carried by texture/opacity,
    //    NEVER colour (colour budget = judgment zones only, which don't exist until 2.6) ──
    // The active-cell cursor surface: a brighter neutral fill behind the focused entry cell (paired
    // with the `focus` ink ring) — the visible cell cursor, no colour spent.
    in-out property <color> cell-active: #232A38;
    // The shouting to-fill gap ink: a strong neutral so an unfilled hole in the grid is loud on its
    // own (UX "missing shouts"). High-contrast, but still ink — not a judgment hue.
    in-out property <color> gap-ink: #ECEEF2;
    // Regime-driven emphasis alpha (Story 2.3, FR56): 1.0 in entry, attenuated in contemplation so
    // the editing affordances calm down at the judgment moment. The ONE token the regime swap moves
    // in 2.3; 2.5 (markers) / 2.6 (zones) hang their deltas on the same hook. Colour/alpha only —
    // NEVER a geometry value, so a regime switch never re-lays-out (UX-DR6, constant geometry).
    in-out property <float> regime-emphasis: 1.0;
    // ── Trust markers (Story 2.5) — the human-judgment axis. The ONE sanctioned colour-budget
    //    exception: the geofenced desaturated ink-green of the `✓` validated marker (≈ #4A7C6F dark),
    //    deliberately NOT the Buy green (#009E73 / zone-buy). Admissible only because no zone bands
    //    exist yet (2.6) and it attenuates to neutral ink in contemplation — it must NEVER co-present
    //    with the judgment zones. Everything else on the markers is shape/outline/opacity, never hue.
    in-out property <color> validated-ink: #4A7C6F;

    // ── Metric/typo family (quasi-static) ──
    // 4 px spacing scale: 4 · 8 · 12 · 16 · 24 · 32 · 48.
    out property <length> space-4: 4px;
    out property <length> space-8: 8px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-24: 24px;
    out property <length> space-32: 32px;
    out property <length> space-48: 48px;
    // Type scale: verdict 28 / H2 18 / H3 15 / body 14 / caption 12.
    out property <length> font-verdict: 28px;
    out property <length> font-h2: 18px;
    out property <length> font-h3: 15px;
    out property <length> font-body: 14px;
    out property <length> font-caption: 12px;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    // Flat elevation: 1 px borders, no shadows.
    out property <length> border: 1px;
    out property <length> focus-border: 2px;
    out property <length> radius: 4px;
    out property <length> row-height: 28px;
    // Manual-entry textures (Story 2.4), quasi-static so a theme/regime swap never re-lays-out:
    // the bold glyph that marks a to-fill gap ("a hole in a regular grid"), the hollow dot that
    // accompanies a stale value's murmur, and the stale opacity (~60%). Glyphs are language-neutral
    // (not `@tr`). The not-available marker text is an `@tr("n/a")` literal in the cell component.
    out property <string> gap-glyph: "▦";
    out property <string> stale-dot: "◦";
    out property <float> stale-opacity: 0.6;
    // The Story-2.7 plausibility attention glyph — a neutral outline triangle, a DELIBERATELY distinct
    // shape from the gap "▦", stale "◦", review "?"/"✓" and the "n/a" marker (the confusability gate).
    // Drawn in neutral ink (`gap-ink`/`text-high`), NEVER a judgment hue. Quasi-static, so a theme/
    // regime swap never re-lays-out the glyph.
    out property <string> warn-glyph: "△";
    // Trust-marker outline weight (Story 2.5): the heavier ring on the `?` to-review glyph — the
    // second non-colour channel that keeps it unmistakably distinct from the hollow `◦` stale dot.
    // Quasi-static (a metric), so a theme/regime swap never re-lays-out the marker.
    out property <length> marker-outline: 1.5px;
    // Shell geometry.
    out property <length> nav-rail-width: 200px;
    out property <length> top-bar-height: 48px;
    out property <length> indicator-width: 3px;
    out property <length> min-window-width: 720px;
    out property <length> min-window-height: 480px;
    // Bundled font families (app/assets/fonts/, OFL): Inter for UI text, IBM Plex Sans for
    // numerals (tabular figures by default — verified, see Story 2.1 Dev Agent Record).
    out property <string> font-ui: "Inter";
    out property <string> font-numeric: "IBM Plex Sans";
}
