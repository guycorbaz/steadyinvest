// Dropdown — a constrained choice as a drop-down list (Guy, 2026-09-24: « des menus déroulants
// partout où c'est possible, cela diminue les erreurs de saisie »). A token-styled box (the TextField
// look) showing the current value and a ▾ glyph; a click opens a PopupWindow listing the options,
// one row each; picking a row sets `value`, fires `changed` and closes. No std-widgets (the app's
// primitives are all restyled), no colour spent. Keyboard: Enter / Space open the list.

import { Tokens } from "../tokens.slint";

export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback changed(string);

    height: Tokens.row-height + Tokens.space-4;
    border-radius: Tokens.radius;
    background: Tokens.surface-alt;
    border-width: fs.has-focus ? Tokens.focus-border : Tokens.border;
    border-color: fs.has-focus ? Tokens.focus : Tokens.separator;
    opacity: root.enabled ? 1.0 : 0.5;
    forward-focus: fs;

    function open() {
        if (root.enabled && root.options.length > 0) {
            popup.show();
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            fs.focus();
            root.open();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-12;
        padding-right: Tokens.space-12;
        spacing: Tokens.space-8;
        Text {
            text: root.value != "" ? root.value : root.placeholder;
            color: root.value != "" ? Tokens.text-high : Tokens.text-low;
            font-size: Tokens.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: "▾";
            color: Tokens.text-mid;
            font-size: Tokens.font-body;
            vertical-alignment: center;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Tokens.surface;
            border-width: Tokens.border;
            border-color: Tokens.separator;
            border-radius: Tokens.radius;

            VerticalLayout {
                padding: Tokens.space-4;
                for option in root.options: Rectangle {
                    height: Tokens.row-height;
                    border-radius: Tokens.radius;
                    background: row-touch.has-hover ? Tokens.surface-alt : transparent;
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = option;
                            root.changed(option);
                            popup.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: Tokens.space-8;
                        padding-right: Tokens.space-8;
                        Text {
                            text: option;
                            color: Tokens.text-high;
                            font-size: Tokens.font-body;
                            font-weight: option == root.value ? Tokens.weight-semibold : 400;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
