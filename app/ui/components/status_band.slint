// StatusBand — a persistent STATE you cannot miss, without spending colour (the UX pass,
// 2026-09-23). A state describes a situation that exists regardless of the last gesture and lasts
// while it exists (« taux manquant », « non classé », « aucune étude liée », a threshold murmur);
// it is never a modal (a refusal is — see ModalDialog). Attention comes from placement (first row of
// the card it concerns), a full-width surface-alt band with a border, and an ink glyph — never a hue.

import { Tokens } from "../tokens.slint";
import { ActionButton } from "action_button.slint";

export component StatusBand inherits Rectangle {
    in property <string> text;
    // The ink glyph: "◦" (a hollow dot — absent / missing / stale), "⚠" (a threshold murmur),
    // "⊘" (indisponible — a read failure or an unformable figure), "★" (AI proposals, 8.5a).
    in property <string> icon: "◦";
    // Story 8.5a (UX spec §4.5) — an optional action (« Voir les propositions », 8.8's « Voir la
    // comparaison »): empty = no button, the band renders exactly as before. A compact
    // `ActionButton` (Tab-reachable after the band text, Enter/Space, focus ring), TRAILING by
    // default — the band stays one line high; `action-below` puts it under the text, for a band
    // inside a card wider than the window (the Études card, the G6 width debt), where a trailing
    // button would fall off-screen (G3).
    in property <string> action-label: "";
    in property <bool> action-below: false;
    callback action();

    background: Tokens.surface-alt;
    border-width: Tokens.border;
    border-color: Tokens.separator;
    border-radius: Tokens.radius;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding-left: Tokens.space-12;
        padding-right: Tokens.space-12;
        padding-top: root.action-label != "" ? Tokens.space-4 : Tokens.space-8;
        padding-bottom: root.action-label != "" ? Tokens.space-4 : Tokens.space-8;
        spacing: Tokens.space-12;

        Text {
            text: root.icon;
            color: Tokens.text-high;
            font-size: Tokens.font-body;
            vertical-alignment: root.action-label != "" && !root.action-below ? center : top;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-4;
            alignment: center;
            Text {
                text: root.text;
                color: Tokens.text-mid;
                font-size: Tokens.font-caption;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            if root.action-label != "" && root.action-below: HorizontalLayout {
                alignment: start;
                ActionButton {
                    compact: true;
                    label: root.action-label;
                    clicked => { root.action(); }
                }
            }
        }
        if root.action-label != "" && !root.action-below: ActionButton {
            compact: true;
            label: root.action-label;
            clicked => { root.action(); }
        }
    }
}
