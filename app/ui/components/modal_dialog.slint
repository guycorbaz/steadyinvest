// ModalDialog — the ONE in-window overlay of the UX pass (2026-09-23), in three variants driven by
// the `Dialog` global:
//   notice  — a REFUSAL the user must acknowledge (« Compris »): the message names its cause.
//   confirm — a destructive gesture needs an explicit yes (« Annuler » / the verb).
//   form    — every data entry/edit: a title, ONE explanatory sentence, labelled fields (a label
//             ABOVE each field, never a placeholder as the only label), a refusal raised by the form
//             kept inline next to the fields (the user's text intact), « Annuler » / « Enregistrer ».
// Built on the confront-overlay pattern (scrim, centred card, click outside = cancel). Keyboard:
// Esc cancels, Enter in a field validates, the first field (or the drop-down, when a form starts
// with one) is focused on open; a destructive verb never fires on a plain Enter. G1 review: the
// focus is TRAPPED in the card — two invisible sentinels at its edges send a Tab past the last
// control back to the first, and a Shift+Tab past the first to the last (the screen behind never
// gets the focus, so Enter can never re-fire the hidden opener). Ink only — attention comes from
// the scrim, the placement and a glyph, never a hue (colour budget). Every user-visible string is
// French inside `@tr()`.
//
// The form's submit calls the SAME `Holdings` callbacks as before the pass (same arguments) and
// closes only on a written result — the verify-before-write logic has one code path.

import { Tokens } from "../tokens.slint";
import { Dialog, Holdings, Prefs, Studies, Watchlist, Fx } from "../state.slint";
import { ActionButton } from "action_button.slint";
import { TextField } from "text_field.slint";
import { StatusBand } from "status_band.slint";
import { Dropdown } from "dropdown.slint";

component LabeledField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text <=> field.text;
    // The form's first field takes the focus on open — deferred by a tick (see ActionButton) —
    // and again whenever the focus trap bumps `focus-request` (a Tab past the last control).
    in property <bool> autofocus: false;
    in property <int> focus-request;
    callback accepted();
    callback edited();

    spacing: Tokens.space-4;
    changed focus-request => {
        if (root.autofocus) { field.focus(); }
    }
    Timer {
        interval: 30ms;
        running: root.autofocus;
        triggered => {
            self.running = false;
            field.focus();
        }
    }
    Text {
        text: root.label;
        color: Tokens.text-mid;
        font-size: Tokens.font-caption;
    }
    field := TextField {
        placeholder: root.placeholder;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
}

component LabeledDropdown inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <[string]> options;
    in-out property <string> value <=> field.value;
    // A form that STARTS with a drop-down focuses it on open (G1 review: the position and FX-rate
    // forms had no initial focus — Esc was dead and Enter re-fired the hidden opener).
    in property <bool> autofocus: false;
    in property <int> focus-request;
    callback picked(int);

    spacing: Tokens.space-4;
    changed focus-request => {
        if (root.autofocus) { field.focus(); }
    }
    Timer {
        interval: 30ms;
        running: root.autofocus;
        triggered => {
            self.running = false;
            field.focus();
        }
    }
    Text {
        text: root.label;
        color: Tokens.text-mid;
        font-size: Tokens.font-caption;
    }
    field := Dropdown {
        options: root.options;
        placeholder: root.placeholder;
        picked(index) => { root.picked(index); }
    }
}

export component ModalDialog inherits Rectangle {
    // A dimming scrim over the whole window; a click outside the card cancels.
    background: Tokens.bg.with-alpha(0.72);

    // ── The form's validity (the button is disabled, and Enter is a no-op, until the required
    //    fields are typed — the walk's « nothing happens » had a SILENT disabled button; here the
    //    labels say what is required). ──
    // The focus trap's requests (see the sentinels below): bumping one moves the focus to the
    // control bound to it — the variant's first control, its « Annuler », its validating verb.
    property <int> first-request;
    property <int> cancel-request;
    property <int> commit-request;

    function can-submit() -> bool {
        if (Holdings.read-only) { return false; }
        // Issue #218 + G1 decision 3: a position is added for a chosen STUDY (its id).
        if (Dialog.form-id == "holding-add") { return Dialog.draft-study-id != ""; }
        // G1 decision 4: the edit keeps the currency; a new symbol is checked by Rust (a named
        // refusal when its study is in another currency).
        if (Dialog.form-id == "holding-edit") { return Dialog.draft-ticker != ""; }
        if (Dialog.form-id == "buy" || Dialog.form-id == "sell" || Dialog.form-id == "txn-edit") {
            return Dialog.draft-quantity != "" && Dialog.draft-price != "";
        }
        if (Dialog.form-id == "dividend") { return Dialog.draft-price != ""; }
        if (Dialog.form-id == "stop") { return Dialog.draft-price != ""; }
        if (Dialog.form-id == "portfolio-add" || Dialog.form-id == "portfolio-rename") {
            return Dialog.draft-name != "";
        }
        if (Dialog.form-id == "watch-add") { return Dialog.draft-ticker != ""; }
        if (Dialog.form-id == "study-create") { return Dialog.draft-ticker != "" && Dialog.draft-currency != ""; }
        if (Dialog.form-id == "fx-rate") { return Dialog.draft-ticker != "" && Dialog.draft-price != ""; }
        // sell-trigger: an empty quantity sells the whole position (the 4.7 flow).
        return true;
    }

    // ── Submit: the pre-pass callbacks, unchanged; close ONLY on a written result (a refusal
    //    lands in `Dialog.field-error` through Rust and the form stays open with the text). ──
    //    G1 review: `Dialog.gesture` marks the callback as THIS form's own gesture — only its
    //    refusal lands in `field-error`; anything else raised meanwhile waits in Rust's queue. ──
    function submit() {
        if (!root.can-submit()) { return; }
        Dialog.gesture = true;
        root.dispatch-submit();
        Dialog.gesture = false;
    }
    function dispatch-submit() {
        if (Dialog.form-id == "holding-add") {
            if (Holdings.add-holding(Dialog.draft-study-id, Dialog.draft-quantity, Dialog.draft-price, Dialog.draft-sector)) { Dialog.close(); }
        } else if (Dialog.form-id == "holding-edit") {
            if (Holdings.edit-holding(Dialog.target-id, Dialog.draft-ticker, Dialog.draft-quantity, Dialog.draft-price, Dialog.draft-sector)) { Dialog.close(); }
        } else if (Dialog.form-id == "buy") {
            if (Holdings.record-buy(Dialog.target-id, Dialog.draft-date, Dialog.draft-quantity, Dialog.draft-price, Dialog.draft-fees, Dialog.draft-rationale)) { Dialog.close(); }
        } else if (Dialog.form-id == "sell") {
            if (Holdings.record-sell(Dialog.target-id, Dialog.draft-date, Dialog.draft-quantity, Dialog.draft-price, Dialog.draft-fees, Dialog.draft-rationale)) { Dialog.close(); }
        } else if (Dialog.form-id == "dividend") {
            if (Holdings.record-dividend(Dialog.target-id, Dialog.draft-date, Dialog.draft-quantity, Dialog.draft-price, Dialog.draft-fees, Dialog.draft-rationale)) { Dialog.close(); }
        } else if (Dialog.form-id == "txn-edit") {
            if (Holdings.update-transaction(Dialog.target-id, Dialog.draft-date, Dialog.draft-quantity, Dialog.draft-price, Dialog.draft-fees, Dialog.draft-rationale)) { Dialog.close(); }
        } else if (Dialog.form-id == "sell-trigger") {
            if (Holdings.sell-holding(Dialog.target-id, Dialog.draft-quantity, Dialog.draft-rationale)) { Dialog.close(); }
        } else if (Dialog.form-id == "stop") {
            if (Holdings.set-trailing-stop(Dialog.target-id, Dialog.draft-price)) { Dialog.close(); }
        } else if (Dialog.form-id == "portfolio-add") {
            if (Holdings.add-portfolio(Dialog.draft-name)) { Dialog.close(); }
        } else if (Dialog.form-id == "portfolio-rename") {
            if (Holdings.rename-portfolio(Dialog.target-id, Dialog.draft-name)) { Dialog.close(); }
        } else if (Dialog.form-id == "watch-add") {
            if (Watchlist.add-watch(Dialog.draft-ticker)) { Dialog.close(); }
        } else if (Dialog.form-id == "study-create") {
            if (Studies.create-study(Dialog.draft-ticker, Dialog.draft-currency, Dialog.draft-name)) { Dialog.close(); }
        } else if (Dialog.form-id == "fx-rate") {
            if (Fx.add-rate(Dialog.draft-ticker, Dialog.draft-price, Dialog.draft-date)) { Dialog.close(); }
        }
    }

    // ── Cancel: the confirms Rust parked keep a pending action on their side — tell them. ──
    function cancel() {
        if (Dialog.kind == "confirm") {
            if (Dialog.action == "study-action") { Studies.cancel-study-action(); }
            else if (Dialog.action == "confirm-import") { Prefs.cancel-import(); }
            else if (Dialog.action == "confirm-restore") { Prefs.cancel-restore(); }
        }
        Dialog.close();
    }

    // The confirm title and verb, derived from the action when Rust parked it (the strings stay
    // here, posture-gated); a Slint-side opener passes its own title/verb.
    function confirm-title() -> string {
        if (Dialog.title != "") { return Dialog.title; }
        if (Dialog.action == "study-action") {
            return Studies.study-action-destructive ? @tr("Supprimer cette étude ?") : @tr("Confirmer cette action ?");
        }
        if (Dialog.action == "confirm-import") { return @tr("Importer un dossier plus ancien ?"); }
        if (Dialog.action == "confirm-restore") { return @tr("Restaurer cette sauvegarde ?"); }
        if (Dialog.action == "delete-portfolio") { return @tr("Supprimer ce portefeuille ?"); }
        return "";
    }
    // The confirm's sentence: the state layer's prompt, or — for a confirm Rust raises after a
    // guard passed (the empty portfolio) — the fact the guard established.
    function confirm-body() -> string {
        if (Dialog.body != "") { return Dialog.body; }
        if (Dialog.action == "delete-portfolio") {
            return @tr("Le portefeuille ne contient aucune position ; sa suppression est définitive.");
        }
        return "";
    }
    // G1 review (Guy's decision 5): every confirm verb writes the dossier — on a read-only one it
    // stays blocked, and the dialog SAYS why instead of greying the verb in silence.
    function confirm-enabled() -> bool {
        return !Holdings.read-only;
    }
    function confirm-verb() -> string {
        if (Dialog.verb != "") { return Dialog.verb; }
        if (Dialog.action == "study-action") {
            return Studies.study-action-destructive ? @tr("Supprimer définitivement") : @tr("Confirmer");
        }
        if (Dialog.action == "confirm-import") { return @tr("Confirmer l'import"); }
        if (Dialog.action == "confirm-restore") { return @tr("Confirmer la restauration"); }
        if (Dialog.action == "delete-portfolio") { return @tr("Supprimer"); }
        return @tr("Confirmer");
    }

    // ── The focus trap: where a Tab leaving the card lands. Forward past the last control → the
    //    variant's first; backward past the first → its last enabled one. ──
    function focus-first() {
        root.first-request += 1;
    }
    function focus-last() {
        if (Dialog.kind == "notice") {
            root.first-request += 1;
        } else if (Dialog.kind == "confirm") {
            if (root.confirm-enabled()) { root.commit-request += 1; } else { root.cancel-request += 1; }
        } else {
            if (root.can-submit()) { root.commit-request += 1; } else { root.cancel-request += 1; }
        }
    }

    // ── Confirm: close FIRST, then act — a guard's refusal (raised by Rust) then opens its own
    //    notice on top of nothing, never inside the confirm it answers. ──
    function run-confirm() {
        if (Dialog.action == "delete-transaction") {
            Dialog.close();
            Holdings.delete-transaction(Dialog.target-id);
        } else if (Dialog.action == "delete-portfolio") {
            Dialog.close();
            Holdings.delete-portfolio(Dialog.target-id);
        } else if (Dialog.action == "remove-holding") {
            Dialog.close();
            Holdings.remove-holding(Dialog.target-id);
        } else if (Dialog.action == "study-action") {
            Dialog.close();
            Studies.confirm-study-action();
        } else if (Dialog.action == "confirm-import") {
            Dialog.close();
            Prefs.confirm-import();
        } else if (Dialog.action == "confirm-restore") {
            Dialog.close();
            Prefs.confirm-restore();
        } else {
            Dialog.close();
        }
    }

    // Esc cancels from anywhere inside the card (a field that does not handle Esc lets it
    // propagate up to this scope).
    keys := FocusScope {
        // Never a Tab stop or a click target itself — it only hears the Esc its children let
        // through.
        focus-on-tab-navigation: false;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }

        scrim := TouchArea {
            clicked => { root.cancel(); }
        }

        // The card — its own TouchArea swallows clicks so they never reach the scrim behind it.
        Rectangle {
            width: min(720px, parent.width - 2 * Tokens.space-32);
            height: min(card.preferred-height, parent.height - 2 * Tokens.space-16);
            background: Tokens.surface;
            border-width: Tokens.border;
            border-color: Tokens.separator;
            border-radius: Tokens.radius;

            TouchArea { /* swallow clicks inside the card */ }

            // The focus trap's leading sentinel: reached only by a Shift+Tab out of the first
            // control (the card is the window's last focusable subtree) — send it to the last.
            FocusScope {
                width: 0;
                height: 0;
                focus-on-click: false;
                focus-gained(reason) => {
                    if (reason == FocusReason.tab-navigation) { root.focus-last(); }
                }
            }

            card := VerticalLayout {
                padding: Tokens.space-24;
                spacing: Tokens.space-16;

                // ── Title row: a glyph names the variant (ink), then the title. ──
                HorizontalLayout {
                    spacing: Tokens.space-12;
                    Text {
                        text: Dialog.kind == "notice" ? "⚠" : Dialog.kind == "confirm" ? "?" : "✎";
                        color: Tokens.text-high;
                        font-size: Tokens.font-h2;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Dialog.kind == "confirm" ? root.confirm-title()
                            : Dialog.title != "" ? Dialog.title
                            : Dialog.kind == "notice" ? @tr("Action refusée") : "";
                        color: Tokens.text-high;
                        font-size: Tokens.font-h2;
                        font-weight: Tokens.weight-semibold;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                if (Dialog.kind == "confirm" ? root.confirm-body() : Dialog.body) != "": Text {
                    text: Dialog.kind == "confirm" ? root.confirm-body() : Dialog.body;
                    color: Dialog.kind == "form" ? Tokens.text-mid : Tokens.text-high;
                    font-size: Dialog.kind == "form" ? Tokens.font-caption : Tokens.font-body;
                    wrap: word-wrap;
                }
                // G1 review (Guy's decision 5): on a read-only dossier the write is blocked — the
                // dialog names the reason instead of a mute greyed verb.
                if Dialog.kind != "notice" && Holdings.read-only: StatusBand {
                    icon: "⊘";
                    text: @tr("Dossier en lecture seule : il a été écrit par une version plus récente de l'application ; rien ne peut y être enregistré.");
                }
                if Dialog.kind == "form" && Dialog.context != "": Text {
                    text: Dialog.context;
                    color: Tokens.text-mid;
                    font-family: Tokens.font-numeric;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                }

                // ── notice ──
                if Dialog.kind == "notice": HorizontalLayout {
                    alignment: end;
                    ActionButton {
                        label: @tr("Compris");
                        clicked => { Dialog.close(); }
                        autofocus: true;
                        focus-request: root.first-request;
                    }
                }

                // ── confirm — « Annuler » is the focused default; the verb needs a deliberate move. ──
                if Dialog.kind == "confirm": HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.space-8;
                    ActionButton {
                        label: @tr("Annuler");
                        clicked => { root.cancel(); }
                        autofocus: true;
                        // Two monotonic counters: either bump moves the focus here.
                        focus-request: root.first-request + root.cancel-request;
                    }
                    ActionButton {
                        label: root.confirm-verb();
                        enabled: root.confirm-enabled();
                        focus-request: root.commit-request;
                        clicked => { root.run-confirm(); }
                    }
                }

                // ── form ──
                if Dialog.kind == "form": VerticalLayout {
                    spacing: Tokens.space-12;

                    // Position (add): the choices are STUDIES (G1 decision 3) — « TICKER », or
                    // « TICKER · CUR » when the ticker has studies in several currencies — and the
                    // pick carries the study's id. Issue #218: the position takes that study's
                    // currency, stated as a fact, never picked; « Enregistrer » waits for a pick.
                    if Dialog.form-id == "holding-add": VerticalLayout {
                        spacing: Tokens.space-12;
                        LabeledDropdown {
                            label: @tr("Étude (symbole, et sa devise quand le symbole en a plusieurs)");
                            placeholder: Holdings.study-choices-unavailable ? @tr("études indisponibles")
                                : Holdings.study-choice-labels.length == 0 ? @tr("aucune étude")
                                : @tr("choisir une étude");
                            options: Holdings.study-choice-labels;
                            autofocus: true;
                            focus-request: root.first-request;
                            picked(index) => {
                                Dialog.draft-study-id = Holdings.study-choices[index].id;
                                Dialog.draft-ticker = Holdings.study-choices[index].ticker;
                                Dialog.draft-currency = Holdings.study-choices[index].currency;
                                Dialog.draft-name = Holdings.study-choices[index].name;
                            }
                        }
                        // Issue #95: a failed read is « indisponible », never « aucune étude ».
                        if Holdings.study-choices-unavailable: StatusBand {
                            icon: "⊘";
                            text: @tr("Les études du dossier ne peuvent pas être lues ; aucune position ne peut être ajoutée pour l'instant.");
                        }
                        if !Holdings.study-choices-unavailable && Holdings.study-choice-labels.length == 0: StatusBand {
                            icon: "◦";
                            text: @tr("Aucune étude dans le dossier ; créez-la d'abord depuis Études, la position en prendra la devise.");
                        }
                        if Dialog.draft-study-id != "": Text {
                            text: @tr("Étude liée : {} — devise de la position : {}",
                                Dialog.draft-name != "" ? Dialog.draft-name : Dialog.draft-ticker, Dialog.draft-currency);
                            color: Tokens.text-mid;
                            font-size: Tokens.font-caption;
                            wrap: word-wrap;
                        }
                    }

                    // Position (edit — G1 decision 4): the currency NEVER changes here. The same
                    // symbol is always editable; another one needs a study in this currency (Rust
                    // names the refusal otherwise). The list holds every study's symbol plus the
                    // position's own, so a position without a study stays editable.
                    if Dialog.form-id == "holding-edit": VerticalLayout {
                        spacing: Tokens.space-12;
                        LabeledDropdown {
                            label: @tr("Symbole");
                            placeholder: @tr("choisir un symbole");
                            options: Holdings.edit-tickers;
                            value <=> Dialog.draft-ticker;
                            autofocus: true;
                            focus-request: root.first-request;
                        }
                        if Holdings.study-choices-unavailable: StatusBand {
                            icon: "⊘";
                            text: @tr("Les études du dossier ne peuvent pas être lues ; seul le symbole actuel peut être gardé pour l'instant.");
                        }
                        Text {
                            text: @tr("Devise de la position : {} — elle ne change pas ; un autre symbole doit avoir une étude en {}.", Dialog.draft-currency, Dialog.draft-currency);
                            color: Tokens.text-mid;
                            font-size: Tokens.font-caption;
                            wrap: word-wrap;
                        }
                    }

                    // The position's amounts and sector (add and edit).
                    if Dialog.form-id == "holding-add" || Dialog.form-id == "holding-edit": VerticalLayout {
                        spacing: Tokens.space-12;
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            LabeledField {
                                label: @tr("Quantité");
                                placeholder: @tr("Nombre d'actions");
                                text <=> Dialog.draft-quantity;
                                accepted => { root.submit(); }
                            }
                            LabeledField {
                                label: Dialog.draft-currency != ""
                                    ? @tr("Prix d'achat unitaire ({})", Dialog.draft-currency)
                                    : @tr("Prix d'achat unitaire");
                                placeholder: @tr("Prix moyen par action");
                                text <=> Dialog.draft-price;
                                accepted => { root.submit(); }
                            }
                        }
                        LabeledField {
                            label: @tr("Secteur (facultatif — le fournisseur peut le renseigner)");
                            placeholder: @tr("p. ex. Technology");
                            text <=> Dialog.draft-sector;
                            accepted => { root.submit(); }
                        }
                    }

                    // Buy / sell / edit a buy or sell: the amounts are in the holding's own
                    // currency (FR28), named in `Dialog.context` above — displayed, never chosen.
                    if Dialog.form-id == "buy" || Dialog.form-id == "sell" || (Dialog.form-id == "txn-edit" && Dialog.txn-kind != "dividend"): VerticalLayout {
                        spacing: Tokens.space-12;
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            txn-date := LabeledField {
                                label: @tr("Date (vide = aujourd'hui)");
                                placeholder: @tr("AAAA-MM-JJ");
                                text <=> Dialog.draft-date;
                                autofocus: true;
                                focus-request: root.first-request;
                                accepted => { root.submit(); }
                            }
                            LabeledField {
                                label: Dialog.form-id == "sell"
                                    ? @tr("Quantité vendue (vide = toute la position)") : @tr("Quantité");
                                placeholder: @tr("Nombre d'actions");
                                text <=> Dialog.draft-quantity;
                                accepted => { root.submit(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            LabeledField {
                                label: Dialog.form-id == "buy" ? @tr("Prix unitaire payé")
                                    : Dialog.form-id == "sell" ? @tr("Prix unitaire obtenu")
                                    : @tr("Prix unitaire");
                                placeholder: @tr("Par action");
                                text <=> Dialog.draft-price;
                                accepted => { root.submit(); }
                            }
                            LabeledField {
                                label: @tr("Frais (vide = 0)");
                                placeholder: @tr("Montant total des frais");
                                text <=> Dialog.draft-fees;
                                accepted => { root.submit(); }
                            }
                        }
                        LabeledField {
                            label: @tr("Raison (facultative)");
                            placeholder: @tr("Ce qui motive l'opération");
                            text <=> Dialog.draft-rationale;
                            accepted => { root.submit(); }
                        }
                    }

                    // Dividend: shares paid on, GROSS per share, the withholding (empty = the
                    // Réglages rate, stated in the label — not only in a hint). G1 review: editing
                    // a dividend row uses THESE labels too (never « Frais (vide = 0) »); on an edit
                    // every field is prefilled and an empty withholding means none (the ledger's
                    // update rail), which its label states.
                    if Dialog.form-id == "dividend" || (Dialog.form-id == "txn-edit" && Dialog.txn-kind == "dividend"): VerticalLayout {
                        spacing: Tokens.space-12;
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            div-date := LabeledField {
                                label: @tr("Date (vide = aujourd'hui)");
                                placeholder: @tr("AAAA-MM-JJ");
                                text <=> Dialog.draft-date;
                                autofocus: true;
                                focus-request: root.first-request;
                                accepted => { root.submit(); }
                            }
                            LabeledField {
                                label: Dialog.form-id == "dividend"
                                    ? @tr("Actions concernées (vide = toute la position)") : @tr("Actions concernées");
                                placeholder: @tr("Nombre d'actions");
                                text <=> Dialog.draft-quantity;
                                accepted => { root.submit(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            LabeledField {
                                label: @tr("Brut par action");
                                placeholder: @tr("Dividende avant retenue");
                                text <=> Dialog.draft-price;
                                accepted => { root.submit(); }
                            }
                            LabeledField {
                                label: Dialog.form-id == "dividend"
                                    ? @tr("Retenue à la source (vide = {} %)", Prefs.withholding-rate-pct)
                                    : @tr("Retenue à la source (montant total, vide = 0)");
                                placeholder: @tr("Montant total retenu");
                                text <=> Dialog.draft-fees;
                                accepted => { root.submit(); }
                            }
                        }
                        LabeledField {
                            label: @tr("Raison (facultative)");
                            placeholder: @tr("Ce qui motive l'opération");
                            text <=> Dialog.draft-rationale;
                            accepted => { root.submit(); }
                        }
                    }

                    // The trigger-panel sell (Story 4.7 flow): quantity + rationale, at the
                    // matched study's present price. A destructive verb never fires on a plain
                    // Enter (G1 review, decision 1): Enter records only a typed number — blank or
                    // spaces never reach the whole-position rail; that sale takes a click on the
                    // verb.
                    if Dialog.form-id == "sell-trigger": VerticalLayout {
                        spacing: Tokens.space-12;
                        trig-qty := LabeledField {
                            label: @tr("Quantité vendue (vide = toute la position)");
                            placeholder: @tr("Nombre d'actions");
                            text <=> Dialog.draft-quantity;
                            autofocus: true;
                            focus-request: root.first-request;
                            accepted => { if (Dialog.draft-quantity.is-float()) { root.submit(); } }
                        }
                        LabeledField {
                            label: @tr("Raison (facultative)");
                            placeholder: @tr("Ce qui motive l'opération");
                            text <=> Dialog.draft-rationale;
                            accepted => { if (Dialog.draft-quantity.is-float()) { root.submit(); } }
                        }
                    }

                    // The trailing stop: one percentage; « Retirer le seuil » when one is set.
                    if Dialog.form-id == "stop": VerticalLayout {
                        spacing: Tokens.space-12;
                        stop-pct := LabeledField {
                            label: @tr("Seuil suiveur en % (défaut Réglages : {})", Prefs.default-trailing-stop-pct == "" ? "—" : Prefs.default-trailing-stop-pct);
                            placeholder: @tr("0–100");
                            text <=> Dialog.draft-price;
                            autofocus: true;
                            focus-request: root.first-request;
                            accepted => { root.submit(); }
                        }
                        if Dialog.flag: HorizontalLayout {
                            alignment: start;
                            ActionButton {
                                label: @tr("Retirer le seuil");
                                enabled: !Holdings.read-only;
                                clicked => {
                                    // This form's own gesture (see `submit`).
                                    Dialog.gesture = true;
                                    if (Holdings.set-trailing-stop(Dialog.target-id, "")) { Dialog.close(); }
                                    Dialog.gesture = false;
                                }
                            }
                        }
                    }

                    // A portfolio's name (add / rename).
                    if Dialog.form-id == "portfolio-add" || Dialog.form-id == "portfolio-rename": VerticalLayout {
                        pf-name := LabeledField {
                            label: @tr("Nom du portefeuille");
                            placeholder: @tr("p. ex. UBS — compte titres");
                            text <=> Dialog.draft-name;
                            autofocus: true;
                            focus-request: root.first-request;
                            accepted => { root.submit(); }
                        }
                    }

                    // A watched security (Story 4.1): one symbol.
                    if Dialog.form-id == "watch-add": VerticalLayout {
                        LabeledField {
                            label: @tr("Symbole");
                            placeholder: @tr("p. ex. NESN.SW");
                            text <=> Dialog.draft-ticker;
                            autofocus: true;
                            focus-request: root.first-request;
                            accepted => { root.submit(); }
                        }
                    }

                    // A new study (Story 2.2): symbol + native currency (the currency of the
                    // security's own figures, from the SAME allow-list as a position's — a
                    // position takes its study's currency, #218) + the optional company name (UX
                    // spec §5.3). G1 decision 8: the currency is never prefilled — « choisir »,
                    // and « Enregistrer » waits for an explicit pick (the CHF/USD trap).
                    if Dialog.form-id == "study-create": VerticalLayout {
                        spacing: Tokens.space-12;
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            LabeledField {
                                label: @tr("Symbole");
                                placeholder: @tr("p. ex. NESN.SW");
                                text <=> Dialog.draft-ticker;
                                autofocus: true;
                                focus-request: root.first-request;
                                accepted => { root.submit(); }
                            }
                            LabeledDropdown {
                                label: @tr("Devise des chiffres");
                                placeholder: @tr("choisir");
                                options: Holdings.supported-currencies;
                                value <=> Dialog.draft-currency;
                            }
                        }
                        LabeledField {
                            label: @tr("Nom de société (facultatif)");
                            placeholder: @tr("p. ex. Nestlé");
                            text <=> Dialog.draft-name;
                            accepted => { root.submit(); }
                        }
                    }

                    // A manual exchange rate (Story 6.5): base currency → the reference, dated.
                    if Dialog.form-id == "fx-rate": VerticalLayout {
                        spacing: Tokens.space-12;
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            LabeledDropdown {
                                label: @tr("Devise de départ");
                                placeholder: @tr("choisir");
                                options: Holdings.supported-currencies;
                                value <=> Dialog.draft-ticker;
                                autofocus: true;
                                focus-request: root.first-request;
                            }
                            LabeledField {
                                label: @tr("Taux vers {} (1 unité de départ = … {})", Prefs.reference-currency, Prefs.reference-currency);
                                placeholder: @tr("p. ex. 0.95");
                                text <=> Dialog.draft-price;
                                accepted => { root.submit(); }
                            }
                        }
                        LabeledField {
                            label: @tr("Date du taux (vide = aujourd'hui)");
                            placeholder: @tr("AAAA-MM-JJ");
                            text <=> Dialog.draft-date;
                            accepted => { root.submit(); }
                        }
                    }

                    // A refusal raised by THIS form (Rust): inline, next to the fields, the text kept.
                    if Dialog.field-error != "": StatusBand {
                        icon: "⚠";
                        text: Dialog.field-error;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: Tokens.space-8;
                        ActionButton {
                            label: @tr("Annuler");
                            focus-request: root.cancel-request;
                            clicked => { root.cancel(); }
                        }
                        ActionButton {
                            label: @tr("Enregistrer");
                            enabled: root.can-submit();
                            focus-request: root.commit-request;
                            clicked => { root.submit(); }
                        }
                    }
                }
            }

            // The focus trap's trailing sentinel: a Tab out of the last control lands here — send
            // it back to the first (the screen behind never gets the focus while the card is up).
            FocusScope {
                width: 0;
                height: 0;
                focus-on-click: false;
                focus-gained(reason) => {
                    if (reason == FocusReason.tab-navigation) { root.focus-first(); }
                }
            }
        }
    }
}
