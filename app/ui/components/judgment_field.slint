// A labelled numeric judgment-input field (Story 2.6, AC 1): an exact-keyboard-value entry for a
// §1/§3/§4 judgment input, committed to `Studies.set-judgment(field-key, text)` on Enter and on
// focus-out (the 2.4 commit-on-focus-out discipline). A cleared field is parsed to `None` in Rust —
// never `0`. Token-styled, visible focus ring (NFR-U2), keyboard-reachable; constant geometry.
//
// The field re-seeds from the model (`value`) on every re-push (`init` + `changed`, unconditionally
// — issue #32). This never clobbers a routine, unrelated re-push (`changed value` only fires when
// THIS field's own committed value differs), and it deliberately DOES override an in-progress draft
// when something external changed this same value while focused (undo/redo) — see the `changed
// value` handler below for why that's the correct call, not a regression.

import { Tokens } from "../tokens.slint";
import { Studies } from "../state.slint";

export component JudgmentField inherits VerticalLayout {
    in property <string> label;
    in property <string> field-key;
    in property <string> value;
    in property <string> placeholder;
    in property <string> suffix; // e.g. "%" — caption only, never sent back
    // A historical value proposed for this field when EMPTY ("" = no proposal): shown as a small
    // « hist. » chip under the box; clicking commits it through the SAME set-judgment path as
    // typing (the adoption gesture IS the judgment — the #23 rail, never a silent prefill).
    in property <string> suggestion;

    spacing: Tokens.space-4;
    // Pack label/box/chip at the top: in a row whose height is set by a taller sibling (the §1
    // growth column with its captions), the default stretch would spread them apart vertically.
    alignment: start;

    // Re-seed the input from the model after a persisted re-push (Studies.judgment changed).
    //
    // Issue #32: `changed value` fires ONLY when `root.value` (this field's OWN committed value)
    // actually differs from what it was — an unrelated edit elsewhere (a different field, extending
    // history, …) never touches THIS value, so it never re-triggers this handler; the prior
    // `!has-focus` guard was therefore protecting against a case that cannot happen. The one case
    // that DOES fire this while focused is genuinely dangerous instead: something OTHER than this
    // field's own commit-on-blur changed the value out from under an in-progress edit (undo/redo is
    // the concrete trigger) — since this field's own edits only ever write back on blur/Enter, a
    // `value` change reaching us WHILE STILL FOCUSED can only be external. Reseeding unconditionally
    // makes the external truth win: an in-flight, uncommitted draft is discarded rather than later
    // silently committed OVER the externally-set value at the next blur (which would look like the
    // undo/redo had no effect). A self-authored commit's echo is a no-op here (the text already
    // equals `root.value`).
    changed value => {
        input.text = root.value;
    }

    Text {
        text: root.label;
        color: Tokens.text-mid;
        font-size: Tokens.font-caption;
    }
    HorizontalLayout {
        spacing: Tokens.space-4;
        box := Rectangle {
            width: 140px;
            height: Tokens.row-height;
            border-radius: Tokens.radius;
            background: Tokens.surface-alt;
            border-width: input.has-focus ? Tokens.focus-border : Tokens.border;
            border-color: input.has-focus ? Tokens.focus : Tokens.separator;
            forward-focus: input;

            // The "à saisir" ring on EVERY empty judgment field (2026-07-12, superseding the
            // #114 verdict-gate scope): a judgment input is manual by definition, so an empty one
            // is exactly « un champ à compléter à la main » — including the non-load-bearing ones
            // (dividende courant, plus bas sévère, croissances) whose absence withholds §5 outputs
            // without ever opening a verdict gate. Border-only overlay → never hides the value;
            // suppressed while focused so the focus ring wins; clears with the first committed
            // value. Amber (`Tokens.attention`) — the one deliberate colour spend outside the §4
            // zones. Known trade-off (user-accepted): a no-dividend company keeps its dividend
            // field ringed.
            Rectangle {
                visible: input.text == "" && !input.has-focus;
                width: 100%;
                height: 100%;
                border-radius: Tokens.radius;
                border-width: Tokens.focus-border;
                border-color: Tokens.attention;
                background: transparent;
            }

            placeholder := Text {
                text: root.placeholder;
                color: Tokens.text-low;
                font-size: Tokens.font-body;
                vertical-alignment: center;
                x: Tokens.space-8;
                visible: input.text == "";
            }
            input := TextInput {
                color: Tokens.text-high;
                selection-background-color: Tokens.focus;
                font-family: Tokens.font-numeric;
                font-size: Tokens.font-body;
                horizontal-alignment: right;
                vertical-alignment: center;
                single-line: true;
                width: parent.width - Tokens.space-8 * 2;
                height: 100%;
                x: Tokens.space-8;

                init => {
                    self.text = root.value;
                }
                accepted => {
                    if (self.text != root.value) {
                        Studies.set-judgment(root.field-key, self.text);
                    }
                }
                changed has-focus => {
                    if (!self.has-focus && self.text != root.value) {
                        Studies.set-judgment(root.field-key, self.text);
                    }
                    if (self.has-focus) {
                        self.select-all();
                    }
                }
            }
        }
        if root.suffix != "": Text {
            text: root.suffix;
            color: Tokens.text-low;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
        }
    }
    // The « hist. » proposal chip — visible only while the field is EMPTY and a historical value
    // exists. One click commits the proposal through the SAME `set-judgment` path as typing (the
    // gesture is the judgment); the chip disappears with the commit (the field is no longer empty).
    if root.value == "" && root.suggestion != "": chip := Rectangle {
        width: 140px;
        height: Tokens.row-height * 0.8;
        border-radius: Tokens.radius;
        border-width: Tokens.border;
        border-color: chip-touch.has-hover ? Tokens.text-mid : Tokens.separator;
        background: transparent;
        chip-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Studies.set-judgment(root.field-key, root.suggestion);
            }
        }
        Text {
            text: @tr("↩ hist. {}", root.suggestion);
            color: Tokens.text-mid;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
