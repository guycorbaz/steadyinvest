// The §1 interactive semi-log growth chart (Story 2.8) — the signature interaction. Productionizes
// the GO'd Spike B: native Slint, `Path` + `TouchArea`, no egui, no web. The Sales/EPS/Price series,
// the 5–30 % guide fan and the 1→200 decade axis are pre-computed in `viewmodel/chart.rs` and cross
// as `Path` `commands` strings against a viewbox whose HEIGHT is rendered 1:1 (so a vertical drag's
// `mouse-y` maps directly to the viewbox-y the adapter inverts); the width is free to stretch.
//
// The judgment is a TREND LINE the user draws: its origin is FIXED at the last historical EPS point,
// and only the future ENDPOINT moves. The right-edge drag strip is the grab target — dragging it
// vertically sets the est-high-EPS (→ §4 forecast/zone recolor). While held, `Studies.judgment-
// dragging` disables the enclosing form `Flickable` so the gesture is not stolen by the scroll.
//
// COLOUR BUDGET (UX-DR10): NO judgment hue on §1 — series separate by VALUE (text-high EPS, text-mid
// Price, text-low Sales) + stroke weight, never colour. NEVER auto-placed (FR33): the line + handle
// render only once the engine has a forecast (`judgment-y >= 0`); unset shows a neutral drag hint.

import { Tokens } from "../tokens.slint";
import { Studies, GrowthChartState, AxisTick } from "../state.slint";

// One legend entry (issue #25/#116): a colour swatch matching a series' stroke + its name.
component LegendItem inherits HorizontalLayout {
    in property <color> hue;
    in property <string> name;
    spacing: Tokens.space-4;
    Rectangle {
        width: Tokens.space-12;
        height: Tokens.space-12;
        y: (parent.height - self.height) / 2;
        background: root.hue;
        border-radius: Tokens.radius / 2;
    }
    Text {
        text: root.name;
        color: Tokens.text-mid;
        font-size: Tokens.font-caption;
        vertical-alignment: center;
    }
}

// Issue #121: one segment of the "what am I adjusting?" selector — a toggle chip naming an EPS
// forecast context. Selecting it points the single drag handle at that line (all lines stay drawn).
component ContextChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: Tokens.row-height;
    border-radius: Tokens.radius;
    border-width: Tokens.border;
    border-color: root.selected ? Tokens.series-eps : Tokens.separator;
    background: root.selected ? Tokens.series-eps.with-alpha(0.15) : Tokens.surface-alt;
    HorizontalLayout {
        padding-left: Tokens.space-12;
        padding-right: Tokens.space-12;
        Text {
            text: root.label;
            color: root.selected ? Tokens.text-high : Tokens.text-mid;
            font-size: Tokens.font-caption;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component GrowthChart inherits Rectangle {
    in property <GrowthChartState> chart: Studies.growth-chart;
    // Issue #121: the drag writes whichever EPS forecast the user selected (est-high or est-low), kept
    // in sync with the exact-value `JudgmentField` of the same key (FR31). Only one handle is grabbed
    // at a time; both trend lines stay drawn (the SSG is a visual method — judge by looking).
    property <string> drag-field: Studies.active-judgment;
    property <bool> low-active: Studies.active-judgment == "est_low_eps";
    // The active context's endpoint y / caption — the grip follows the selected line.
    property <float> active-y: root.low-active ? root.chart.judgment-low-y : root.chart.judgment-y;
    property <string> active-label: root.low-active ? root.chart.judgment-low-label : root.chart.judgment-label;

    // Height is rendered 1:1 with the viewbox (so the drag's mouse-y maps directly); width stretches.
    property <length> plot-h: root.chart.chart-h * 1px;
    property <length> strip-w: Tokens.space-48;

    min-height: root.plot-h + Tokens.row-height + 2 * Tokens.chart-pad;

    // ── Calm empty state (no plottable years) — constant geometry, nothing drawn ──
    if !root.chart.available: Rectangle {
        height: root.plot-h;
        background: Tokens.surface-alt;
        border-width: Tokens.border;
        border-color: Tokens.separator;
        border-radius: Tokens.radius;
        opacity: 0.4 + 0.6 * Tokens.regime-emphasis;
        Text {
            text: @tr("Aucune donnée à tracer");
            color: Tokens.text-low;
            font-size: Tokens.font-caption;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ── The chart: side axis + plot area, with the series legend below (issue #25/#116: the labelled
    //    axis is the EPS scale, so a colour legend tells the three independently-scaled series apart) ──
    if root.chart.available: VerticalLayout {
        spacing: Tokens.space-4;

        // ── Issue #121: pick which EPS forecast the drag handle edits. One judgment at a time; every
        //    curve stays in view (the SSG is a visual method — you judge trends by LOOKING). ──
        HorizontalLayout {
            spacing: Tokens.space-8;
            alignment: start;
            padding-left: Tokens.space-32 + Tokens.space-8;
            Text {
                text: @tr("Ajuster :");
                color: Tokens.text-mid;
                font-size: Tokens.font-caption;
                vertical-alignment: center;
            }
            ContextChip {
                label: @tr("BPA estimé haut");
                selected: Studies.active-judgment == "est_high_eps";
                clicked => { Studies.active-judgment = "est_high_eps"; }
            }
            ContextChip {
                label: @tr("BPA estimé bas");
                selected: Studies.active-judgment == "est_low_eps";
                clicked => { Studies.active-judgment = "est_low_eps"; }
            }
        }

        HorizontalLayout {
        spacing: Tokens.space-8;
        alignment: stretch;

        // Side axis — the EPS-scale ticks at their viewbox-y.
        Rectangle {
            width: Tokens.space-32;
            height: root.plot-h;
            for tick in root.chart.axis-ticks: Text {
                text: tick.label;
                color: Tokens.text-mid;
                font-family: Tokens.font-numeric;
                font-size: Tokens.font-caption;
                horizontal-alignment: right;
                width: parent.width;
                y: tick.y * 1px - self.height / 2;
            }
        }

        // The plot area — fixed HEIGHT, stretching WIDTH (clips overflowing fan/series).
        Rectangle {
            horizontal-stretch: 1;
            height: root.plot-h;
            background: Tokens.surface;
            border-width: Tokens.border;
            border-color: Tokens.separator;
            border-radius: Tokens.radius;
            clip: true;

            // Axis gridlines at each decade tick — contrasted enough to read as a grid.
            for tick in root.chart.axis-ticks: Rectangle {
                x: 0;
                y: tick.y * 1px;
                width: parent.width;
                height: Tokens.chart-stroke-thin;
                background: Tokens.text-low;
                opacity: 0.35;
            }

            // The 5–30 % growth-guide fan (faint, under the curves).
            for cmd in root.chart.fan-commands: Path {
                commands: cmd;
                stroke: Tokens.text-low;
                stroke-width: Tokens.chart-stroke-thin;
                opacity: Tokens.chart-fan-opacity;
                // Issue #118: bind viewbox-width to the ELEMENT's real px width so the viewbox aspect
                // matches the element — no aspect-fit letterbox/centering — and the path renders 1:1
                // from x=0 = the LEFT edge (the origin is at the left, not the middle). viewbox-height
                // stays chart-h == plot-h, so the vertical mapping the drag relies on is untouched.
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-width: parent.width / 1px;
                viewbox-height: root.chart.chart-h;
            }

            // Historical series (issue #25/#116): each on its OWN log scale (no clamp/compression),
            // told apart by a DISTINCT colour (not a §4 zone hue) + stroke weight.
            Path {
                commands: root.chart.sales-commands;
                stroke: Tokens.series-sales;
                stroke-width: Tokens.chart-stroke;
                // Issue #118: bind viewbox-width to the ELEMENT's real px width so the viewbox aspect
                // matches the element — no aspect-fit letterbox/centering — and the path renders 1:1
                // from x=0 = the LEFT edge (the origin is at the left, not the middle). viewbox-height
                // stays chart-h == plot-h, so the vertical mapping the drag relies on is untouched.
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-width: parent.width / 1px;
                viewbox-height: root.chart.chart-h;
            }
            Path {
                commands: root.chart.price-commands;
                stroke: Tokens.series-price;
                stroke-width: Tokens.chart-stroke-thin;
                // Issue #118: bind viewbox-width to the ELEMENT's real px width so the viewbox aspect
                // matches the element — no aspect-fit letterbox/centering — and the path renders 1:1
                // from x=0 = the LEFT edge (the origin is at the left, not the middle). viewbox-height
                // stays chart-h == plot-h, so the vertical mapping the drag relies on is untouched.
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-width: parent.width / 1px;
                viewbox-height: root.chart.chart-h;
            }
            // EPS — the protagonist (the dragged/decision series, its scale is the labelled one).
            Path {
                commands: root.chart.eps-commands;
                stroke: Tokens.series-eps;
                stroke-width: Tokens.chart-stroke;
                // Issue #118: bind viewbox-width to the ELEMENT's real px width so the viewbox aspect
                // matches the element — no aspect-fit letterbox/centering — and the path renders 1:1
                // from x=0 = the LEFT edge (the origin is at the left, not the middle). viewbox-height
                // stays chart-h == plot-h, so the vertical mapping the drag relies on is untouched.
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-width: parent.width / 1px;
                viewbox-height: root.chart.chart-h;
            }
            // The judgment trend line (origin fixed at the last historical EPS → forecast endpoint),
            // drawn solid + thick as the actor. Rendered only when set (FR33).
            if root.chart.judgment-y >= 0.0: Path {
                commands: root.chart.judgment-commands;
                stroke: Tokens.series-eps;
                // Issue #121: the ACTIVE context reads as the actor (thick, full); the other line and a
                // least-squares SEED (no judgment yet) recede (thin / dimmed) but stay in view.
                stroke-width: !root.low-active ? Tokens.chart-judgment-stroke : Tokens.chart-stroke;
                opacity: root.chart.judgment-high-derived ? 0.55 : (!root.low-active ? 1.0 : 0.8);
                // Issue #118: bind viewbox-width to the ELEMENT's real px width so the viewbox aspect
                // matches the element — no aspect-fit letterbox/centering — and the path renders 1:1
                // from x=0 = the LEFT edge (the origin is at the left, not the middle). viewbox-height
                // stays chart-h == plot-h, so the vertical mapping the drag relies on is untouched.
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-width: parent.width / 1px;
                viewbox-height: root.chart.chart-h;
            }
            // Issue #121: the est-LOW forecast trend line (same fixed origin, second endpoint). Dimmed
            // when it is only the least-squares SEED or when est-HIGH is the active context.
            if root.chart.judgment-low-y >= 0.0: Path {
                commands: root.chart.judgment-low-commands;
                stroke: Tokens.series-eps;
                stroke-width: root.low-active ? Tokens.chart-judgment-stroke : Tokens.chart-stroke;
                opacity: root.chart.judgment-low-derived ? 0.55 : (root.low-active ? 1.0 : 0.8);
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-width: parent.width / 1px;
                viewbox-height: root.chart.chart-h;
            }

            // ── The right-edge drag strip: the grab target for the future endpoint. mouse-y spans
            //    the full height, so it maps 1:1 to the viewbox-y the adapter inverts. ──
            Rectangle {
                x: parent.width - root.strip-w;
                width: root.strip-w;
                height: parent.height;
                background: Tokens.surface-alt.with-alpha(strip-touch.has-hover ? 0.6 : 0.3);

                // Issue #121: ONE grip + caption, on the ACTIVE context's endpoint (est-high or est-low).
                if root.active-y >= 0.0: Rectangle {
                    width: Tokens.chart-grip;
                    height: Tokens.chart-grip;
                    x: (parent.width - self.width) / 2;
                    y: root.active-y * 1px - self.height / 2;
                    background: Tokens.text-high;
                    border-radius: Tokens.radius;
                }
                if root.active-y >= 0.0: Text {
                    text: root.active-label;
                    color: Tokens.text-high;
                    font-family: Tokens.font-numeric;
                    font-size: Tokens.font-caption;
                    horizontal-alignment: center;
                    width: parent.width;
                    y: root.active-y * 1px - self.height - Tokens.space-4;
                }
                // A neutral drag hint when the active line is unset (an affordance, never a value).
                if root.active-y < 0.0: Text {
                    text: "⇕";
                    color: Tokens.text-low;
                    font-size: Tokens.font-h3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                strip-touch := TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    moved => {
                        Studies.judgment-moved(root.drag-field, self.mouse-y);
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            Studies.judgment-drag-start();
                            Studies.judgment-dragging = true;
                        }
                        // Pointer-up = commit (persist). Cancel = abandon → revert to saved (review
                        // P4): a cancelled gesture must never persist the release position.
                        if (ev.kind == PointerEventKind.up) {
                            Studies.judgment-commit(root.drag-field, self.mouse-y);
                            Studies.judgment-dragging = false;
                        }
                        if (ev.kind == PointerEventKind.cancel) {
                            Studies.judgment-cancel();
                            Studies.judgment-dragging = false;
                        }
                    }
                    accessible-role: slider;
                    accessible-label: root.low-active
                        ? @tr("Tendance du BPA estimé bas — glisser pour ajuster")
                        : @tr("Tendance du BPA estimé haut — glisser pour ajuster");
                    accessible-value: root.active-label;
                }
            }
        }
        }

        // ── Series legend (issue #25/#116): a colour swatch + name for each series, so the three
        //    independently-scaled curves are identifiable (only the EPS scale is numbered on the side
        //    axis; Sales/Price live on their own scales). ──
        HorizontalLayout {
            spacing: Tokens.space-16;
            alignment: start;
            padding-left: Tokens.space-32 + Tokens.space-8;
            LegendItem { hue: Tokens.series-sales; name: @tr("Ventes"); }
            LegendItem { hue: Tokens.series-price; name: @tr("Prix"); }
            LegendItem { hue: Tokens.series-eps; name: @tr("BPA"); }
        }
    }
}
