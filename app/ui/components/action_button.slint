// A plain push-button primitive (no std-widgets, like ChoiceChip) — token-styled, Tab-reachable,
// Enter/Space activates, visible focus ring (NFR-U1/U2). Assistive-tech: a button whose default
// action is `clicked`.

import { Tokens } from "../tokens.slint";

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    // Take the keyboard focus right after creation (a dialog's default button). Deferred by a
    // tick: a `focus()` inside `init` of a conditionally created element is dropped before the
    // element is attached to the window (observed 2026-09-23, Slint 1.17).
    in property <bool> autofocus: false;
    // Take the focus whenever this counter changes (the modal's focus trap — G1 review). A
    // disabled button cannot take it; the trap then asks another one.
    in property <int> focus-request;
    callback clicked();

    changed focus-request => {
        fs.focus();
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.activate();
    }

    function activate() {
        if (root.enabled) {
            root.clicked();
        }
    }

    height: Tokens.row-height + Tokens.space-4;
    forward-focus: fs;
    horizontal-stretch: 0;
    // Never narrower than its own label (on-screen check, 2026-09-25: a crowded row clipped
    // « Transactions » to « Transactior »): the label plus its padding, with the old floor.
    min-width: max(Tokens.space-48 * 2, label-text.preferred-width + 2 * Tokens.space-16);
    border-radius: Tokens.radius;
    opacity: root.enabled ? 1.0 : 0.5;
    background: touch.pressed ? Tokens.surface : Tokens.surface-alt;
    border-width: fs.has-focus ? Tokens.focus-border : Tokens.border;
    border-color: fs.has-focus ? Tokens.focus : Tokens.separator;

    Timer {
        interval: 30ms;
        running: root.autofocus;
        triggered => {
            self.running = false;
            fs.focus();
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activate();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            fs.focus();
            root.activate();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-16;
        padding-right: Tokens.space-16;

        label-text := Text {
            text: root.label;
            color: Tokens.text-high;
            font-size: Tokens.font-body;
            font-weight: Tokens.weight-medium;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
