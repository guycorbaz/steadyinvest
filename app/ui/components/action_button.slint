// A plain push-button primitive (no std-widgets, like ChoiceChip) — token-styled, Tab-reachable,
// Enter/Space activates, visible focus ring (NFR-U1/U2). Assistive-tech: a button whose default
// action is `clicked`.

import { Tokens } from "../tokens.slint";
import { ButtonFace } from "button_face.slint";

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    // Take the keyboard focus right after creation (a dialog's default button). Deferred by a
    // tick: a `focus()` inside `init` of a conditionally created element is dropped before the
    // element is attached to the window (observed 2026-09-23, Slint 1.17).
    in property <bool> autofocus: false;
    // Take the focus whenever this counter changes (the modal's focus trap — G1 review). A
    // disabled button cannot take it; the trap then asks another one.
    in property <int> focus-request;
    // Story 8.5a (G3): a compact variant (caption text, 32 px) — the action inside a StatusBand, so
    // the band stays one line high.
    in property <bool> compact: false;
    // Story 8.5b (G3): a decision verb — Enter / Space activate it only once it has held the focus
    // for a moment, so a reflex double tap (the row's Enter, then Enter again) never decides; a click
    // is unaffected. Every button ignores a held key's auto-repeat.
    in property <bool> guard-reflex: false;
    property <bool> armed: true;
    callback clicked();

    changed focus-request => {
        fs.focus();
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.activate();
    }

    function activate() {
        if (root.enabled) {
            root.clicked();
        }
    }
    function key-activate() {
        if (root.enabled) {
            root.flash = true;
            flash-timer.running = true;
            root.clicked();
        }
    }

    height: root.compact ? 32px : Tokens.row-height + Tokens.space-4;
    forward-focus: fs;
    horizontal-stretch: 0;
    // Never narrower than its own label (on-screen check, 2026-09-25: a crowded row clipped
    // « Transactions » to « Transactior »): the label plus its padding, with the old floor.
    min-width: root.compact ? label-text.preferred-width + 2 * Tokens.space-12
        : max(Tokens.space-48 * 2, label-text.preferred-width + 2 * Tokens.space-16);
    opacity: root.enabled ? 1.0 : 0.5;
    background: transparent;
    // A keyboard activation shows the same brief press as a click (Guy, 2026-10-01: a press must
    // be seen, whatever the hand).
    property <bool> flash: false;

    flash-timer := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.running = false;
            root.flash = false;
        }
    }

    Timer {
        interval: 30ms;
        running: root.autofocus;
        triggered => {
            self.running = false;
            fs.focus();
        }
    }

    Timer {
        interval: 350ms;
        running: root.guard-reflex && fs.has-focus && !root.armed;
        triggered => {
            self.running = false;
            root.armed = true;
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-changed-event => {
            if (root.guard-reflex && self.has-focus) { root.armed = false; }
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // A held key's auto-repeat, or a reflex press right after the focus arrived.
                if (event.repeat || !root.armed) { return accept; }
                root.key-activate();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            fs.focus();
            root.activate();
        }
    }

    ButtonFace {
        width: 100%;
        height: 100%;
        pressed: touch.pressed || root.flash;
        enabled: root.enabled;
        focused: fs.has-focus;

        HorizontalLayout {
            padding-left: root.compact ? Tokens.space-12 : Tokens.space-16;
            padding-right: root.compact ? Tokens.space-12 : Tokens.space-16;

            label-text := Text {
                text: root.label;
                color: Tokens.text-high;
                font-size: root.compact ? Tokens.font-caption : Tokens.font-body;
                font-weight: Tokens.weight-medium;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
