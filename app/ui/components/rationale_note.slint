// A study-level multi-line decision-rationale note (Story 2.10, FR49): a free-text "why I judged
// this way" entry, committed to `Studies.set-rationale(text)` on focus-out (the 2.4/2.6 commit-on-
// focus-out discipline — Enter inserts a newline here, it does NOT commit). Plain text only — NO
// rich text, NO markdown. Spends NO colour (ink only); constant geometry, reduced-motion-safe (no
// animation). The user's own words are NEVER posture-scanned — only the system label/placeholder
// are (FR13).
//
// Re-seeds the input from the model (`value`) on every re-push, unconditionally (issue #32, like
// `JudgmentField`) — a routine, unrelated re-push never clobbers a draft (`changed value` only fires
// when THIS note's own committed text differs), and an external change to this same text while
// focused (undo/redo) is deliberately allowed to win over an in-progress, uncommitted draft.

import { Tokens } from "../tokens.slint";
import { Studies } from "../state.slint";

export component RationaleNote inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;

    spacing: Tokens.space-4;

    // Re-seed from the model after a persisted re-push (Studies.rationale changed).
    //
    // Issue #32: `changed value` fires ONLY when this note's OWN committed text actually differs —
    // an unrelated edit elsewhere never re-triggers this. The one case that DOES fire it while
    // focused is genuinely dangerous: this note's own edits only ever write back on blur (Enter is a
    // newline here, never a commit), so a `value` change reaching us while still focused can only be
    // external (undo/redo). Reseeding unconditionally makes that external truth win — an in-flight,
    // uncommitted draft is discarded rather than later silently committed OVER the externally-set
    // text at the next blur (which would look like the undo/redo had no effect). A self-authored
    // commit's echo is a no-op here (the text already equals `root.value`).
    changed value => {
        input.text = root.value;
    }

    Text {
        text: root.label;
        color: Tokens.text-mid;
        font-size: Tokens.font-caption;
    }
    box := Rectangle {
        // Grows with the text (3 rows minimum, matching the old fixed height) up to an 8-row
        // ceiling; a note longer than that scrolls in the Flickable below (#33 — a fixed 3-row box
        // with no scrollbar hid any text past the cursor, with no visual hint more text existed).
        height: Math.max(Tokens.row-height * 3, Math.min(Tokens.row-height * 8, input.preferred-height + Tokens.space-8 * 2));
        border-radius: Tokens.radius;
        background: Tokens.surface-alt;
        border-width: input.has-focus ? Tokens.focus-border : Tokens.border;
        border-color: input.has-focus ? Tokens.focus : Tokens.separator;
        forward-focus: input;
        clip: true;

        placeholder := Text {
            text: root.placeholder;
            color: Tokens.text-low;
            font-size: Tokens.font-body;
            x: Tokens.space-8;
            y: Tokens.space-8;
            visible: input.text == "";
        }
        scroll := Flickable {
            x: Tokens.space-8;
            y: Tokens.space-8;
            width: parent.width - Tokens.space-8 * 2;
            height: parent.height - Tokens.space-8 * 2;
            viewport-height: Math.max(self.height, input.preferred-height);
            input := TextInput {
                color: Tokens.text-high;
                selection-background-color: Tokens.focus;
                font-family: Tokens.font-ui;
                font-size: Tokens.font-body;
                single-line: false;
                wrap: word-wrap;
                width: parent.width;

                init => {
                    self.text = root.value;
                }
                // Commit on focus-out only (Enter is a newline in a multi-line note), and only when
                // the text actually changed → one undo step per committed edit, no no-op persistence.
                changed has-focus => {
                    if (!self.has-focus && self.text != root.value) {
                        Studies.set-rationale(self.text);
                    }
                }
            }
        }
    }
}
